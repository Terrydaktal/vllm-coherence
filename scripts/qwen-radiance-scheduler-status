#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly PROGRAM=qwen-radiance-scheduler-status
readonly CLIENT_STALE_SECONDS=20
readonly SAMPLE_INTERVAL_SECONDS=0.5
readonly SAMPLE_SCHEMA=urn:qwen-r9700:scheduler-telemetry:v2
readonly LEGACY_SAMPLE_SCHEMA=urn:qwen-r9700:scheduler-telemetry:v1
readonly COMBINED_SCHEMA=urn:qwen-r9700:telemetry:v1

die() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
	exit 2
}

validate_state_directory() {
	local path=$1 details
	[[ $path == /* && -d $path && ! -L $path ]] || die "unsafe state directory: $path"
	details=$(stat -c '%u:%a' -- "$path") || die "cannot inspect state directory: $path"
	[[ $details == "$(id -u):700" ]] || die "unsafe state directory ownership or mode: $path"
	[[ -d $path/clients && ! -L $path/clients ]] || die "client directory is missing or unsafe: $path/clients"
	details=$(stat -c '%u:%a' -- "$path/clients") || die "cannot inspect client directory: $path/clients"
	[[ $details == "$(id -u):700" ]] || die "unsafe client directory ownership or mode: $path/clients"
}

owned_process() {
	local pid=$1 expected_start=$2 observed
	[[ $pid =~ ^[1-9][0-9]*$ && $expected_start =~ ^[1-9][0-9]*$ && -r /proc/$pid/stat ]] || return 1
	observed=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
	[[ $observed == "$expected_start" ]]
}

have_active_client() {
	local marker filename pid start marker_details marker_mtime now
	now=$(date +%s)
	shopt -s nullglob
	for marker in "$state_directory"/clients/*.heartbeat; do
		[[ -f $marker && ! -L $marker ]] || continue
		marker_details=$(stat -c '%u:%h:%a' -- "$marker" 2>/dev/null) || continue
		[[ $marker_details == "$(id -u):1:600" ]] || continue
		filename=${marker##*/}
		if [[ $filename =~ ^([1-9][0-9]*)-([1-9][0-9]*)-[0-9a-f]{16}\.heartbeat$ ]]; then
			pid=${BASH_REMATCH[1]}
			start=${BASH_REMATCH[2]}
		else
			continue
		fi
		marker_mtime=$(stat -c %Y -- "$marker" 2>/dev/null) || continue
		if ((now - marker_mtime <= CLIENT_STALE_SECONDS)) && owned_process "$pid" "$start"; then
			return 0
		fi
		rm -f -- "$marker"
	done
	return 1
}

write_coverage() {
	local coverage=$1 name=$2 coverage_stage
	if [[ $coverage == \{*\} && ${#coverage} -le 65535 && $coverage != *$'\n'* && $coverage != *$'\r'* && $coverage != *$'\t'* ]]; then
		coverage_stage=$(mktemp "$state_directory/.cache-residency.XXXXXX") || return 1
		chmod 0600 -- "$coverage_stage"
		printf '%s\n' "$coverage" >"$coverage_stage"
		mv -fT -- "$coverage_stage" "$state_directory/$name"
	fi
}

read_temperature_sample() {
	local path="$state_directory/sample.json" details sample
	if [[ ! -f $path || -L $path ]]; then
		printf 'null'
		return 0
	fi
	details=$(stat -c '%u:%h:%a:%s' -- "$path" 2>/dev/null) || {
		printf 'null'
		return 0
	}
	[[ $details == "$(id -u):1:600:"* ]] || {
		printf 'null'
		return 0
	}
	local size=${details##*:}
	[[ $size =~ ^[0-9]+$ && $size -le 1024 ]] || {
		printf 'null'
		return 0
	}
	sample=$(cat -- "$path" 2>/dev/null) || {
		printf 'null'
		return 0
	}
	if [[ $sample == \{*\} && ${#sample} -le 1024 && $sample != *$'\n'* && $sample != *$'\r'* && $sample != *$'\t'* ]]; then
		printf '%s' "$sample"
	else
		printf 'null'
	fi
}

write_sample() {
	local scheduler=$1 worker=$2 coverage=${3:-null} coverage_v2=${4:-null} phases=${5:-null}
	local temperature observed stage legacy_stage telemetry_stage telemetry_signature separator
	((${#scheduler} >= 2 && ${#scheduler} <= 32767)) || return 1
	[[ $scheduler == \{*\} && $scheduler != *$'\n'* && $scheduler != *$'\r'* && $scheduler != *$'\t'* ]] || return 1
	if [[ $worker != null ]]; then
		((${#worker} >= 2 && ${#worker} <= 32767)) || return 1
		[[ $worker == \{*\} && $worker != *$'\n'* && $worker != *$'\r'* && $worker != *$'\t'* ]] || return 1
	fi
	# A generation-round phase update arrives more often than the full
	# scheduler sample. Do not rewrite the larger scheduler/coverage files when
	# their payload is unchanged; request-phases.json and the combined snapshot
	# remain eventful at round cadence while preserving the normal half-second
	# scheduler feed.
	if [[ $phases != "${last_phases-}" ]]; then
		write_coverage "$phases" request-phases.json || return 1
		last_phases=$phases
	fi
	if [[ $coverage != "${last_coverage-}" ]]; then
		write_coverage "$coverage" cache-residency.json || return 1
		last_coverage=$coverage
	fi
	if [[ $coverage_v2 != "${last_coverage_v2-}" ]]; then
		write_coverage "$coverage_v2" cache-residency-v2.json || return 1
		last_coverage_v2=$coverage_v2
	fi
	temperature=$(read_temperature_sample)
	separator=$'\037'
	telemetry_signature="$scheduler$separator$worker$separator$phases$separator$coverage_v2$separator$temperature"
	observed=${EPOCHREALTIME/./}
	observed=${observed:0:13}
	[[ $observed =~ ^[0-9]{13}$ ]] || return 1
	if [[ $scheduler != "${last_scheduler-}" || $worker != "${last_worker-}" ]]; then
		stage=$(mktemp "$state_directory/.scheduler.XXXXXX") || return 1
		chmod 0600 -- "$stage"
		printf '{"schema":"%s","observed_at_ms":%s,"backend":{"scheduler":%s,"worker":%s}}\n' \
			"$SAMPLE_SCHEMA" "$observed" "$scheduler" "$worker" >"$stage"
		mv -fT -- "$stage" "$state_directory/scheduler-v2.json"
		legacy_stage=$(mktemp "$state_directory/.scheduler-legacy.XXXXXX") || return 1
		chmod 0600 -- "$legacy_stage"
		printf '{"schema":"%s","observed_at_ms":%s,"scheduler":%s}\n' \
			"$LEGACY_SAMPLE_SCHEMA" "$observed" "$scheduler" >"$legacy_stage"
		mv -fT -- "$legacy_stage" "$state_directory/scheduler.json"
		last_scheduler=$scheduler
		last_worker=$worker
	fi
	if [[ $telemetry_signature != "${last_telemetry_signature-}" ]]; then
		telemetry_stage=$(mktemp "$state_directory/.telemetry.XXXXXX") || return 1
		chmod 0600 -- "$telemetry_stage"
		printf '{"schema":"%s","observed_at_ms":%s,"scheduler":%s,"worker":%s,"phases":%s,"cache":%s,"temperature":%s}\n' \
			"$COMBINED_SCHEMA" "$observed" "$scheduler" "$worker" "$phases" "$coverage_v2" "$temperature" >"$telemetry_stage"
		mv -fT -- "$telemetry_stage" "$state_directory/telemetry-v1.json"
		last_telemetry_signature=$telemetry_signature
	fi
}

probe_command() {
	if [[ $remote_host == local ]]; then
		"$@"
	else
		ssh -T -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 \
			-o ServerAliveCountMax=2 "$remote_host" "$@"
	fi
}

run_monitor() {
	local lock_details scheduler worker coverage coverage_v2 phases probe_source cache_root container
	local last_scheduler='' last_worker='' last_coverage='' last_coverage_v2='' last_phases='' last_telemetry_signature=''
	probe_source="${self%/*}/../src/qwen_r9700_lab/radiance_cache_residency.py"
	[[ -f $probe_source && ! -L $probe_source ]] || die 'cache residency probe source is missing or unsafe'
	cache_root=${QWEN_RADIANCE_CACHE_ROOT:-/home/lewis/.cache/qwen-radiance-public-clean-snapshot-v1}
	[[ $cache_root =~ ^/[A-Za-z0-9_./-]+$ ]] || die 'invalid cache probe path'
	# Sessions started before explicit deployment selection keep their legacy target.
	container=${QWEN_RADIANCE_CONTAINER:-qwen38-27b-uncensored-mxfp4-public-snapshot-candidate}
	[[ $container =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die 'invalid backend container'
	validate_state_directory "$state_directory"
	if [[ -e $state_directory/scheduler-monitor.lock || -L $state_directory/scheduler-monitor.lock ]]; then
		[[ -f $state_directory/scheduler-monitor.lock && ! -L $state_directory/scheduler-monitor.lock ]] ||
			die "unsafe monitor lock: $state_directory/scheduler-monitor.lock"
	fi
	exec {monitor_lock_fd}>>"$state_directory/scheduler-monitor.lock"
	chmod 0600 -- "$state_directory/scheduler-monitor.lock"
	lock_details=$(stat -c '%u:%h:%a' -- "$state_directory/scheduler-monitor.lock") ||
		die "cannot inspect monitor lock"
	[[ $lock_details == "$(id -u):1:600" ]] || die "unsafe monitor lock ownership or mode"
	flock -n "$monitor_lock_fd" || exit 0
	have_active_client || exit 0

	while IFS=$'\t' read -r scheduler worker coverage coverage_v2 phases; do
		write_sample "$scheduler" "$worker" "$coverage" "$coverage_v2" "$phases" || true
		have_active_client || break
	done < <(
		probe_command /usr/bin/python3 -u - \
			"$SAMPLE_INTERVAL_SECONDS" "$cache_root" auto --container "$container" <"$probe_source"
	)
}

ensure_monitor() {
	validate_state_directory "$state_directory"
	nohup "$self" monitor "$state_directory" "$remote_host" </dev/null >/dev/null 2>&1 &
}

main() {
	(($# == 3)) || die "usage: $PROGRAM ensure|monitor STATE_DIRECTORY REMOTE_HOST"
	local action=$1
	state_directory=$2
	remote_host=$3
	[[ $remote_host =~ ^[A-Za-z0-9_.@:-]{1,255}$ ]] || die "invalid remote host"
	case $action in
	ensure) ensure_monitor ;;
	monitor) run_monitor ;;
	*) die "unknown action: $action" ;;
	esac
}

self=$(readlink -e -- "${BASH_SOURCE[0]}") || die "cannot resolve executable path"
readonly self
state_directory=''
remote_host=''
main "$@"
