# The strict tool-call patch intentionally changes the same OpenAI adapter after
# this usage patch. Normalize that independently authenticated transform while
# classifying our own bytes so repeated installer verification remains idempotent.
TOOL_CALL_INTEGRITY_RELATIVE = "node_modules/@earendil-works/pi-ai/dist/api/openai-completions.js"
