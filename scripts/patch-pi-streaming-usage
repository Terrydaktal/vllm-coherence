                        block.arguments = parseStreamingJson(block.partialArgs);
                    }
"""
TOOL_CALL_INTEGRITY_NEW = b"""                    else {
                        let completeArguments;
                        try {
                            completeArguments = JSON.parse(block.partialArgs);
                        }
                        catch {
                            throw new Error(
                                "Provider tool-call integrity server error: the stream ended " +
                                    "before a complete JSON argument object was emitted",
                            );
                        }
                        if (
                            completeArguments === null ||
                            typeof completeArguments !== "object" ||
                            Array.isArray(completeArguments)
                        ) {
                            throw new Error(
                                "Provider tool-call integrity server error: final tool arguments " +
                                    "were not a JSON object",
                            );
                        }
                        block.arguments = completeArguments;
                    }
"""
