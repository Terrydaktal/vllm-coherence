#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly PROGRAM=qwen-radiance-gpu-temperature
readonly CLIENT_STALE_SECONDS=20
readonly SAMPLE_INTERVAL_SECONDS=1

die() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
	exit 2
}

validate_state_directory() {
	local path=$1 details
	[[ $path == /* && -d $path && ! -L $path ]] || die "unsafe state directory: $path"
	details=$(stat -c '%u:%a' -- "$path") || die "cannot inspect state directory: $path"
	[[ $details == "$(id -u):700" ]] || die "unsafe state directory ownership or mode: $path"
	[[ -d $path/clients && ! -L $path/clients ]] || die "client directory is missing or unsafe: $path/clients"
	details=$(stat -c '%u:%a' -- "$path/clients") || die "cannot inspect client directory: $path/clients"
	[[ $details == "$(id -u):700" ]] || die "unsafe client directory ownership or mode: $path/clients"
}

owned_process() {
	local pid=$1 expected_start=$2 observed
	[[ $pid =~ ^[1-9][0-9]*$ && $expected_start =~ ^[1-9][0-9]*$ && -r /proc/$pid/stat ]] || return 1
	observed=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
	[[ $observed == "$expected_start" ]]
}

have_active_client() {
	local marker filename pid start marker_details marker_mtime now
	now=$(date +%s)
	shopt -s nullglob
	for marker in "$state_directory"/clients/*.heartbeat; do
		[[ -f $marker && ! -L $marker ]] || continue
		marker_details=$(stat -c '%u:%h:%a' -- "$marker" 2>/dev/null) || continue
		[[ $marker_details == "$(id -u):1:600" ]] || continue
		filename=${marker##*/}
		if [[ $filename =~ ^([1-9][0-9]*)-([1-9][0-9]*)-[0-9a-f]{16}\.heartbeat$ ]]; then
			pid=${BASH_REMATCH[1]}
			start=${BASH_REMATCH[2]}
		else
			continue
		fi
		marker_mtime=$(stat -c %Y -- "$marker" 2>/dev/null) || continue
		if ((now - marker_mtime <= CLIENT_STALE_SECONDS)) && owned_process "$pid" "$start"; then
			return 0
		fi
		rm -f -- "$marker"
	done
	return 1
}

write_sample() {
	local edge=$1 junction=$2 fan=$3 observed stage
	[[ $edge =~ ^[0-9]{1,6}$ && $junction =~ ^[0-9]{1,6}$ && $fan =~ ^[0-9]{1,3}$ ]] || return 1
	((10#$edge <= 250000 && 10#$junction <= 250000 && 10#$fan <= 100)) || return 1
	observed=$(date +%s)
	stage=$(mktemp "$state_directory/.sample.XXXXXX") || return 1
	chmod 0600 -- "$stage"
	printf '{"schema":"urn:qwen-r9700:gpu-temperature:v2","observed_at_ms":%s000,"edge_millicelsius":%s,"junction_millicelsius":%s,"fan_percent":%s}\n' \
		"$observed" "$((10#$edge))" "$((10#$junction))" "$((10#$fan))" >"$stage"
	mv -fT -- "$stage" "$state_directory/sample.json"
}

probe_command() {
	if [[ $remote_host == local ]]; then
		"$@"
	else
		ssh -T -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 \
			-o ServerAliveCountMax=2 "$remote_host" "$@"
	fi
}

run_monitor() {
	local lock_details edge junction fan
	validate_state_directory "$state_directory"
	if [[ -e $state_directory/monitor.lock || -L $state_directory/monitor.lock ]]; then
		[[ -f $state_directory/monitor.lock && ! -L $state_directory/monitor.lock ]] ||
			die "unsafe monitor lock: $state_directory/monitor.lock"
	fi
	exec {monitor_lock_fd}>>"$state_directory/monitor.lock"
	chmod 0600 -- "$state_directory/monitor.lock"
	lock_details=$(stat -c '%u:%h:%a' -- "$state_directory/monitor.lock") ||
		die "cannot inspect monitor lock"
	[[ $lock_details == "$(id -u):1:600" ]] || die "unsafe monitor lock ownership or mode"
	flock -n "$monitor_lock_fd" || exit 0
	have_active_client || exit 0

	while IFS=$'\t' read -r edge junction fan; do
		write_sample "$edge" "$junction" "$fan" || continue
		have_active_client || break
	done < <(
		probe_command /usr/bin/bash -s -- \
			"$SAMPLE_INTERVAL_SECONDS" <<'REMOTE_PROBE'
set -euo pipefail
interval=$1
edge_file=''
junction_file=''
pwm_file=''
pwm_max_file=''
for hwmon in /sys/class/drm/card*/device/hwmon/hwmon*; do
    [[ -d $hwmon ]] || continue
    candidate_edge=''
    candidate_junction=''
    for label_file in "$hwmon"/temp*_label; do
        [[ -r $label_file ]] || continue
        label=$(<"$label_file")
        case $label in
        edge) candidate_edge=${label_file%_label}_input ;;
        junction) candidate_junction=${label_file%_label}_input ;;
        esac
    done
    if [[ -r $candidate_edge && -r $candidate_junction && -r $hwmon/pwm1 && -r $hwmon/pwm1_max ]]; then
        edge_file=$candidate_edge
        junction_file=$candidate_junction
        pwm_file=$hwmon/pwm1
        pwm_max_file=$hwmon/pwm1_max
        break
    fi
done
[[ -n $edge_file && -n $junction_file && -n $pwm_file && -n $pwm_max_file ]] || exit 3
while :; do
    edge=$(<"$edge_file")
    junction=$(<"$junction_file")
    pwm=$(<"$pwm_file")
    pwm_max=$(<"$pwm_max_file")
    [[ $edge =~ ^[0-9]{1,6}$ && $junction =~ ^[0-9]{1,6}$ &&
        $pwm =~ ^[0-9]{1,6}$ && $pwm_max =~ ^[1-9][0-9]{0,5}$ ]] || exit 3
    pwm_value=$((10#$pwm))
    pwm_max_value=$((10#$pwm_max))
    ((pwm_value <= pwm_max_value)) || exit 3
    fan_percent=$(((pwm_value * 100 + pwm_max_value / 2) / pwm_max_value))
    printf '%s\t%s\t%s\n' "$edge" "$junction" "$fan_percent"
    sleep "$interval"
done
REMOTE_PROBE
	)
}

ensure_monitor() {
	validate_state_directory "$state_directory"
	nohup "$self" monitor "$state_directory" "$remote_host" </dev/null >/dev/null 2>&1 &
}

main() {
	(($# == 3)) || die "usage: $PROGRAM ensure|monitor STATE_DIRECTORY REMOTE_HOST"
	local action=$1
	state_directory=$2
	remote_host=$3
	[[ $remote_host =~ ^[A-Za-z0-9_.@:-]{1,255}$ ]] || die "invalid remote host"
	case $action in
	ensure) ensure_monitor ;;
	monitor) run_monitor ;;
	*) die "unknown action: $action" ;;
	esac
}

self=$(readlink -e -- "${BASH_SOURCE[0]}") || die "cannot resolve executable path"
readonly self
state_directory=''
remote_host=''
main "$@"
