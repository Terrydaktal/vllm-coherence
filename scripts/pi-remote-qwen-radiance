readonly compaction_progress="$project_root/integrations/pi/qwen-radiance-compaction-progress.mjs"
readonly cache_extension="$project_root/integrations/pi/qwen-radiance-cache.mjs"
readonly compaction_prompt="$project_root/integrations/pi/qwen-loss-sensitive-compact-prompt.md"
readonly history_program="$project_root/scripts/pi-session-history"

for command_name in awk chmod cmp curl date env flock id jq mkdir mktemp mv nohup readlink sha256sum sleep ss ssh stat tr; do
	command -v "$command_name" >/dev/null 2>&1 || die "required command is missing: $command_name"
done
[[ -f $gpu_temperature_extension && ! -L $gpu_temperature_extension &&
	$(stat -c '%u:%h' -- "$gpu_temperature_extension") == "$(id -u):1" ]] ||
	die "GPU temperature extension is missing or unsafe: $gpu_temperature_extension"
[[ -f $gpu_temperature_helper && ! -L $gpu_temperature_helper && -x $gpu_temperature_helper &&
	$(stat -c '%u:%h' -- "$gpu_temperature_helper") == "$(id -u):1" ]] ||
	die "GPU temperature helper is missing or unsafe: $gpu_temperature_helper"
[[ -f $scheduler_status_helper && ! -L $scheduler_status_helper && -x $scheduler_status_helper &&
	$(stat -c '%u:%h' -- "$scheduler_status_helper") == "$(id -u):1" ]] ||
	die "scheduler status helper is missing or unsafe: $scheduler_status_helper"
[[ -f $models_source && ! -L $models_source ]] || die 'Pi model configuration is missing or unsafe'
for config_file in "$settings_source" "$operating_prompt" "$rehydrate_extension" "$scheduler_telemetry_module" "$cache_residency_module" "$cache_residency_probe"; do
	[[ -f $config_file && ! -L $config_file &&
		$(stat -c '%u:%h' -- "$config_file") == "$(id -u):1" ]] ||
		die "Pi configuration dependency is missing or unsafe: $config_file"
done
jq -e '.defaultTools | type == "array" and length > 0 and all(.[]; type == "string")' \
	"$settings_source" >/dev/null || die 'Pi default tool configuration is invalid'
[[ -f $abi_source && ! -L $abi_source ]] || die 'snapshot ABI is missing or unsafe'
[[ -f $launcher_source && ! -L $launcher_source ]] || die 'server launcher is missing or unsafe'
[[ -f $patch_source && ! -L $patch_source ]] || die 'snapshot patch is missing or unsafe'
[[ -f $searchtool_extension && ! -L $searchtool_extension &&
	$(stat -c '%u:%h' -- "$searchtool_extension") == "$(id -u):1" ]] ||
	die "searchtool extension is missing or unsafe: $searchtool_extension"
[[ -f $searchtool_recovery_extension && ! -L $searchtool_recovery_extension &&
	$(stat -c '%u:%h' -- "$searchtool_recovery_extension") == "$(id -u):1" ]] ||
	die "recovery extension is missing or unsafe: $searchtool_recovery_extension"
for compaction_file in "$compaction_extension" "$compaction_core" "$compaction_progress" "$compaction_prompt" "$cache_extension" "$backend_errors_module" "$backend_errors_probe"; do
	[[ -f $compaction_file && ! -L $compaction_file &&
		$(stat -c '%u:%h' -- "$compaction_file") == "$(id -u):1" ]] ||
		die "prefix compaction dependency is missing or unsafe: $compaction_file"
done
[[ -f $history_program && ! -L $history_program && -x $history_program &&
	$(stat -c '%u:%h' -- "$history_program") == "$(id -u):1" ]] ||
	die "project session history helper is missing or unsafe: $history_program"
[[ $(sha256sum -- "$abi_source" | awk '{print $1}') == "$SNAPSHOT_ABI" ]] || die 'local snapshot ABI hash mismatch'
[[ $(jq -r '.storage.data_abi' "$abi_source") == "$SNAPSHOT_DATA_ABI" ]] || die 'local snapshot data ABI mismatch'
[[ $(sha256sum -- "$launcher_source" | awk '{print $1}') == "$REMOTE_LAUNCHER_SHA256" ]] || die 'local server launcher hash mismatch'
[[ $(sha256sum -- "$patch_source" | awk '{print $1}') == "$SNAPSHOT_PATCH_SHA256" ]] || die 'local snapshot patch hash mismatch'
for module in "$cache_module" "$memory_module" "$cache_tier_module" "$fair_scheduler_module" "$cache_patch_module"; do
	[[ -f $module && ! -L $module ]] || die "missing chat storage module: $module"
	expected=$(jq -r --arg name "${module##*/}" '.runtime.chat_storage.modules[$name]' "$abi_source")
	[[ $(sha256sum "$module" | awk '{print $1}') == "$expected" ]] || die "chat storage module hash mismatch: $module"
done
declare -a release_preflight=()
while IFS=$'\t' read -r module expected; do
	path="${launcher_source%/*}/$module"
	[[ -f $path && ! -L $path && $(sha256sum "$path" | awk '{print $1}') == "$expected" ]] ||
		die "release integration hash mismatch: $module"
	release_preflight+=("$REMOTE_ROOT/radiance-vllm-mxfp4/$module" "$expected")
done < <(jq -r '.runtime.release_files | to_entries[] | [.key, .value] | @tsv' "$abi_source")
jq -e --arg model "$MODEL_ID" '
  [.providers["qwen-r9700"].models[] | select(.id == $model)] as $models
  | ($models | length) == 1
  and $models[0].contextWindow == 253792
  and $models[0].maxTokens == $models[0].contextWindow
	  and $models[0].samplingParams == {temperature: 1, top_p: 0.95, top_k: 40}
' "$models_source" >/dev/null || die 'local Pi model contract is invalid'

if ((dry_run)); then
	printf 'model:        %s\n' "$PI_MODEL"
	printf 'remote:       %s:%s\n' "$remote_host" "$REMOTE_PORT"
	if ((local_port_explicit)); then
		printf 'local API:    http://127.0.0.1:%s/v1 (explicit)\n' "$local_port"
	else
		printf 'local API:    automatic; first free port in %s..%s\n' \
			"$AUTO_LOCAL_PORT_FIRST" "$AUTO_LOCAL_PORT_LAST"
	fi
	printf 'runtime ABI:  %s\n' "$SNAPSHOT_ABI"
	printf 'snapshot ABI: %s\n' "$SNAPSHOT_DATA_ABI"
	printf 'context:      253792\n'
	printf 'generation:   all remaining context; no separate output or thinking cap\n'
	printf 'sampling:     public stochastic 1/0.95/40\n'
	printf 'default tools: %s\n' "$(jq -r '.defaultTools | join(", ")' "$settings_source")"
	printf 'preferences:  %s\n' "$operating_prompt"
	printf 'context files: disabled\n'
	printf 'recovery:     all Radiance chats; hidden continuation after omitted tool announcements; max 2 per user message\n'
	exit 0
fi

if ((preflight_only == 0)); then
	project_history_dir=$("$history_program" prepare --cwd "$project_cwd") ||
		die "cannot prepare project session history: $project_cwd"
	readonly project_history_dir
	resolve_project_session_args
fi

remote_launcher="$REMOTE_ROOT/launch_public_clean_snapshot_server.sh"
remote_patch="$REMOTE_ROOT/radiance-vllm-mxfp4/patch_streaming_snapshot.py"
remote_abi="$REMOTE_CACHE/snapshots/$SNAPSHOT_ABI/abi.json"

ssh -T "$remote_host" /usr/bin/bash -s -- \
	"$remote_launcher" "$REMOTE_LAUNCHER_SHA256" \
	"$remote_patch" "$SNAPSHOT_PATCH_SHA256" \
	"$REMOTE_ROOT/radiance-vllm-mxfp4/radiance_cache.py" "$(jq -r '.runtime.chat_storage.modules["radiance_cache.py"]' "$abi_source")" \
	"$REMOTE_ROOT/radiance-vllm-mxfp4/radiance_memory.py" "$(jq -r '.runtime.chat_storage.modules["radiance_memory.py"]' "$abi_source")" \
	"$REMOTE_ROOT/radiance-vllm-mxfp4/radiance_chat_tier.py" "$(jq -r '.runtime.chat_storage.modules["radiance_chat_tier.py"]' "$abi_source")" \
	"$REMOTE_ROOT/radiance-vllm-mxfp4/radiance_fair_scheduler.py" "$(jq -r '.runtime.chat_storage.modules["radiance_fair_scheduler.py"]' "$abi_source")" \
	"$REMOTE_ROOT/radiance-vllm-mxfp4/patch_chat_snapshot.py" "$(jq -r '.runtime.chat_storage.modules["patch_chat_snapshot.py"]' "$abi_source")" \
	"$remote_abi" "$SNAPSHOT_ABI" "${release_preflight[@]}" <<'REMOTE_PREFLIGHT'
set -euo pipefail
while (($#)); do
    path=$1
    expected=$2
    shift 2
    [[ -f $path && ! -L $path && $(stat -c '%U:%h' -- "$path") == 'lewis:1' ]] || exit 2
    [[ $(sha256sum -- "$path" | awk '{print $1}') == "$expected" ]] || exit 2
done
REMOTE_PREFLIGHT

((preflight_only == 0)) || exit 0

backend_log=$(
	ssh -T "$remote_host" /usr/bin/bash -s -- \
		"$CONTAINER" "$MODEL_ID" "$IMAGE_ID" "$REMOTE_PORT" \
		"$remote_launcher" "$REMOTE_CACHE" "$SNAPSHOT_DATA_ABI" "$reuse_existing" "$SNAPSHOT_ABI" \
		"$(jq -r '.runtime.memory_report.compatible_runtime_abis | join(" ")' "$abi_source")" <<'REMOTE_BACKEND'
set -euo pipefail
container=$1
model=$2
image_id=$3
port=$4
launcher=$5
cache=$6
abi=$7
reuse=$8
runtime_abi=$9
# SSH's command string can omit the final empty compatibility argument.
compatible_runtime_abi=${10-}

validate_backend() {
    local inspect models args candidate runtime_matches=0
    local -a compatible_runtime_abis=()
    inspect=$(podman inspect "$container") || return 1
	jq -e --arg image "$image_id" --arg name "$container" '
      length == 1 and .[0].State.Running == true
      and .[0].Image == $image and .[0].Name == $name
    ' <<<"$inspect" >/dev/null || return 1
    args=$(jq -r '.[0].Args | join(" ")' <<<"$inspect") || return 1
    # Diagnostic additions preserve the exact qualified predecessors while live.
    read -r -a compatible_runtime_abis <<<"$compatible_runtime_abi"
    for candidate in "$runtime_abi" "${compatible_runtime_abis[@]}"; do
        [[ $candidate =~ ^[0-9a-f]{64}$ ]] || continue
        if [[ $args == *"qwen-radiance-public-clean-${candidate:0:16}"* ]]; then
            runtime_matches=1
            break
        fi
    done
    ((runtime_matches == 1)) || return 1
    [[ $args == *"--served-model-name $model"* \
        && $args == *'--max-model-len 253792'* \
		        && $args == *"/cache/snapshots/$abi/data"* \
			        && $args == *'qwen_chat_fs'* \
        && $args == *'--kv-cache-dtype fp8'* \
        && $args == *'--speculative-config'* ]] || return 1
    models=$(curl -fsS --max-time 5 "http://127.0.0.1:$port/v1/models") || return 1
    jq -e --arg model "$model" '.data | length == 1 and .[0].id == $model' \
        <<<"$models" >/dev/null
}

if podman container exists "$container"; then
    validate_backend || {
        echo 'existing Radiance container differs from the authenticated lane' >&2
        exit 2
    }
    printf 'existing\n'
    exit 0
fi
if curl -fsS --max-time 2 "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
    echo "remote port $port is occupied by an unowned endpoint" >&2
    exit 2
fi
((reuse == 0)) || {
    echo 'the authenticated Radiance backend is not running' >&2
    exit 2
}

mkdir -p "$cache/logs"
log="$cache/logs/pi-radiance-$(date -u +%Y%m%dT%H%M%SZ).log"
nohup "$launcher" >"$log" 2>&1 </dev/null &
for _ in {1..1200}; do
    if validate_backend 2>/dev/null; then
        printf '%s\n' "$log"
        exit 0
    fi
    if ! kill -0 $! 2>/dev/null && ! podman container exists "$container"; then
        tail -n 80 "$log" >&2 || true
        exit 2
    fi
    sleep 0.2
done
tail -n 80 "$log" >&2 || true
exit 2
REMOTE_BACKEND
) || die 'remote Radiance backend authentication/startup failed'

prepare_local_port_state
prepare_gpu_temperature_state
reserve_local_port
readonly local_port local_port_lock_fd local_port_selection
readonly gpu_temperature_state
printf 'Radiance local tunnel reserved: 127.0.0.1:%s (%s)\n' \
	"$local_port" "$local_port_selection" >&2

readonly agent_dir="$state_root/agent-$local_port"
mkdir -p "$agent_dir"
chmod 0700 "$state_root" "$agent_dir"
readonly config_destination="$agent_dir/models.json"
config_stage=$(mktemp "$state_root/.models.json.XXXXXX") || die 'cannot create Pi model configuration stage'
cleanup_stage() {
	[[ -z ${config_stage:-} || ! -f $config_stage || -L $config_stage ]] || rm -f -- "$config_stage"
}
trap cleanup_stage EXIT
jq -S --arg base "http://127.0.0.1:$local_port/v1" \
	'.providers["qwen-r9700"].baseUrl = $base' "$models_source" >"$config_stage" ||
	die 'cannot render Pi model configuration'
if [[ -e $config_destination || -L $config_destination ]]; then
	[[ -f $config_destination && ! -L $config_destination && $(stat -c '%u' -- "$config_destination") == "$(id -u)" ]] ||
		die 'existing Pi model configuration is unsafe'
	"$deploy_script" --replace-provider --source "$config_stage" --destination "$config_destination" >/dev/null
else
	"$deploy_script" --source "$config_stage" --destination "$config_destination" >/dev/null
fi
rm -f -- "$config_stage"
config_stage=$(mktemp "$agent_dir/.settings.json.XXXXXX") || die 'cannot create Pi settings stage'
readonly settings="$agent_dir/settings.json"
if [[ -e $settings || -L $settings ]]; then
	[[ -f $settings && ! -L $settings && $(stat -c '%u:%h' -- "$settings") == "$(id -u):1" ]] ||
		die 'existing Pi settings are unsafe'
	jq -S --slurpfile defaults "$settings_source" '$defaults[0] * .' "$settings" >"$config_stage" ||
		die 'cannot merge Pi default settings'
else
	jq -S . "$settings_source" >"$config_stage" || die 'cannot render Pi default settings'
fi
chmod 0600 "$config_stage"
if cmp -s -- "$config_stage" "$settings"; then
	rm -f -- "$config_stage"
else
	mv -f -- "$config_stage" "$settings"
fi
config_stage=''
trap - EXIT

pi_link="$HOME/.local/bin/pi"
if ((no_install)); then
	[[ -L $pi_link && -x $pi_link ]] || die "verified Pi link is missing: $pi_link"
elif [[ ! -L $pi_link || ! -x $pi_link ]] || ! "$pi_link" --version 2>/dev/null | grep -qx "$PI_VERSION"; then
	"$install_script" >/dev/null
fi
[[ -L $pi_link && -x $pi_link && $("$pi_link" --version) == "$PI_VERSION" ]] || die "Pi $PI_VERSION is unavailable"

tunnel_log="$state_root/tunnel-$local_port-$(date -u +%Y%m%dT%H%M%SZ).log"
ssh -N -T -o ExitOnForwardFailure=yes \
	-L "127.0.0.1:$local_port:127.0.0.1:$REMOTE_PORT" "$remote_host" \
	{local_port_lock_fd}>&- >"$tunnel_log" 2>&1 &
tunnel_pid=$!
tunnel_start=$(awk '{print $22}' "/proc/$tunnel_pid/stat" 2>/dev/null || true)
[[ $tunnel_start =~ ^[1-9][0-9]*$ ]] || die 'cannot authenticate SSH tunnel process'
cleanup() {
	local status=$?
	if owned_process "$tunnel_pid" "$tunnel_start"; then
		kill -TERM "$tunnel_pid" 2>/dev/null || true
		wait "$tunnel_pid" 2>/dev/null || true
	fi
	exec {local_port_lock_fd}>&-
	exit "$status"
}
trap cleanup EXIT HUP INT TERM
for _ in {1..100}; do
	if curl -fsS --max-time 2 "http://127.0.0.1:$local_port/health" >/dev/null 2>&1; then
		break
	fi
	owned_process "$tunnel_pid" "$tunnel_start" || die 'SSH tunnel exited during startup'
	sleep 0.2
done
models=$(curl -fsS --max-time 5 "http://127.0.0.1:$local_port/v1/models") || die 'local Radiance endpoint is unavailable'
jq -e --arg model "$MODEL_ID" '.data | length == 1 and .[0].id == $model' <<<"$models" >/dev/null ||
	die 'local endpoint advertises the wrong model'

# A health check only proves that the HTTP server is listening.  The first real
# DFlash request can still compile the model, Global-256 head and rejection
# kernels for the multi-token speculative shape, which creates the misleading
# slow-to-normal round transition seen in the preserved diagnosis.  Warm a
# content-free multi-token request before Pi opens; it is not attached to a
# session and cannot alter a user's snapshot.  This also runs for
# --reuse-existing: attaching to a restarted backend must not expose Pi to a
# first-use compilation spike.  The request only populates the backend's
# compiled-kernel cache; it does not change model weights, chat state or
# snapshot data.  Set QWEN_PI_SKIP_WARMUP=1 only for an explicit diagnostic
# attach that accepts the risk of an inference-time JIT.
#
# Read the container journal, regardless of how the server was started. On
# reuse, backend_log is the display label "existing", not a filename. Pin the
# container ID and use a fresh remote timestamp for each attempt so historical
# JIT warnings cannot poison a later warmup or a replacement server pass it.
if [[ ${QWEN_PI_SKIP_WARMUP:-0} != 1 ]]; then
	jit_container_id=$(
		ssh -T "$remote_host" /usr/bin/bash -s -- "$CONTAINER" <<'REMOTE_JIT_CONTAINER'
set -euo pipefail
podman inspect --format '{{.Id}}' "$1"
REMOTE_JIT_CONTAINER
	) || die 'Radiance startup warmup could not identify the remote backend container'
	[[ $jit_container_id =~ ^[0-9a-f]{64}$ ]] || die 'Radiance startup warmup received an invalid container identity'
	warmup_payload=$(printf '%s' \
		'{"model":"qwen3.8-27b-uncensored-mxfp4-public-snapshot-candidate","prompt":"Output exactly sixty-four short words separated by spaces. Do not stop early. alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa","max_tokens":96,"temperature":1.0,"top_p":0.95,"top_k":40,"stream":false}')
	for warmup_attempt in 1 2 3; do
		jit_log_since=$(
			ssh -T "$remote_host" /usr/bin/bash -s -- "$jit_container_id" <<'REMOTE_JIT_BEGIN'
set -euo pipefail
container=$1
[[ $(podman inspect --format '{{.State.Running}}' "$container") == true ]] || exit 2
podman logs --tail 0 "$container" >/dev/null 2>&1 || exit 2
date -u +'%Y-%m-%dT%H:%M:%S.%NZ'
REMOTE_JIT_BEGIN
		) || die 'Radiance startup warmup could not read the remote backend log'
		[[ $jit_log_since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{9}Z$ ]] ||
			die 'Radiance startup warmup received an invalid remote log timestamp'
		curl --fail --silent --show-error --max-time 300 \
			-H 'Content-Type: application/json' \
			-H "X-Request-ID: pi-radiance-startup-warmup-$warmup_attempt" \
			-d "$warmup_payload" \
			"http://127.0.0.1:$local_port/v1/completions" >/dev/null ||
			die 'Radiance startup warmup failed; refusing to start Pi on a cold or unhealthy backend'
		if ssh -T "$remote_host" /usr/bin/bash -s -- "$jit_container_id" "$jit_log_since" <<'REMOTE_JIT_CHECK'; then
set -euo pipefail
container=$1
since=$2
for poll_attempt in {1..20}; do
	[[ $(podman inspect --format '{{.State.Running}}' "$container") == true ]] || exit 2
	recent=$(podman logs --since "$since" "$container" 2>&1) || exit 2
	if [[ $recent == *'JIT compilation during inference'* ]]; then
		exit 0
	fi
	sleep 0.1
done
exit 1
REMOTE_JIT_CHECK
			jit_status=0
		else
			jit_status=$?
		fi
		case $jit_status in
		0)
			if ((warmup_attempt < 3)); then
				printf 'Radiance startup warmup compiled new inference shapes; repeating warmup (%s/3)\n' \
					"$warmup_attempt" >&2
				continue
			fi
			ssh -T "$remote_host" /usr/bin/bash -s -- "$jit_container_id" "$jit_log_since" <<'REMOTE_JIT_TAIL' >&2 || true
set -euo pipefail
podman logs --since "$2" "$1" 2>&1 | grep -F 'JIT compilation during inference'
REMOTE_JIT_TAIL
			die 'Radiance startup warmup still observed inference-time Triton JIT after three attempts'
			;;
		1) break ;;
		*) die 'Radiance startup warmup could not inspect the remote backend log' ;;
		esac
	done
	if ((reuse_existing == 1)); then
		printf 'reused Radiance backend validated; non-session startup warmup complete\n' >&2
	else
		printf 'Radiance startup warmup complete; launching Pi\n' >&2
	fi
fi

printf 'Radiance unrestricted backend ready; local API 127.0.0.1:%s; snapshot ABI %s; backend log %s\n' \
	"$local_port" "$SNAPSHOT_DATA_ABI" "$backend_log" >&2
declare -a pi_options=(
	--session-dir "$project_history_dir"
	--no-context-files
	--append-system-prompt "$operating_prompt"
	--no-extensions
	--extension "$progress_extension"
	--extension "$gpu_temperature_extension"
	--extension "$tool_output_extension"
	--extension "$rehydrate_extension"
	--extension "$searchtool_extension"
	--extension "$compaction_extension"
	--extension "$cache_extension"
	--extension "$searchtool_recovery_extension"
)
if [[ -t 0 && -t 1 ]]; then
	env PI_CODING_AGENT_DIR="$agent_dir" PI_OFFLINE=1 \
		UV_CACHE_DIR=/data/.cache/uv \
		QWEN_RADIANCE_LOCAL_PORT="$local_port" \
		QWEN_RADIANCE_CONTAINER="$CONTAINER" \
		QWEN_RADIANCE_GPU_TEMPERATURE_STATE="$gpu_temperature_state" \
		QWEN_RADIANCE_GPU_TEMPERATURE_HELPER="$gpu_temperature_helper" \
		QWEN_RADIANCE_SCHEDULER_HELPER="$scheduler_status_helper" \
		QWEN_RADIANCE_CACHE_HOST="$remote_host" QWEN_RADIANCE_CACHE_ROOT="$REMOTE_CACHE" QWEN_RADIANCE_CACHE_ABI="$SNAPSHOT_DATA_ABI" \
		"$pi_link" --model "$PI_MODEL" --thinking "$thinking" \
		"${pi_options[@]}" "${pi_args[@]}" {local_port_lock_fd}>&- </dev/tty
else
	env PI_CODING_AGENT_DIR="$agent_dir" PI_OFFLINE=1 \
		UV_CACHE_DIR=/data/.cache/uv \
		QWEN_RADIANCE_LOCAL_PORT="$local_port" \
		QWEN_RADIANCE_CONTAINER="$CONTAINER" \
		QWEN_RADIANCE_GPU_TEMPERATURE_STATE="$gpu_temperature_state" \
		QWEN_RADIANCE_GPU_TEMPERATURE_HELPER="$gpu_temperature_helper" \
		QWEN_RADIANCE_SCHEDULER_HELPER="$scheduler_status_helper" \
		QWEN_RADIANCE_CACHE_HOST="$remote_host" QWEN_RADIANCE_CACHE_ROOT="$REMOTE_CACHE" QWEN_RADIANCE_CACHE_ABI="$SNAPSHOT_DATA_ABI" \
		"$pi_link" --model "$PI_MODEL" --thinking "$thinking" \
		"${pi_options[@]}" "${pi_args[@]}" {local_port_lock_fd}>&-
fi
