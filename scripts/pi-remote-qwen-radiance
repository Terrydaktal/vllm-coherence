#!/usr/bin/env bash

launcher_original_script=${QWEN_PI_RADIANCE_ORIGINAL_SCRIPT:-}
if [[ ${QWEN_PI_RADIANCE_SOURCE_SEALED:-0} != 1 ]]; then
	launcher_source=$(readlink -e -- "${BASH_SOURCE[0]}") || {
		printf 'pi-remote-qwen-radiance: cannot resolve its launcher source\n' >&2
		exit 2
	}
	exec /usr/bin/python3 -c '
import fcntl
import os
import sys

source_path = sys.argv[1]
source_fd = os.open(source_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
before = os.fstat(source_fd)
source = bytearray()
while chunk := os.read(source_fd, 1024 * 1024):
    source.extend(chunk)
after = os.fstat(source_fd)
os.close(source_fd)
identity = lambda value: (
    value.st_dev,
    value.st_ino,
    value.st_size,
    value.st_mtime_ns,
    value.st_ctime_ns,
)
if identity(before) != identity(after) or len(source) != before.st_size:
    raise SystemExit("pi-remote-qwen-radiance: source changed while sealing")
sealed_fd = os.memfd_create("pi-remote-qwen-radiance", os.MFD_ALLOW_SEALING)
offset = 0
while offset < len(source):
    offset += os.write(sealed_fd, source[offset:])
os.lseek(sealed_fd, 0, os.SEEK_SET)
fcntl.fcntl(
    sealed_fd,
    fcntl.F_ADD_SEALS,
    fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE,
)
os.set_inheritable(sealed_fd, True)
environment = os.environ.copy()
environment["QWEN_PI_RADIANCE_SOURCE_SEALED"] = "1"
environment["QWEN_PI_RADIANCE_ORIGINAL_SCRIPT"] = source_path
os.execve(
    "/usr/bin/bash",
    ["/usr/bin/bash", f"/proc/self/fd/{sealed_fd}", *sys.argv[2:]],
    environment,
)
' "$launcher_source" "$@"
fi
unset QWEN_PI_RADIANCE_SOURCE_SEALED QWEN_PI_RADIANCE_ORIGINAL_SCRIPT

set -euo pipefail
umask 077

readonly PROGRAM=pi-remote-qwen-radiance
readonly PI_VERSION=0.84.2
readonly MODEL_ID=qwen3.8-27b-uncensored-mxfp4-public-snapshot-candidate
readonly PI_MODEL="qwen-r9700/$MODEL_ID"
readonly SNAPSHOT_ABI=2fcc0356f7108572673b38e95c067cfa6c657b0ae0229b3a32ce256f76a6ad01
readonly SNAPSHOT_DATA_ABI=36f9b53e291fe2c7bd8e38f3cac509d1f9b7d61d7818ba2bf5e04c0f75606cb5
readonly SNAPSHOT_PATCH_SHA256=d3f67e813275bf8331e2d586e74c6e466307d39f0953396431c8c00c501259dd
readonly REMOTE_LAUNCHER_SHA256=c1d257d75595ee73d164619a0e37ca8786c8a0f360fbdbd2b68efe295d48e8fd
readonly IMAGE_ID=4adbeb66552ed76b329734ee5e830d79ed22961662b886e5029c9920d1bdb7cf
readonly DEFAULT_REMOTE=lewis@ai
readonly AUTO_LOCAL_PORT_FIRST=8012
readonly AUTO_LOCAL_PORT_LAST=8099
readonly DEFAULT_THINKING=xhigh
