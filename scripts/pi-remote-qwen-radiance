local_port=''
local_port_explicit=0
local_port_lock_fd=''
local_port_selection=''
thinking=$DEFAULT_THINKING
no_install=0
reuse_existing=0
preflight_only=0
dry_run=0
declare -a pi_args=()

while (($# > 0)); do
	case $1 in
	--remote)
		(($# >= 2)) || die '--remote requires a value'
		remote_host=$2
		shift 2
		;;
	--local-port)
		(($# >= 2)) || die '--local-port requires a value'
		local_port=$2
		local_port_explicit=1
		shift 2
		;;
	--thinking)
		(($# >= 2)) || die '--thinking requires a value'
		thinking=$2
		shift 2
		;;
	--no-install)
		no_install=1
		shift
		;;
	--reuse-existing)
		reuse_existing=1
		shift
		;;
	--preflight-only)
		preflight_only=1
		shift
		;;
	--dry-run)
		dry_run=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		pi_args=("$@")
		break
		;;
	--session | --session=*)
		pi_args=("$@")
		break
		;;
	*) die "unknown launcher option: $1 (pass Pi options after --)" ;;
	esac
done

if ((local_port_explicit)); then
	is_port "$local_port" || die "invalid local port: $local_port"
fi
case $thinking in off | low | medium | xhigh) ;; *) die "unsupported thinking level: $thinking" ;; esac
((dry_run == 0 || preflight_only == 0)) || die '--dry-run and --preflight-only are mutually exclusive'

readonly models_source="$project_root/integrations/pi/models-radiance-public-clean-snapshot.json"
readonly settings_source="$project_root/integrations/pi/settings-radiance.json"
readonly operating_prompt="$project_root/integrations/pi/qwen-radiance-operating-prompt.md"
readonly abi_source="$project_root/experiments/radiance-public/snapshot-abi-chat-cache-v1.json"
readonly launcher_source="$project_root/experiments/radiance-public/launch_public_clean_snapshot_server.sh"
readonly patch_source="$project_root/experiments/radiance-public/patch_streaming_snapshot.py"
readonly cache_module="$project_root/src/qwen_r9700_lab/radiance_cache.py"
readonly memory_module="$project_root/src/qwen_r9700_lab/radiance_memory.py"
