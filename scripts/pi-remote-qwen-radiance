readonly REMOTE_ROOT=/home/lewis/projects/r9700-radiance-1.0.16-20260913
readonly REMOTE_CACHE=/home/lewis/.cache/qwen-radiance-public-clean-snapshot-v1
readonly CONTAINER=qwen38-27b-uncensored-mxfp4-public-snapshot-candidate

usage() {
	cat <<'EOF'
NAME
    pi-remote-qwen-radiance - run Pi on the snapshot-qualified public Radiance lane

SYNOPSIS
    pi-remote-qwen-radiance [OPTIONS] [-- PI_OPTIONS...]
    pi-remote-qwen-radiance --help

DESCRIPTION
    Authenticates or starts the isolated Qwen3.8 unrestricted MXFP4 Radiance
    backend on lewis@ai, opens a loopback-only SSH tunnel, and launches Pi.
    Durable hybrid snapshots are content-addressed by the exact model/runtime
    ABI and restore attention KV plus GDN/convolution state across restarts.
    Eleven tools are enabled by default, including bounded repository searches,
    web research, and archived-output retrieval. Pi operating preferences are
    appended directly; AGENTS.md and CLAUDE.md discovery is disabled.

OPTIONS
    --remote HOST
        SSH destination. Default: lewis@ai.

    --local-port PORT
        Require this exact local loopback port for the forward to remote port
        8080. When omitted, atomically reserve the first available port in
        8012..8099.

    --thinking LEVEL
        Pi reasoning effort: off, low, medium, or xhigh. Default: xhigh.

    --session PATH|ID|last
        Resume a project-local Pi session. A UUID or unambiguous prefix is
        resolved from <cwd>/.pi/sessions. `last` selects its newest session.
        An absolute path remains supported for explicit cross-project use.

    --no-install
        Require the existing verified Pi 0.84.2 installation.

    --reuse-existing
        Refuse to start a backend; attach only to an authenticated compatible lane.

    --preflight-only
        Authenticate local and remote release inputs without starting the GPU.

    --dry-run
        Validate local arguments and print the selected immutable contract.

    -h, --help
        Show this help text and exit.

OPERATION
    The launcher rejects unknown listeners and containers. When port 8080 is
    free it starts the hash-pinned launcher detached, waits for the exact served
    model, then starts Pi. Pi exit closes only this invocation's SSH tunnel; the
    backend remains available for another chat and may be stopped explicitly.
    Automatic local-port locks are held for the lifetime of Pi and released by
    the kernel on exit, so concurrent launchers cannot choose the same port.
	GPU edge/junction temperatures come from one host-keyed monitor shared by
	every Pi window. Its sample and client heartbeats live only in user tmpfs;
	the monitor exits after the final client disappears.
	Scheduler state uses one additional host-keyed stream shared by every Pi
	window. It carries only chat/generation hashes, request state, and token
	counts so Pi can name GPU queueing, pauses, and prompt/KV preparation.

EXAMPLES
    scripts/pi-remote-qwen-radiance --no-install --thinking xhigh

    scripts/pi-remote-qwen-radiance --no-install --local-port 8012 \
        --thinking xhigh --session /path/to/session.jsonl

    scripts/pi-remote-qwen-radiance --reuse-existing --no-install \
        --thinking xhigh --session last

    scripts/pi-remote-qwen-radiance --reuse-existing --no-install -- \
        -p "Call the bash tool once, then report its output."

FILES
    integrations/pi/models-radiance-public-clean-snapshot.json
        Single-model Pi provider contract using the public stochastic sampling.

    experiments/radiance-public/snapshot-abi-chat-cache-v1.json
        Authenticated model, runtime, serving, and durable-snapshot ABI.

    experiments/radiance-public/launch_public_clean_snapshot_server.sh
        Exact remote backend launcher.

	integrations/pi/qwen-gpu-temperature.mjs
		Publishes the shared edge/junction sample into Pi's inline footer.

	integrations/pi/qwen-radiance-scheduler-telemetry.mjs
		Maps content-free scheduler state to the active Pi chat.

	scripts/qwen-radiance-gpu-temperature
		Singleton monitor using one persistent remote hwmon stream.

	scripts/qwen-radiance-scheduler-status
		Singleton monitor using one persistent remote scheduler-status stream.

PATHS
    ~/.local/state/qwen-r9700/pi-remote/radiance-public-clean-candidate/
        Generated Pi configuration and tunnel/backend logs.

    ~/.local/state/qwen-r9700/pi-remote/radiance-public-clean-candidate/port-locks/
        Persistent zero-byte lock files. Advisory locks, rather than file
        presence, record which local ports are currently reserved.

    <working-directory>/.pi/sessions/
        Model-independent project history used for new sessions and lookup.

	$XDG_RUNTIME_DIR/qwen-radiance-gpu-temperature/<host-hash>/
		Shared tmpfs temperature and scheduler samples, singleton locks, and
		live Pi client heartbeats.

    /home/lewis/.cache/qwen-radiance-public-clean-snapshot-v1/snapshots/
        Remote content-addressed durable hybrid snapshots.

SECURITY NOTES
    All local API listeners are loopback-only. Remote files, image identity,
    snapshot ABI, container arguments, and served model are checked before Pi
    is launched. An occupied but unauthenticated endpoint is never stopped.

EXIT STATUS
    0 when Pi exits successfully; 2 for validation, startup, or health failure;
    otherwise Pi's exit status.

AUTHORS
    Qwen R9700 inference lab maintainers.
EOF
}

die() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
	exit 2
}

is_port() {
	[[ $1 =~ ^[0-9]+$ ]] && ((1 <= 10#$1 && 10#$1 <= 65535))
}

owned_process() {
	local pid=$1 start=$2 observed
	[[ $pid =~ ^[1-9][0-9]*$ && $start =~ ^[1-9][0-9]*$ && -r /proc/$pid/stat ]] || return 1
	observed=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
	[[ $observed == "$start" ]]
}

prepare_local_port_state() {
	if [[ -e $state_root || -L $state_root ]]; then
		[[ -d $state_root && ! -L $state_root && $(stat -c '%u' -- "$state_root") == "$(id -u)" ]] ||
			die "local state root is unsafe: $state_root"
	else
		mkdir -p -- "$state_root" || die "cannot create local state root: $state_root"
	fi
	[[ -d $state_root && ! -L $state_root && $(stat -c '%u' -- "$state_root") == "$(id -u)" ]] ||
		die "local state root changed during creation: $state_root"
	chmod 0700 -- "$state_root" || die "cannot secure local state root: $state_root"

	if [[ -e $port_lock_dir || -L $port_lock_dir ]]; then
		[[ -d $port_lock_dir && ! -L $port_lock_dir && $(stat -c '%u' -- "$port_lock_dir") == "$(id -u)" ]] ||
			die "local port lock directory is unsafe: $port_lock_dir"
	else
		mkdir -p -- "$port_lock_dir" || die "cannot create local port lock directory: $port_lock_dir"
	fi
	[[ -d $port_lock_dir && ! -L $port_lock_dir && $(stat -c '%u' -- "$port_lock_dir") == "$(id -u)" ]] ||
		die "local port lock directory changed during creation: $port_lock_dir"
	chmod 0700 -- "$port_lock_dir" || die "cannot secure local port lock directory: $port_lock_dir"
}

prepare_gpu_temperature_state() {
	local runtime_base temperature_root host_key path details
	runtime_base=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
	[[ $runtime_base == /* && -d $runtime_base && ! -L $runtime_base ]] ||
		die "GPU temperature runtime directory is unsafe: $runtime_base"
	details=$(stat -c '%u:%a' -- "$runtime_base") ||
		die "cannot inspect GPU temperature runtime directory: $runtime_base"
	[[ $details == "$(id -u):700" ]] ||
		die "GPU temperature runtime directory must be owned by this user with mode 0700: $runtime_base"
	temperature_root="$runtime_base/qwen-radiance-gpu-temperature"
	host_key=$(printf '%s' "$remote_host" | sha256sum | awk '{print $1}')
	gpu_temperature_state="$temperature_root/$host_key"
	for path in "$temperature_root" "$gpu_temperature_state" "$gpu_temperature_state/clients"; do
		if [[ ! -e $path && ! -L $path ]] && ! mkdir -- "$path" 2>/dev/null; then
			# Another launcher may have created the shared path after our check.
			[[ -d $path && ! -L $path ]] || die "cannot create GPU temperature state path: $path"
		fi
		[[ -d $path && ! -L $path ]] || die "GPU temperature state path is unsafe: $path"
		chmod 0700 -- "$path" || die "cannot secure GPU temperature state path: $path"
		details=$(stat -c '%u:%a' -- "$path") || die "cannot inspect GPU temperature state path: $path"
		[[ $details == "$(id -u):700" ]] || die "unsafe GPU temperature state ownership or mode: $path"
	done
}

try_reserve_local_port() {
	local candidate=$1 candidate_fd listeners lock_path lock_status
	lock_path="$port_lock_dir/$candidate.lock"
	if [[ -e $lock_path || -L $lock_path ]]; then
		[[ -f $lock_path && ! -L $lock_path && $(stat -c '%u:%h' -- "$lock_path") == "$(id -u):1" ]] ||
			die "local port lock file is unsafe: $lock_path"
	fi
	exec {candidate_fd}>>"$lock_path" || die "cannot open local port lock: $lock_path"
	chmod 0600 -- "$lock_path" || {
		exec {candidate_fd}>&-
		die "cannot secure local port lock: $lock_path"
	}
	[[ -f $lock_path && ! -L $lock_path && $(stat -c '%u:%h' -- "$lock_path") == "$(id -u):1" ]] || {
		exec {candidate_fd}>&-
		die "local port lock changed while opening: $lock_path"
	}
	if flock -n "$candidate_fd"; then
		:
	else
		lock_status=$?
		exec {candidate_fd}>&-
		((lock_status == 1)) && return 1
		die "cannot lock local TCP port $candidate"
	fi
	listeners=$(ss -H -ltn "sport = :$candidate") || {
		exec {candidate_fd}>&-
		die "cannot inspect local TCP port $candidate"
	}
	if [[ -n $listeners ]]; then
		exec {candidate_fd}>&-
		return 2
	fi
	local_port=$candidate
	local_port_lock_fd=$candidate_fd
}

reserve_local_port() {
	local candidate result
	if ((local_port_explicit)); then
		if try_reserve_local_port "$local_port"; then
			local_port_selection=explicit
			return
		else
			result=$?
		fi
		if ((result == 1)); then
			die "local TCP port $local_port is reserved by another Radiance launcher"
		fi
		die "local TCP port $local_port is already listening"
	fi

	for ((candidate = AUTO_LOCAL_PORT_FIRST; candidate <= AUTO_LOCAL_PORT_LAST; candidate++)); do
		if try_reserve_local_port "$candidate"; then
			local_port_selection=automatic
			return
		fi
	done
	die "no local TCP port is available in $AUTO_LOCAL_PORT_FIRST..$AUTO_LOCAL_PORT_LAST"
}

resolve_project_session_args() {
	local index selector replacement
	for ((index = 0; index < ${#pi_args[@]}; index++)); do
		case ${pi_args[index]} in
		--session)
			((index + 1 < ${#pi_args[@]})) || die '--session requires a value'
			selector=${pi_args[index + 1]}
			[[ $selector == /* ]] || {
				replacement=$("$history_program" resolve --cwd "$project_cwd" "$selector") ||
					die "cannot resolve project session: $selector"
				pi_args[index + 1]=$replacement
			}
			index=$((index + 1))
			;;
		--session=*)
			selector=${pi_args[index]#--session=}
			[[ $selector == /* ]] || {
				replacement=$("$history_program" resolve --cwd "$project_cwd" "$selector") ||
					die "cannot resolve project session: $selector"
				pi_args[index]="--session=$replacement"
			}
			;;
		esac
	done
}

project_root=$(cd "$(dirname "${launcher_original_script:-${BASH_SOURCE[0]}}")/.." && pwd)
project_cwd=$(pwd -P)
readonly project_cwd
readonly state_root="$HOME/.local/state/qwen-r9700/pi-remote/radiance-public-clean-candidate"
readonly port_lock_dir="$state_root/port-locks"
