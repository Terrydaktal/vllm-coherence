		api_pid=$(ps -eo pid=,args= | awk '/[v]llm serve/ && /Qwen3.8-27B-int4-AutoRound/ && /--port 8000/ {print $1; exit}')
		[[ $api_pid =~ ^[1-9][0-9]*$ && -r /proc/$api_pid/environ ]] ||
			die 'cannot identify the reused coding-turbo-quest96 API process'
		api_env=$(tr '\0' '\n' <"/proc/$api_pid/environ")
