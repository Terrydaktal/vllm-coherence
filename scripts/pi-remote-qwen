usage() {
	cat <<'EOF'
NAME
    pi-remote-qwen - run Pi locally against the Qwen backend on ai

	SYNOPSIS
	    pi-remote-qwen [OPTIONS] [-- PI_OPTIONS...]
	    pi-remote-qwen --model {vanilla|radiance-uncensored|hauhau-delta} [OPTIONS] [-- PI_OPTIONS...]
    pi-remote-qwen --live62 [OPTIONS] --session SESSION [PI_OPTIONS...]
    pi-remote-qwen --help

DESCRIPTION
    Installs and verifies Pi 0.84.2, merges the qwen-r9700 provider into the
    local Pi configuration, starts the selected validated Frozenlock backend
    on lewis@ai, opens a localhost-only SSH tunnel, waits for the OpenAI API,
    and launches Pi in the foreground. Ctrl-C stops Pi and both supervisor
	    processes.

	    --model vanilla selects the existing Frozenlock/live62 family. --model
	    radiance-uncensored selects the snapshot-qualified public MXFP4/W4A8
	    Radiance lane. --model hauhau-delta selects the independently
	    reconstructed HauhauCS weight delta, quantized directly into symmetric
	    AutoRound W4A16 and isolated on that same live62 stack. A Pi JSONL transcript can be resumed with any
	    model, but model-specific KV state is never shared. Switching models
	    requires leaving Pi and relaunching this command with the other selection.

    The default is the quality-gated turbo32 MTP3 lane. The agent262 profile
    is available only through the explicit --experimental-262k switch and
    uses the DFlash2 parallel-drafting lane by default. DFlash2 is the only
    current proposal path with measured acceptance at bounded long context;
    the custom Bole tree proposer remains an explicit compatibility control.
		The separately named live47 profile attaches to the separately launched,
	prefix-caching 262K full DFlash lane. Ordinary attachment remains read-only:
	with --reuse-existing it attaches read-only, and the remote process must
	advertise the authenticated accepted-path tuple (DFlash, FP8 KV, mamba none,
	Quest96, B7 graph, and the qualified KV arena). Without --reuse-existing it
	starts that same tuple when port 8000 is free. The old target-only process is
	not a live47 backend.
	--snapshot-resume is the authenticated live47 fixed-slot snapshot
	sub-mode on the pre-UNIQUE Quest96/D7 lane. The snapshot supplies
	the authenticated prefix while the accepted DFlash decoder supplies the
	response. Supplying --session with --profile live47 or live47-dense selects
	this sub-mode automatically. With --reuse-existing it attaches only to an already
	matching accepted-path backend. Without --reuse-existing it owns the live47
	transition: if port 8000 is occupied, it stops only one process that passes
	the exact live47 identity checks, refuses to touch any unrelated service,
		and starts the accepted-path backend.
	The live47-dense profile is a separate authenticated live47 derivative. It
	retains the same pre-UNIQUE Quest96/D7 decoder and fixed-slot checkpoint ABI,
	but enables only the promoted dynamic dense-CK suffix-prefill implementation
	and its post-capture warmup. It never changes the ordinary live47 profile.
	--live62 is the public mode for the current optimized exact lane. By default it
	reuses an already-running authenticated live62 backend, or starts the exact
	sealed backend when port 8000 is absent. Supplying --reuse-existing makes that
	an attach-only requirement. It implies the authenticated dense-CK resume
	contract and additionally requires the sealed live62 command, compatibility
	site, dynamic dense-CK shadow, and validator identities. It never starts a
	generic live47 backend under the live62 name.
	    The client authenticates the selected branch-head manifest and validates
	    its exact P-token outgoing prefix before submitting a provider request. A
	    match restores the head's replay-safe R-token prefix and computes only its
	    suffix. The public default remains P=60,298/R=60,288; authenticated private
	    staged heads may be larger. A mismatch
	    aborts Pi before generation; snapshot mode never silently cold-fills.
	    Ordinary live62 turns restore the pinned replay boundary without publishing
	    a new cache head. Only the explicit staged checkpoint transaction publishes.
    The separately named coding-turbo-quest96 profile selects that 262K DFlash
    stack with Quest96, the stock Qwen thinking sampler (1.0/0.95/40), and a
    server-side 64-token provisional holdback. Normal launch remains locked
    until its backend parity and independent AA >=51 promotion record passes.
    The separately named unique profile attaches to a prevalidated 262K
    DFlash/B7/UNIQUE backend. It is attachment-only until a fresh end-to-end
    UNIQUE quality and throughput qualification is promoted; it refuses to
    start a target-only or generic agent262 process.
    The agent262 lane combines Native-B WMMA linears, compiled FP8 Quest
    attention, and RDNA fused GDN. Its qualified live ceiling is 253,792
    tokens, leaving generation headroom above an occupied 249,957-token prefix.

	OPTIONS
	    --model MODEL
		        vanilla, radiance-uncensored, or hauhau-delta. The former Philbert and original Hauhau
		        aggressive lanes are retired and are no longer selectable. Default:
	        vanilla. For an existing live62-managed chat, retain --live62 so its
	        atomic active-chat pointer is resolved before launching Hauhau-delta.

	    --remote HOST
        SSH destination. Default: lewis@ai.

    --remote-project PATH
        Remote qwen-r9700 project. Default: /home/lewis/projects/qwen-r9700.

	    --profile PROFILE
	        turbo32, fast64, normal128, agent262, live47, live47-dense, unique, or
        coding-turbo-quest96.
        Default: turbo32.

    --lane LANE
        target, mtp3, mtp15, tree, or dflash for control profiles. The
        agent262 Pi lane defaults to dflash and requires --experimental-262k.

    --thinking MODE
        Pi thinking mode: off, low, medium, or xhigh. Default: xhigh.

    --experimental-262k
        Opt into the compiled agent262 DFlash2 lane with FP8 E4M3 KV and the
        launcher's qualification-run. This is not a quality-passed production
        profile; it is fail-closed rather than silently falling back.
        The explicit coding-turbo-quest96 profile implies this opt-in.

    coding-turbo-quest96 promotion
        A non-dry-run launch requires the immutable self-hashed record at
        results/coding-turbo-quest96/promotion.json. The record must prove
        component parity, both lifecycle contexts, zero containment leakage,
        visible >=70 t/s, and an independent Artificial Analysis score >=51.

	    --local-port PORT
	        Require this exact local tunnel/API port. Vanilla and Hauhau default
	        to 8000. Radiance automatically reserves the first available port in
	        8012..8099 when this option is omitted.

    --no-install
        Do not install Pi; require the verified ~/.local/bin/pi already exists.

	    --reuse-existing
	        Do not start or stop a remote backend. Attach to the already-running
        localhost:8000 backend after checking its health/model API. For the
        agent262 dflash lane, the existing process must advertise the DFlash
        speculative configuration; stale target/tree servers are rejected.
        The unique profile additionally requires B7, UNIQUE depth-mixed,
        Quest96, and authenticated fixed-slot controls in the backend
	        environment. Only the SSH tunnel is cleaned up on exit.

	    --fresh-state
	        For aggressive, Philbert, and Hauhau-delta models, disable fixed-slot
	        snapshot restore and publication and reconstruct every request from the
	        Pi transcript. Use this fail-safe until snapshot equivalence is certified.

	    --live62
		Select the exact live62 backend. By default, reuse an already-running
		authenticated live62 backend or start the sealed backend when remote port
		8000 is absent. An occupied incompatible or ambiguous backend is rejected.
		Adding --reuse-existing changes this to a strict attach-only requirement.
		Supplying a --session enables authenticated snapshot resume automatically.
		A generic live47 or live47-dense process is rejected.

	    --snapshot-resume
		Enable authenticated fixed-slot snapshot resume for --profile live47 or
		live47-dense. Supplying --session with either profile enables this mode
        automatically, so a resumed live47 chat cannot silently cold-fill.
	    It requires exactly one --session transcript containing the selected
	        authenticated branch head. The wrapper authenticates its immutable
	        manifest, then the Pi extension tokenizes each outgoing request and
	        validates the exact P-token prefix before generation. A match restores
	        that head's replay-safe R-token prefix and computes only the suffix. The
	        public default is P=60,298/R=60,288; private staged heads may be larger.
	        A mismatch,
	        missing manifest, branch edit, or incompatible selection aborts Pi;
	        explicit snapshot mode never falls back to a full prompt computation.
        With --reuse-existing it attaches only to a matching live47 accepted
        DFlash backend; without it, the wrapper stops one exact live47-compatible
        backend (if present), refuses unrelated port occupants, and starts the
        accepted-path snapshot backend. Snapshot mode retains DFlash proposals,
        B7, and accepted replay; it does not enable UNIQUE.
	        For a resumed Pi transcript, the wrapper derives pi-<session UUID>
	        and authenticates that remote branch head automatically. This avoids
	        accidentally comparing a private chat with the public fixture. Supply
	        all three contract options below only for an explicit override.

	--snapshot-bootstrap
	    Create the missing session-specific snapshot from Pi's complete exact
	    outgoing prompt as a restartable sequence of authenticated checkpoints.
	    Pi exports token IDs only and stops before its original provider request;
	    the staged controller advances from 8,258 tokens in 8,240-token steps and
	    accepts a stage only after the independently verified, drained branch head
	    commits. Re-running the same command reuses the immutable token export,
	    plan, transaction-pinned controller, and committed-stage journal, so
	    interruption can lose at most the current bounded stage rather than the
	    complete cold fill. Repository relocation or a later controller upgrade
	    cannot reinterpret an existing transaction. It never stores
	    transcript text. It requires --live62 so every fill uses the exact
	    all-69-qualified checkpoint foundation. Pass a distinct
	    --snapshot-session-id.

	--snapshot-derived-manifest PATH
	    During an explicit bootstrap migration, authenticate PATH as the
	    create-only structured-outcome migration manifest for the supplied Pi
	    session. That record binds the sanitizer, authorization, tool archive,
	    exact migration plan, and outcome prompt ABI.

	    --snapshot-session-id ID
	        Explicit fixed-slot cache session identity. When resuming a Pi
	        transcript, the default is pi-<session UUID> discovered from its
	        filename. Must be supplied together with --snapshot-branch and
	        --snapshot-manifest-sha256 when overriding automatic selection.

	    --snapshot-prompt-abi ABI
	        Select the model-visible Pi tool contract independently of the backend
	        lane. ABI is base-v1, searchtool-v1, searchtool-toolarchive-v1, or
	        searchtool-toolarchive-outcome-v1.
	        The toolarchive ABI adds authenticated live/historical rehydration.
	        The outcome ABI additionally requires every successful model response
	        to select either a real tool or the grammar-constrained final-answer
	        outcome. It prevents a prose/EOS stop from silently omitting a tool call.
	        Snapshot Pi processes disable
	        mutable extension discovery and load only the extensions named by this
	        contract. live62 defaults to searchtool-v1; other profiles default to
	        base-v1. A changed ABI selects a distinct snapshot namespace and needs
	        one explicit bootstrap/rebuild instead of attempting an incompatible
	        cache and killing the backend.

    --snapshot-branch NAME
        Fixed-slot cache branch. Default: main.

	    --snapshot-manifest-sha256 SHA256
	        Lowercase SHA-256 of an explicitly selected fixed-slot manifest. In
	        automatic mode, the authenticated branch head supplies this value.

	    --qualification-snapshot-auth-root PATH
	        Read snapshot metadata from an isolated remote qualification root
	        instead of the production cache root. PATH must be an absolute real
	        directory below REMOTE_PROJECT/artifacts/qualifications. This changes
	        only client-side manifest authentication; the attached backend keeps
	        its separately qualified cache and selection roots. Available only
	        for non-bootstrap live47 snapshot qualification.

	    --dry-run
	        Print the plan and validate local arguments without changing files or
	        contacting SSH, starting a tunnel, or starting a backend.

	    --preflight-only
	        For an aggressive, Philbert, or Hauhau model, authenticate and
	        initialize every remote startup prerequisite, then exit without
	        loading the model or touching the GPU. This remains a launcher safety
	        operation even when written after --session PATH.

    --require-fast-path
        Pass the qualification fail-closed mode to the remote agent262
        launcher. The backend refuses to start if Native-B, compiled Quest/
        direct attention, or fused RDNA GDN is unavailable; it never silently
        benchmarks a Triton/SDPA fallback.

    --qualification-greedy-sampling
        Explicitly select the accepted DFlash tuple temperature=0, top_p=1,
	        and top_k=1 for the agent262/live47/live47-dense speed lanes. This is already their
        default and remains a fail-closed qualification assertion. It
        changes only static samplingParams; --thinking xhigh, reasoning replay,
		chat-template arguments, and tool behavior are retained. Live47 disables
		the server holdback so the snapshot-bound server source remains unchanged;
		the Pi repetition guard still provides one bounded stochastic retry.
        Equivalent environment switch: QWEN_PI_QUALIFICATION_GREEDY=1. Set it
        to 0 to select the tracked stochastic control explicitly. The only
        accepted environment values are exactly 0 and 1.

    --session SESSION, --session=SESSION
        Resume a Pi session from the current development folder. `last` selects
        its newest session; a UUID, UUID prefix, or absolute path is also accepted.
        This flag and subsequent Pi options are forwarded to Pi; the literal `--`
        separator remains supported for other options.

    -h, --help
        Show this help text and exit.

OPERATION
    Pi is installed with scripts/install-pi-coding-agent and configured with
    scripts/deploy-pi-models-config. The provider base URL and context window
    are adjusted atomically for the selected local port/profile. The remote
    launcher is supervised over SSH, and a separate SSH forward maps
    LOCAL_PORT to 127.0.0.1:8000 on the remote host.

	EXAMPLES
	    scripts/pi-remote-qwen
	    scripts/pi-remote-qwen --model radiance-uncensored --no-install \
	        --local-port 8012 --thinking xhigh
	    scripts/pi-remote-qwen --model hauhau-delta --no-install --thinking xhigh
	    scripts/pi-remote-qwen --model hauhau-delta --live62 --no-install \
	        --local-port 8011 --thinking xhigh --session /path/to/pi-session.jsonl
    scripts/pi-remote-qwen --profile fast64 --thinking medium
    scripts/pi-remote-qwen --profile agent262 --experimental-262k --thinking xhigh
    scripts/pi-remote-qwen --profile live47 --reuse-existing --thinking xhigh
    scripts/pi-remote-qwen --profile live47 --snapshot-resume \
        --thinking xhigh --session /path/to/pi-session.jsonl
	    scripts/pi-remote-qwen --profile live47 --snapshot-resume --reuse-existing \
	        --thinking xhigh --session /path/to/pi-session.jsonl
	    scripts/pi-remote-qwen --profile live47-dense --snapshot-resume \
	        --thinking xhigh --session /path/to/pi-session.jsonl
	    scripts/pi-remote-qwen --live62 --thinking xhigh \
	        --session /path/to/pi-session.jsonl
	    scripts/pi-remote-qwen --live62 --snapshot-prompt-abi base-v1 \
	        --thinking xhigh --session /path/to/pi-session.jsonl
    scripts/pi-remote-qwen --profile coding-turbo-quest96 --thinking xhigh
    scripts/pi-remote-qwen --profile unique --reuse-existing --thinking xhigh
    scripts/pi-remote-qwen --profile agent262 --experimental-262k --thinking xhigh \
        --qualification-greedy-sampling --reuse-existing
    scripts/pi-remote-qwen --profile agent262 --experimental-262k --lane tree --thinking xhigh
    scripts/pi-remote-qwen --lane target --thinking off
    scripts/pi-remote-qwen --dry-run --no-install

	FILES
	    integrations/pi/models-hauhau-delta-aggressive.json
	        Isolated Pi provider/model contract for the reconstructed Hauhau backend.
	    scripts/pi-remote-qwen-aggressive
	        Authenticated aggressive-model switch, tunnel, and Pi supervisor.
	    scripts/pi-remote-qwen-radiance
	        Authenticated public Radiance backend, snapshot, tunnel, and Pi supervisor.
	    integrations/pi/models.json
        Tracked provider/model contract used for the local Pi configuration.
    integrations/pi/qwen-progress.mjs
        TUI-only phase/elapsed progress for long prefix prefill and reasoning.
	integrations/pi/qwen-tool-output-condense.mjs
		Retains large tool output outside model context and supplies a bounded
		head/tail/error summary plus focused-command guidance.
	integrations/pi/qwen-tool-turn-rehydrate.mjs
		Authenticates a compacted session's content-addressed tool-turn archive
		and exposes only bounded line or literal-match rehydration by SHA-256.
	integrations/pi/qwen-repetition-guard.mjs
		Server repetition detection and one bounded corrective stochastic recovery attempt.
	integrations/pi/qwen-tool-call-integrity.mjs
		Rejects incomplete streamed JSON and invalid shell syntax before a tool can execute.
	integrations/pi/qwen-structured-outcome.mjs
		Validates structured calls and preserves complete ordinary final answers for the outcome ABI.
	integrations/pi/qwen-fixed-slot-resume.mjs
	    Explicit fixed-slot resume contract injection; loaded only by
	    --snapshot-resume and never enabled for ordinary live47 attachment.
	scripts/qwen-snapshot-stage-controller
	    Authenticated staged-fill planner, commit verifier, and restart journal.
	scripts/qwen-snapshot-verify
	    Independent manifest and payload authenticator streamed to the remote host
	    through a transaction-pinned private adapter.
    scripts/install-pi-coding-agent
        Rootless, pinned Pi installer.
    scripts/deploy-pi-models-config
        Atomic, non-clobbering provider deployment.
	~/.local/state/qwen-r9700/pi-remote/
	    Tunnel, backend, and supervisor logs.
	~/.local/state/qwen-r9700/pi-remote/snapshot-bootstrap-v5/
	    Protected per-ABI/session/branch token exports, immutable plans, exact
	    controller/verifier program pins, and create-only committed-stage journals.

PATHS
    Pi runtime: ~/.local/share/qwen-r9700/pi/0.84.2
    Pi command: ~/.local/bin/pi (symbolic link)
    Local API: http://127.0.0.1:LOCAL_PORT/v1
	Remote API: http://127.0.0.1:8000/v1 on ai
	Staged transaction: ~/.local/state/qwen-r9700/pi-remote/
	    snapshot-bootstrap-v5/PROMPT_ABI/SESSION/BRANCH

SECURITY NOTES
	The backend is never exposed beyond remote loopback. The SSH tunnel binds
	to local loopback only. Logs and exported token IDs are mode 0600; transaction
	directories are mode 0700. Token exports contain IDs, not transcript text.
	Plans, controller/verifier program pins, and commit receipts are create-only and
	authenticated before reuse. No credentials are written.

EXIT STATUS
	0 when Pi exits successfully or the complete staged snapshot is independently
	authenticated; 75 when a valid staged transaction has not committed its current
	stage yet and the same command can resume it; 2 for validation/startup/
	configuration failure; Pi's exit status otherwise.

AUTHORS
    Qwen R9700 inference lab maintainers.
EOF
}

die() {
	printf 'pi-remote-qwen: %s\n' "$*" >&2
	exit 2
}

require_command() {
	command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

is_port() {
	[[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535))
}

profile_context() {
	case $1 in
	turbo32) printf '32768' ;;
	fast64) printf '65536' ;;
	normal128) printf '131072' ;;
	agent262) printf '253792' ;;
	live47) printf '253792' ;;
	live47-dense) printf '253792' ;;
	unique) printf '253792' ;;
	coding-turbo-quest96) printf '253792' ;;
	*) return 1 ;;
	esac
}

script_path=${launcher_original_script:-${BASH_SOURCE[0]:-$0}}
while [[ -L $script_path ]]; do
	script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)
	script_path=$(readlink -- "$script_path")
	[[ $script_path == /* ]] || script_path="$script_dir/$script_path"
done
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd -P)
project_root=$(cd -- "$script_dir/.." && pwd -P)
readonly SNAPSHOT_VERIFY_SCRIPT="$project_root/scripts/qwen-snapshot-verify"
readonly SNAPSHOT_STAGE_CONTROLLER="$project_root/scripts/qwen-snapshot-stage-controller"
readonly SNAPSHOT_HEAD_ADVANCE="$project_root/scripts/qwen-snapshot-head-advance"
readonly ACTIVE_CHAT_POINTER_PROGRAM="$project_root/scripts/qwen-active-chat-pointer"
readonly COMPACTION_SUPERVISOR_PROGRAM="$project_root/scripts/qwen-live62-compaction-supervisor"
readonly COMPACTION_TRANSACTION_PROGRAM="$project_root/scripts/qwen-compaction-snapshot-transaction"
readonly SNAPSHOT_BACKGROUND_PUBLISHER="$project_root/scripts/qwen-snapshot-background-publisher"
readonly ACTIVE_CHAT_POINTER_SHA256='69bf9cfb55d92db281aa4d8acc9cd1c9de76f15e228d6ddc7f4199e86afc46e2'
: "${HOME:?HOME must be set}"

remote_host=$DEFAULT_REMOTE
remote_project=$DEFAULT_REMOTE_PROJECT
model_choice=$DEFAULT_MODEL_CHOICE
profile=$DEFAULT_PROFILE
profile_explicit=0
live62_requested=0
lane=$DEFAULT_LANE
lane_explicit=0
thinking=$DEFAULT_THINKING
local_port=$DEFAULT_LOCAL_PORT
local_port_explicit=0
no_install=0
dry_run=0
preflight_only=0
require_fast_path=0
experimental_262k=0
reuse_existing=0
reuse_existing_explicit=0
fresh_state=0
live62_auto_backend=0
snapshot_resume=0
snapshot_capture=0
session_arg_present=0
snapshot_session_id=$DEFAULT_SNAPSHOT_SESSION_ID
snapshot_branch=$DEFAULT_SNAPSHOT_BRANCH
snapshot_manifest_sha256=$DEFAULT_SNAPSHOT_MANIFEST_SHA256
snapshot_session_explicit=0
snapshot_branch_explicit=0
snapshot_manifest_explicit=0
snapshot_contract_auto=0
snapshot_active_pointer=0
snapshot_prompt_abi=$BASE_PROMPT_ABI
snapshot_prompt_abi_explicit=0
snapshot_derived_manifest=''
snapshot_derived_manifest_explicit=0
snapshot_auth_root=$REMOTE_FIXED_SLOT_CACHE_ROOT
qualification_snapshot_auth_root_explicit=0
qualification_greedy_sampling=0
qualification_greedy_explicit=0
if [[ -v QWEN_PI_QUALIFICATION_GREEDY ]]; then
	case $QWEN_PI_QUALIFICATION_GREEDY in
	0 | 1) ;;
	*) die 'QWEN_PI_QUALIFICATION_GREEDY must be exactly 0 or 1' ;;
	esac
	qualification_greedy_sampling=$QWEN_PI_QUALIFICATION_GREEDY
	qualification_greedy_explicit=1
fi
declare -a pi_extra_args=()

# --session begins Pi's verbatim argument tail, but --dry-run and
# --preflight-only are launcher safety operations even when an operator appends
# either after the session path. Detect them before parsing (and stop at an
# explicit `--` Pi boundary) so they cannot accidentally reach Pi and start a
# backend.
for launcher_argument in "$@"; do
	[[ $launcher_argument != -- ]] || break
	case $launcher_argument in
	--dry-run) dry_run=1 ;;
	--preflight-only) preflight_only=1 ;;
	esac
done

while (($# > 0)); do
	case $1 in
	--model)
		(($# >= 2)) || die '--model requires a value'
		case $2 in
		vanilla) model_choice=vanilla ;;
		radiance | radiance-uncensored | public-uncensored) model_choice=radiance-uncensored ;;
		hauhau-delta | hauhau-autoround | hauhau-fast) model_choice=hauhau-delta ;;
		aggressive | unrestricted | hauhau | philbert | philbert-aggressive)
			die "model $2 is retired; use vanilla, radiance-uncensored, or hauhau-delta"
			;;
		*) die "unsupported model: $2 (use vanilla, radiance-uncensored, or hauhau-delta)" ;;
		esac
		shift 2
		;;
	--remote)
		(($# >= 2)) || die '--remote requires a value'
		remote_host=$2
		shift 2
		;;
	--remote-project)
		(($# >= 2)) || die '--remote-project requires a value'
		remote_project=$2
		shift 2
		;;
	--profile)
		(($# >= 2)) || die '--profile requires a value'
		profile=$2
		profile_explicit=1
		shift 2
		;;
	--live62)
		live62_requested=1
		shift
		;;
	--lane)
		(($# >= 2)) || die '--lane requires a value'
		lane=$2
		lane_explicit=1
		shift 2
		;;
	--thinking)
		(($# >= 2)) || die '--thinking requires a value'
		thinking=$2
		shift 2
		;;
	--local-port)
		(($# >= 2)) || die '--local-port requires a value'
		local_port=$2
		local_port_explicit=1
		shift 2
		;;
	--no-install)
		no_install=1
		shift
		;;
	--reuse-existing)
		reuse_existing=1
		reuse_existing_explicit=1
		shift
		;;
	--fresh-state)
		fresh_state=1
		shift
		;;
	--snapshot-resume)
		snapshot_resume=1
		shift
		;;
	--snapshot-bootstrap)
		snapshot_resume=1
		snapshot_capture=1
		shift
		;;
	--snapshot-session-id)
		(($# >= 2)) || die '--snapshot-session-id requires a value'
		snapshot_session_id=$2
		snapshot_session_explicit=1
		shift 2
		;;
	--snapshot-branch)
		(($# >= 2)) || die '--snapshot-branch requires a value'
		snapshot_branch=$2
		snapshot_branch_explicit=1
		shift 2
		;;
	--snapshot-manifest-sha256)
		(($# >= 2)) || die '--snapshot-manifest-sha256 requires a value'
		snapshot_manifest_sha256=$2
		snapshot_manifest_explicit=1
		shift 2
		;;
	--snapshot-prompt-abi)
		(($# >= 2)) || die '--snapshot-prompt-abi requires a value'
		snapshot_prompt_abi=$2
		snapshot_prompt_abi_explicit=1
		shift 2
		;;
	--snapshot-derived-manifest)
		(($# >= 2)) || die '--snapshot-derived-manifest requires a value'
		snapshot_derived_manifest=$2
		snapshot_derived_manifest_explicit=1
		shift 2
		;;
	--qualification-snapshot-auth-root)
		(($# >= 2)) || die '--qualification-snapshot-auth-root requires a value'
		((qualification_snapshot_auth_root_explicit == 0)) ||
			die '--qualification-snapshot-auth-root may be supplied only once'
		snapshot_auth_root=$2
		qualification_snapshot_auth_root_explicit=1
		shift 2
		;;
	--dry-run)
		dry_run=1
		shift
		;;
	--preflight-only)
		preflight_only=1
		shift
		;;
	--require-fast-path)
		require_fast_path=1
		shift
		;;
	--qualification-greedy-sampling)
		qualification_greedy_sampling=1
		qualification_greedy_explicit=1
		shift
		;;
	--experimental-262k)
		experimental_262k=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		pi_extra_args=("$@")
		break
		;;
	--session | --session=*)
		# Pi's resume flag is common enough to accept directly. Preserve the
		# remainder verbatim so the session id and later Pi options reach Pi.
		session_arg_present=1
		pi_extra_args=("$@")
		break
		;;
	*)
		die "unknown launcher option: $1 (pass other Pi options after --)"
		;;
	esac
done

if [[ $model_choice == hauhau-delta || $model_choice == radiance-uncensored ]]; then
	((profile_explicit == 0)) || die "--model $model_choice cannot be combined with --profile"
	((lane_explicit == 0)) || die "--model $model_choice cannot be combined with --lane"
	((live62_requested == 0)) || die "--model $model_choice cannot be combined with --live62"
	((snapshot_capture == 0)) || die "--model $model_choice cannot be combined with --snapshot-bootstrap"
	((experimental_262k == 0)) || die "--model $model_choice cannot be combined with --experimental-262k"
	((require_fast_path == 0)) || die "--model $model_choice cannot be combined with --require-fast-path"
	((qualification_snapshot_auth_root_explicit == 0)) ||
		die "--model $model_choice cannot use a qualification snapshot root"
	((qualification_greedy_explicit == 0)) ||
		die "--model $model_choice uses its pinned sampling contract"
	if [[ $model_choice == radiance-uncensored ]]; then
		((fresh_state == 0)) || die '--fresh-state is only valid with the hauhau-delta model'
	fi
elif ((fresh_state == 1)); then
	die '--fresh-state is only valid with the hauhau-delta model'
fi

if ((live62_requested == 1)); then
	((profile_explicit == 0)) || die '--live62 cannot be combined with --profile'
	profile=live47-dense
	if ((snapshot_capture == 0)); then
		reuse_existing=1
		((reuse_existing_explicit == 1)) || live62_auto_backend=1
	fi
	if ((snapshot_prompt_abi_explicit == 0)); then
		snapshot_prompt_abi=$SEARCHTOOL_PROMPT_ABI
	fi
fi
public_profile=$profile
((live62_requested == 1)) && public_profile=live62

# A live47 invocation carrying a Pi session is a resume operation, not an
# opt-in cold prefill. Select the authenticated snapshot sub-mode before the
# profile/lane contract is derived. The explicit flag remains accepted for
# callers that prefer to state the mode themselves.
if [[ ($profile == live47 || $profile == live47-dense) && $session_arg_present == 1 && $snapshot_resume == 0 ]]; then
	snapshot_resume=1
	if ((live62_requested == 1)); then
		printf 'live62 session detected; enabling authenticated snapshot resume\n' >&2
	elif [[ $profile == live47 ]]; then
		printf 'live47 session detected; enabling authenticated snapshot resume\n' >&2
	else
		printf 'live47-dense session detected; enabling authenticated snapshot resume\n' >&2
	fi
fi

snapshot_override_count=$((snapshot_session_explicit + snapshot_branch_explicit + snapshot_manifest_explicit))
if ((snapshot_capture == 1)); then
	((snapshot_session_explicit == 1)) ||
		die '--snapshot-bootstrap requires an explicit --snapshot-session-id'
	((snapshot_branch_explicit == 0 && snapshot_manifest_explicit == 0)) ||
		die '--snapshot-bootstrap accepts only --snapshot-session-id; it creates the default main branch and manifest'
elif ((snapshot_override_count != 0 && snapshot_override_count != 3)); then
	die 'override snapshot selection with all three --snapshot-session-id, --snapshot-branch, and --snapshot-manifest-sha256 options'
fi
if ((snapshot_derived_manifest_explicit == 1)); then
	((snapshot_capture == 1)) || die '--snapshot-derived-manifest is available only with --snapshot-bootstrap'
	[[ $snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]] ||
		die '--snapshot-derived-manifest requires searchtool-toolarchive-outcome-v1'
	[[ $snapshot_derived_manifest == /* ]] ||
		die 'snapshot migration paths must be absolute'
fi
if ((snapshot_resume == 1 && snapshot_capture == 0 && session_arg_present == 1 && snapshot_override_count == 0)); then
	snapshot_contract_auto=1
fi

if ((qualification_snapshot_auth_root_explicit == 1)); then
	[[ ($profile == live47 || $profile == live47-dense) && $snapshot_resume == 1 && $snapshot_capture == 0 ]] ||
		die '--qualification-snapshot-auth-root requires non-bootstrap live47/live47-dense snapshot resume'
	[[ $snapshot_auth_root =~ ^/[A-Za-z0-9._/-]+$ ]] ||
		die 'qualification snapshot auth root contains unsafe path characters'
	case $snapshot_auth_root in
	"$remote_project"/artifacts/qualifications/*) ;;
	*) die 'qualification snapshot auth root must be below the remote project qualification root' ;;
	esac
fi

case $profile in
turbo32 | fast64 | normal128 | agent262 | live47 | live47-dense | unique | coding-turbo-quest96) ;;
*) die "unsupported profile: $profile (use turbo32, fast64, normal128, agent262, live47, live47-dense, unique, or coding-turbo-quest96)" ;;
esac
case $lane in
target | mtp3 | mtp15 | tree | dflash) ;;
*) die "unsupported lane: $lane (use target, mtp3, mtp15, tree, or dflash)" ;;
esac
case $snapshot_prompt_abi in
"$BASE_PROMPT_ABI" | "$SEARCHTOOL_PROMPT_ABI" | "$TOOL_ARCHIVE_PROMPT_ABI" | "$OUTCOME_PROMPT_ABI") ;;
*)
	die "unsupported snapshot prompt ABI: $snapshot_prompt_abi (use $BASE_PROMPT_ABI, $SEARCHTOOL_PROMPT_ABI, $TOOL_ARCHIVE_PROMPT_ABI, or $OUTCOME_PROMPT_ABI)"
	;;
esac
if [[ ($profile == agent262 || $profile == coding-turbo-quest96) && $lane_explicit == 0 ]]; then
	# The default must exercise the proposal path that has actually shown
	# acceptance: DFlash2 parallel drafting plus Native-B/Quest/RDNA GDN.
	# The custom Bole tree remains an explicit compatibility control because
	# its n-gram proposer accepted 0/80 drafts in the latest bounded smoke.
	lane=dflash
fi
if [[ $profile == unique && $lane_explicit == 0 ]]; then
	lane=dflash
fi
if ((snapshot_resume == 1)); then
	[[ $profile == live47 || $profile == live47-dense ]] ||
		die '--snapshot-resume is only valid with --profile live47 or live47-dense'
	[[ $lane_explicit == 0 || $lane == target ]] ||
		die '--snapshot-resume uses the authenticated DFlash lane; do not override --lane'
	lane=dflash
elif [[ ($profile == live47 || $profile == live47-dense) && $lane_explicit == 0 ]]; then
	# Normal live47 is the restored accepted-path lane. Snapshot resume uses the
	# same lane and adds only the authenticated fixed-slot request contract.
	lane=dflash
fi
if ((snapshot_capture == 1 && reuse_existing == 1)); then
	die '--snapshot-bootstrap must own a fresh backend; remove --reuse-existing'
fi
if ((snapshot_capture == 1 && live62_requested == 0)); then
	die '--snapshot-bootstrap requires --live62 so every fill uses the all-69-qualified checkpoint foundation'
fi
if ((snapshot_capture == 1)) && [[ $remote_host != "$DEFAULT_REMOTE" ]]; then
	die "--snapshot-bootstrap requires the pinned verifier host $DEFAULT_REMOTE"
fi
if [[ ($profile == live47 || $profile == live47-dense) && $snapshot_resume == 0 && $lane != dflash ]]; then
	die "$profile requires the full DFlash lane"
fi
if [[ $profile == unique && $reuse_existing == 0 ]]; then
	die 'unique is attachment-only until its fresh quality/throughput promotion; pass --reuse-existing to attach to a validated UNIQUE backend'
fi
if [[ ($lane == mtp3 || $lane == mtp15 || $lane == dflash) &&
	$profile != turbo32 && $profile != agent262 && $profile != live47 && $profile != live47-dense && $profile != unique && $profile != coding-turbo-quest96 &&
	$snapshot_resume == 0 ]]; then
	die "$lane is unavailable for profile: $profile"
fi
if [[ ($lane == mtp15 || $lane == dflash) && $profile != agent262 && $profile != live47 && $profile != live47-dense && $profile != unique &&
	$profile != coding-turbo-quest96 && $snapshot_resume == 0 ]]; then
	die "$lane is available only for agent262 or unique"
fi
coding_turbo_quest96=0
unique_lane=0
live47_fast_lane=0
dense_ck_lane=0
[[ $profile == live47-dense ]] && dense_ck_lane=1
backend_profile=$profile
if ((snapshot_resume == 1)); then
	# The fixed-slot cache ABI is implemented by the accepted-path DFlash
	# launcher. Snapshot resume is the same full lane with an authenticated
	# prefix contract; it must retain proposals, B7, and accepted replay.
	backend_profile=agent262
	experimental_262k=1
	require_fast_path=1
	live47_fast_lane=1
elif [[ $profile == coding-turbo-quest96 ]]; then
	coding_turbo_quest96=1
	backend_profile=agent262
	experimental_262k=1
	[[ $lane == dflash ]] || die 'coding-turbo-quest96 requires the DFlash lane'
	require_fast_path=1
elif [[ $profile == agent262 ]]; then
	((experimental_262k == 1)) || die 'agent262 requires --experimental-262k'
	[[ $lane == dflash ]] || die 'agent262 Pi lane defaults to DFlash2; use --lane tree only for an explicit compatibility control'
	# Never let the 262K Pi lane silently benchmark Triton/SDPA/GDN
	# fallbacks.  Use --require-fast-path explicitly only for other launcher
	# integrations; Pi's experimental lane is always a qualification lane.
	require_fast_path=1
elif [[ $profile == live47 || $profile == live47-dense ]]; then
	# live47 is the named compatibility handle for the previously qualified
	# accepted-path DFlash command.
	backend_profile=agent262
	experimental_262k=1
	require_fast_path=1
	live47_fast_lane=1
elif [[ $profile == unique ]]; then
	# UNIQUE is an explicit attachment lane.  It reuses the agent262 DFlash
	# backend identity, but the remote preflight additionally requires the
	# authenticated B7/UNIQUE environment before Pi is started.
	[[ $lane == dflash ]] || die 'unique requires the DFlash lane'
	unique_lane=1
	backend_profile=agent262
	experimental_262k=1
	require_fast_path=1
elif ((experimental_262k == 1)); then
	die '--experimental-262k requires --profile agent262'
fi
if ((require_fast_path == 1)); then
	[[ $profile == agent262 || $profile == live47 || $profile == live47-dense || $profile == unique || $profile == coding-turbo-quest96 || $snapshot_resume == 1 ]] ||
		die '--require-fast-path is only valid with --profile agent262, unique, live47/live47-dense snapshot, or coding-turbo-quest96'
	((experimental_262k == 1)) || die '--require-fast-path requires --experimental-262k'
fi
if ((coding_turbo_quest96 == 1)); then
	((qualification_greedy_sampling == 0)) ||
		die 'coding-turbo-quest96 requires stock stochastic sampling, not greedy'
	qualification_sampling_label='coding-turbo-quest96 stock sampled (1.0/0.95/40)'
elif ((qualification_greedy_explicit == 0)) &&
	[[ ($profile == agent262 || $profile == live47 || $profile == live47-dense) && $lane == dflash && $experimental_262k == 1 ]]; then
	# Both speed lanes use the measured greedy contract by default. live47 keeps
	# the snapshot-bound server preimage and disables its optional stream holdback;
	# the Pi guard still retries a detected periodic suffix once with the explicit
	# stochastic control.
	qualification_greedy_sampling=1
	if [[ $profile == live47 || $profile == live47-dense ]]; then
		qualification_sampling_label="$public_profile default greedy (0/1/1)"
	else
		qualification_sampling_label='agent262 default greedy (0/1/1)'
	fi
elif ((qualification_greedy_sampling == 1)); then
	qualification_sampling_label='explicit greedy (0/1/1)'
else
	qualification_sampling_label='tracked stochastic (1.0/0.95/40)'
fi
if ((qualification_greedy_sampling == 1)); then
	[[ ($profile == agent262 || $profile == live47 || $profile == live47-dense) && $lane == dflash && $experimental_262k == 1 ]] ||
		die '--qualification-greedy-sampling requires the experimental agent262/live47/live47-dense DFlash lane'
fi
if ((snapshot_resume == 1)); then
	[[ $snapshot_session_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] ||
		die '--snapshot-session-id must be 1..128 safe identifier characters'
	[[ $snapshot_branch =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] ||
		die '--snapshot-branch must be 1..128 safe identifier characters'
	if ((snapshot_capture == 0)); then
		[[ $snapshot_manifest_sha256 =~ ^[0-9a-f]{64}$ ]] ||
			die '--snapshot-manifest-sha256 must be 64 lowercase hexadecimal characters'
	fi
else
	[[ $snapshot_session_id == "$DEFAULT_SNAPSHOT_SESSION_ID" &&
		$snapshot_branch == "$DEFAULT_SNAPSHOT_BRANCH" &&
		$snapshot_manifest_sha256 == "$DEFAULT_SNAPSHOT_MANIFEST_SHA256" ]] ||
		die 'snapshot contract options require --snapshot-resume'
fi
case $thinking in
off | low | medium | xhigh) ;;
*) die "unsupported thinking mode: $thinking (use off, low, medium, or xhigh)" ;;
esac
is_port "$local_port" || die "local port must be an integer from 1024 to 65535: $local_port"
[[ $remote_project == /* ]] || die 'remote project must be an absolute path'

for command_name in chmod cmp cp curl env find head id jq mkdir mktemp mv node npm python3 readlink sha256sum ssh stat tail; do
	require_command "$command_name"
done
node -e '
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 19)) process.exit(1);
' || die 'Node.js 22.19.0 or newer is required'

pi_link="$HOME/.local/bin/pi"
install_script="$project_root/scripts/install-pi-coding-agent"
deploy_script="$project_root/scripts/deploy-pi-models-config"
progress_extension="$project_root/integrations/pi/qwen-progress.mjs"
tool_output_condense_extension="$project_root/integrations/pi/qwen-tool-output-condense.mjs"
latency_audit_extension="$project_root/integrations/pi/qwen-latency-audit.mjs"
tool_turn_rehydrate_extension="$project_root/integrations/pi/qwen-tool-turn-rehydrate.mjs"
compacted_history_query="$project_root/scripts/qwen-compacted-history-query"
history_program="$project_root/scripts/pi-session-history"
repetition_guard_extension="$project_root/integrations/pi/qwen-repetition-guard.mjs"
tool_call_integrity_extension="$project_root/integrations/pi/qwen-tool-call-integrity.mjs"
aggressive_launcher="$project_root/scripts/pi-remote-qwen-aggressive"
radiance_launcher="$project_root/scripts/pi-remote-qwen-radiance"
structured_outcome_extension="$project_root/integrations/pi/qwen-structured-outcome.mjs"
structured_outcome_probe="$project_root/scripts/qwen-structured-outcome-probe"
fixed_slot_resume_extension="$project_root/integrations/pi/qwen-fixed-slot-resume.mjs"
compaction_handoff_extension="$project_root/integrations/pi/qwen-transactional-compaction-handoff.mjs"
[[ -x $install_script && -x $deploy_script ]] || die 'Pi installer/deployer scripts are missing'
[[ -r $progress_extension ]] || die "Pi progress extension is missing: $progress_extension"
[[ -r $tool_output_condense_extension ]] ||
	die "Pi tool-output condensation extension is missing: $tool_output_condense_extension"
if [[ -v QWEN_PI_LATENCY_AUDIT_FILE && -n $QWEN_PI_LATENCY_AUDIT_FILE ]]; then
	[[ -r $latency_audit_extension ]] ||
		die "Pi latency-audit extension is missing: $latency_audit_extension"
fi
[[ -r $tool_turn_rehydrate_extension ]] ||
	die "Pi archived tool-turn rehydration extension is missing: $tool_turn_rehydrate_extension"
[[ -x $compacted_history_query && -f $compacted_history_query && ! -L $compacted_history_query ]] ||
	die "compacted-history query program is missing or unsafe: $compacted_history_query"
[[ -x $history_program && -f $history_program && ! -L $history_program &&
	$(stat -c '%u:%h' -- "$history_program") == "$(id -u):1" ]] ||
	die "project session history helper is missing or unsafe: $history_program"
[[ -r $repetition_guard_extension ]] || die "Pi repetition guard extension is missing: $repetition_guard_extension"
[[ -r $tool_call_integrity_extension ]] ||
	die "Pi tool-call integrity extension is missing: $tool_call_integrity_extension"
[[ -x $aggressive_launcher && -f $aggressive_launcher && ! -L $aggressive_launcher ]] ||
	die "aggressive model launcher is missing or unsafe: $aggressive_launcher"
[[ -x $radiance_launcher && -f $radiance_launcher && ! -L $radiance_launcher ]] ||
	die "Radiance model launcher is missing or unsafe: $radiance_launcher"
if [[ $snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]]; then
	[[ -f $structured_outcome_extension && ! -L $structured_outcome_extension ]] ||
		die "Pi structured-outcome extension is missing or unsafe: $structured_outcome_extension"
	[[ $(stat -c '%s:%h' -- "$structured_outcome_extension") == "$OUTCOME_EXTENSION_BYTES:1" &&
	$(sha256sum -- "$structured_outcome_extension" | awk '{print $1}') == "$OUTCOME_EXTENSION_SHA256" ]] ||
		die "Pi structured-outcome extension differs from the prompt ABI pin: $structured_outcome_extension"
	[[ -f $structured_outcome_probe && ! -L $structured_outcome_probe &&
		$(stat -c '%a:%s:%h' -- "$structured_outcome_probe") == "755:$OUTCOME_PROBE_BYTES:1" &&
		$(sha256sum -- "$structured_outcome_probe" | awk '{print $1}') == "$OUTCOME_PROBE_SHA256" ]] ||
		die "structured-outcome endpoint probe differs from its qualification pin: $structured_outcome_probe"
fi
if ((snapshot_resume == 1)); then
	[[ -r $fixed_slot_resume_extension ]] ||
		die "fixed-slot resume extension is missing: $fixed_slot_resume_extension"
fi
if [[ -v QWEN_PI_COMPACTION_HANDOFF_REQUEST_ROOT ]]; then
	[[ -r $compaction_handoff_extension ]] ||
		die "transactional compaction handoff extension is missing: $compaction_handoff_extension"
fi
context_window=$(profile_context "$profile")

delegate_aggressive_model() {
	local dry=$1
	local preflight=$2
	local -a launcher_args=(
		--remote "$remote_host"
		--remote-project "$remote_project"
		--local-port "$local_port"
		--thinking "$thinking"
	)
	local -a launcher_environment=(
		"QWEN_PI_AGGRESSIVE_PROMPT_ABI=$snapshot_prompt_abi"
		"QWEN_PI_AGGRESSIVE_VARIANT=$model_choice"
	)
	((no_install == 0)) || launcher_args+=(--no-install)
	# --live62 normally enables automatic reuse-or-start for the vanilla lane.
	# Preserve attach-only semantics only when the operator explicitly requested it.
	((reuse_existing_explicit == 0)) || launcher_args+=(--reuse-existing)
	((fresh_state == 0)) || launcher_args+=(--fresh-state)
	((dry == 0)) || launcher_args+=(--dry-run)
	((preflight == 0)) || launcher_args+=(--preflight-only)
	launcher_args+=(-- "${pi_extra_args[@]}")
	if [[ -n ${tool_turn_archive_root:-} ]]; then
		launcher_environment+=("QWEN_PI_AGGRESSIVE_TOOL_ARCHIVE_ROOT=$tool_turn_archive_root")
	fi
	if [[ -n ${resolved_snapshot_session_file:-} ]]; then
		launcher_environment+=(
			"QWEN_PI_AGGRESSIVE_RESOLVED_SESSION=$resolved_snapshot_session_file"
		)
	fi
	exec env "${launcher_environment[@]}" "$aggressive_launcher" "${launcher_args[@]}"
}

delegate_radiance_model() {
	local dry=$1
	local preflight=$2
	local -a launcher_args=(
		--remote "$remote_host"
		--thinking "$thinking"
	)
	((local_port_explicit == 0)) || launcher_args+=(--local-port "$local_port")
	((no_install == 0)) || launcher_args+=(--no-install)
	((reuse_existing_explicit == 0)) || launcher_args+=(--reuse-existing)
	((dry == 0)) || launcher_args+=(--dry-run)
	((preflight == 0)) || launcher_args+=(--preflight-only)
	launcher_args+=(-- "${pi_extra_args[@]}")
	exec "$radiance_launcher" "${launcher_args[@]}"
}

((dry_run == 0 || preflight_only == 0)) ||
	die '--dry-run and --preflight-only are mutually exclusive'
if ((preflight_only == 1)) && [[ $model_choice == vanilla ]]; then
	die '--preflight-only is available only for non-vanilla model lanes'
fi

if ((dry_run)); then
	if [[ $model_choice == hauhau-delta ]]; then
		delegate_aggressive_model 1 0
	elif [[ $model_choice == radiance-uncensored ]]; then
		delegate_radiance_model 1 0
	fi
	cat <<EOF
remote:       $remote_host
project:      $remote_project
profile/lane: $public_profile / $lane
thinking:     $thinking
local API:    http://127.0.0.1:$local_port/v1
model:        $PI_MODEL
context cap:  $context_window
262K opt-in:  $experimental_262k
fast path:    $require_fast_path
sampling:     $qualification_sampling_label
turbo holdback: $(if ((coding_turbo_quest96)); then printf '64 tokens (unpromoted)'; else printf 'disabled'; fi)
reuse existing: $reuse_existing
snapshot resume: $snapshot_resume
snapshot contract: $snapshot_session_id / $snapshot_branch / $snapshot_manifest_sha256
snapshot prompt ABI: $snapshot_prompt_abi
snapshot auth root: $snapshot_auth_root
checkpoint publish: $(if ((snapshot_capture)); then printf 'explicit staged transaction'; else printf 'disabled for ordinary pinned replay'; fi)
snapshot staging: $(if ((snapshot_capture)); then printf '%s-token root + %s-token increments' "$SNAPSHOT_STAGE_MINIMUM_TOKENS" "$SNAPSHOT_STAGE_INCREMENT_TOKENS"; else printf 'disabled'; fi)
decoder:       $(if ((live62_requested)); then printf 'authenticated live62 snapshot-compatible Quest96/D7'; elif ((dense_ck_lane)); then printf 'authenticated live47 dense-CK prefill + pre-UNIQUE Quest96/D7'; elif ((snapshot_resume)); then printf 'live47 pre-UNIQUE Quest96/D7 snapshot prefix'; elif ((unique_lane)); then printf 'authenticated B7/UNIQUE attachment'; else printf 'profile default'; fi)
Pi install:   $(if ((no_install)); then printf 'disabled'; else printf 'enabled if needed'; fi)
	backend:      $(if ((live62_requested)); then printf '%s/%s/command.sh' "$remote_project" "$LIVE62_V14_ROOT_RELATIVE"; elif ((live47_fast_lane)); then printf '%s/scripts/live47-quest96-d7-frozenlock' "$remote_project"; else printf '%s/scripts/stock-vllm-frozenlock' "$remote_project"; fi)
EOF
	exit 0
fi

if ((coding_turbo_quest96 == 1)); then
	promotion_qualifier="$project_root/experiments/coding-turbo-quest96/qualify.py"
	promotion_record="$project_root/results/coding-turbo-quest96/promotion.json"
	[[ -r $promotion_qualifier ]] || die "turbo promotion verifier is missing: $promotion_qualifier"
	[[ -f $promotion_record && ! -L $promotion_record ]] ||
		die "coding-turbo-quest96 is unpromoted; missing immutable promotion record: $promotion_record"
	python3 "$promotion_qualifier" --verify "$promotion_record" >/dev/null ||
		die 'coding-turbo-quest96 promotion record failed verification'
	printf 'coding-turbo-quest96 promotion: verified AA>=51/parity/lifecycle/containment/performance gates\n' >&2
fi

ensure_protected_directory() {
	local directory=$1
	if [[ -e $directory || -L $directory ]]; then
		[[ -d $directory && ! -L $directory ]] ||
			die "protected state path is not a real directory: $directory"
		[[ $(stat -c '%u' -- "$directory") == "$(id -u)" ]] ||
			die "protected state directory has unsafe ownership: $directory"
		chmod 0700 -- "$directory" || die "cannot protect state directory: $directory"
		[[ $(stat -c '%u:%a' -- "$directory") == "$(id -u):700" ]] ||
			die "protected state directory has unsafe ownership or mode after chmod: $directory"
		return 0
	fi
	mkdir --mode=0700 -- "$directory" || die "cannot create protected state directory: $directory"
	[[ -d $directory && ! -L $directory &&
		$(stat -c '%u:%a' -- "$directory") == "$(id -u):700" ]] ||
		die "created state directory has unsafe identity: $directory"
}

seal_snapshot_program() {
	local source=$1 destination=$2 source_mode=$3 destination_mode=$4 label=$5
	PYTHONDONTWRITEBYTECODE=1 python3 - "$source" "$destination" \
		"$source_mode" "$destination_mode" "$label" <<'PY'
from __future__ import annotations

import ctypes
import errno
import hashlib
import os
import secrets
import stat
import sys
from pathlib import Path

source = Path(sys.argv[1])
destination = Path(sys.argv[2])
source_mode = int(sys.argv[3], 8)
destination_mode = int(sys.argv[4], 8)
label = sys.argv[5]
maximum_bytes = 2 * 1024 * 1024


def fail(message: str) -> None:
    raise SystemExit(f"pi-remote-qwen: {message}")


def read_regular(path: Path, expected_mode: int, description: str) -> bytes:
    if not path.is_absolute():
        fail(f"{description} path is not absolute: {path}")
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as error:
        fail(f"cannot read {description} {path}: {error}")
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.getuid()
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != expected_mode
            or not 1 <= before.st_size <= maximum_bytes
        ):
            fail(f"{description} has an unsafe identity, mode, or size: {path}")
        payload = bytearray()
        while len(payload) < before.st_size:
            chunk = os.read(descriptor, min(1024 * 1024, before.st_size - len(payload)))
            if not chunk:
                fail(f"{description} ended during its authenticated read: {path}")
            payload.extend(chunk)
        if os.read(descriptor, 1):
            fail(f"{description} grew during its authenticated read: {path}")
        after = os.fstat(descriptor)
        if (
            before.st_dev,
            before.st_ino,
            before.st_mode,
            before.st_uid,
            before.st_nlink,
            before.st_size,
            before.st_mtime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_mode,
            after.st_uid,
            after.st_nlink,
            after.st_size,
            after.st_mtime_ns,
        ):
            fail(f"{description} changed during its authenticated read: {path}")
        return bytes(payload)
    finally:
        os.close(descriptor)


def inspect_parent(path: Path) -> None:
    try:
        info = path.stat(follow_symlinks=False)
    except OSError as error:
        fail(f"cannot inspect pinned-program parent {path}: {error}")
    if (
        not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        fail(f"pinned-program parent has an unsafe identity or mode: {path}")


def fsync_parent(path: Path) -> None:
    descriptor = os.open(
        path,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


inspect_parent(destination.parent)
if destination.exists() or destination.is_symlink():
    # Repository relocation and upgrades deliberately do not affect an existing
    # transaction. Its already-pinned program is the only permitted interpreter.
    payload = read_regular(destination, destination_mode, f"pinned {label}")
else:
    payload = read_regular(source, source_mode, f"source {label}")
    temporary = destination.parent / (
        f".{destination.name}.pin-{os.getpid()}-{secrets.token_hex(12)}.tmp"
    )
    descriptor = os.open(
        temporary,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | os.O_CLOEXEC
        | getattr(os, "O_NOFOLLOW", 0),
        destination_mode,
    )
    try:
        offset = 0
        while offset < len(payload):
            written = os.write(descriptor, payload[offset:])
            if written <= 0:
                fail(f"short durable write while pinning {label}")
            offset += written
        os.fchmod(descriptor, destination_mode)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)

    renameat2 = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if renameat2 is None:
        fail(f"atomic {label} pinning requires Linux renameat2")
    renameat2.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    )
    renameat2.restype = ctypes.c_int
    try:
        result = renameat2(
            -100,
            os.fsencode(temporary),
            -100,
            os.fsencode(destination),
            1,
        )
        if result != 0:
            error = ctypes.get_errno()
            if error != errno.EEXIST:
                fail(f"cannot atomically pin {label}: {os.strerror(error)}")
        else:
            fsync_parent(destination.parent)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
    published = read_regular(destination, destination_mode, f"pinned {label}")
    if published != payload:
        fail(f"existing pinned {label} differs from the candidate bytes")
print(hashlib.sha256(payload).hexdigest())
PY
}

publish_or_validate_snapshot_adapter() {
	local controller=$1 candidate=$2 destination=$3
	PYTHONDONTWRITEBYTECODE=1 python3 - "$controller" \
		"$candidate" "$destination" <<'PY'
from __future__ import annotations

import runpy
import sys
from pathlib import Path

controller_path = Path(sys.argv[1])
candidate_path = Path(sys.argv[2])
destination = Path(sys.argv[3])
api = runpy.run_path(str(controller_path))
inspect_regular = api["inspect_regular"]
write_create_only = api["write_create_only"]
ControllerError = api["ControllerError"]

try:
    candidate = inspect_regular(
        candidate_path,
        mode=0o600,
        maximum_bytes=128 * 1024,
        label="snapshot verifier adapter candidate",
    )
    write_create_only(destination, candidate, mode=0o700)
    published = inspect_regular(
        destination,
        mode=0o700,
        maximum_bytes=128 * 1024,
        label="snapshot verifier adapter",
    )
    if published != candidate:
        raise ControllerError("existing snapshot verifier adapter differs from its pinned contract")
except ControllerError as exc:
    raise SystemExit(f"pi-remote-qwen: {exc}") from exc
PY
}

publish_or_validate_snapshot_runtime_pin() {
	local controller=$1 destination=$2 controller_sha256=$3 verifier_sha256=$4
	local prompt_abi=$5 session_id=$6 branch=$7
	PYTHONDONTWRITEBYTECODE=1 python3 - "$controller" "$destination" \
		"$controller_sha256" "$verifier_sha256" "$prompt_abi" "$session_id" "$branch" \
		"$SNAPSHOT_STAGE_MINIMUM_TOKENS" "$SNAPSHOT_STAGE_INCREMENT_TOKENS" <<'PY'
from __future__ import annotations

import json
import os
import runpy
import sys
from pathlib import Path

controller = Path(sys.argv[1])
destination = Path(sys.argv[2])
controller_sha256, verifier_sha256, prompt_abi, session_id, branch = sys.argv[3:8]
minimum_tokens, increment_tokens = (int(value) for value in sys.argv[8:10])
api = runpy.run_path(str(controller))
inspect_regular = api["inspect_regular"]
write_create_only = api["write_create_only"]
ControllerError = api["ControllerError"]
document = {
    "branch": branch,
    "controller_sha256": controller_sha256,
    "prompt_abi": prompt_abi,
    "schema": "urn:qwen-r9700:staged-snapshot-runtime-pin:v2",
    "session_id": session_id,
    "stage_increment_tokens": increment_tokens,
    "stage_minimum_tokens": minimum_tokens,
    "verifier_sha256": verifier_sha256,
}
payload = json.dumps(document, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode() + b"\n"
try:
    write_create_only(destination, payload, mode=0o400)
    published = inspect_regular(
        destination,
        mode=0o400,
        maximum_bytes=64 * 1024,
        label="snapshot runtime pin",
    )
    if published != payload:
        raise ControllerError("existing snapshot runtime pin differs from the exact transaction")
except ControllerError as exc:
    raise SystemExit(f"pi-remote-qwen: {exc}") from exc
PY
}

publish_or_validate_authenticated_snapshot_head() {
	local controller=$1 destination=$2
	PYTHONDONTWRITEBYTECODE=1 python3 - "$controller" "$destination" 3<&0 <<'PY'
from __future__ import annotations

import json
import os
import runpy
import sys
from pathlib import Path

controller = Path(sys.argv[1])
destination = Path(sys.argv[2])
api = runpy.run_path(str(controller))
inspect_regular = api["inspect_regular"]
write_create_only = api["write_create_only"]
ControllerError = api["ControllerError"]

try:
    with os.fdopen(3, encoding="utf-8") as candidate_stream:
        document = json.load(candidate_stream)
    if not isinstance(document, dict):
        raise ControllerError("authenticated snapshot head is not a JSON object")
    payload = (
        json.dumps(document, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode()
        + b"\n"
    )
    write_create_only(destination, payload, mode=0o400)
    published = inspect_regular(
        destination,
        mode=0o400,
        maximum_bytes=4 * 1024 * 1024,
        label="authenticated snapshot head",
    )
    if published != payload:
        raise ControllerError("existing authenticated snapshot head differs from the committed head")
except (ControllerError, json.JSONDecodeError) as exc:
    raise SystemExit(f"pi-remote-qwen: {exc}") from exc
PY
}

if [[ $model_choice == vanilla ]] &&
	((live62_requested == 1 && snapshot_contract_auto == 1 && snapshot_capture == 0 && \
	session_arg_present == 1 && dry_run == 0)) &&
	[[ ${QWEN_PI_COMPACTION_INNER:-0} != 1 ]]; then
	# The supervisor's ABI includes the complete managed Pi installation. Ensure
	# that installation exists before the outer process computes the ABI; the
	# supervised inner launcher reauthenticates the same link and version.
	if ((no_install)); then
		[[ -L $pi_link && -x $pi_link ]] ||
			die "verified Pi link is missing: $pi_link (remove --no-install)"
	elif ! { [[ -L $pi_link && -x $pi_link ]] &&
		"$pi_link" --version 2>/dev/null | grep -qx "$PI_VERSION"; }; then
		"$install_script" >/dev/null
	fi
	[[ -L $pi_link && -x $pi_link ]] ||
		die "Pi command is not an executable symbolic link: $pi_link"
	[[ $("$pi_link" --version) == "$PI_VERSION" ]] ||
		die "Pi version must be $PI_VERSION before compaction supervision"
	[[ -f $COMPACTION_SUPERVISOR_PROGRAM && ! -L $COMPACTION_SUPERVISOR_PROGRAM &&
		$(stat -c '%u:%a:%h' -- "$COMPACTION_SUPERVISOR_PROGRAM") == "$(id -u):755:1" ]] ||
		die "live62 compaction supervisor has an unsafe identity: $COMPACTION_SUPERVISOR_PROGRAM"
	exec "$COMPACTION_SUPERVISOR_PROGRAM" --launcher "$script_path" -- \
		"${original_launcher_arguments[@]}"
fi

state_parent="$HOME/.local/state/qwen-r9700"
state_root="$state_parent/pi-remote"
mkdir -p -- "$state_parent"
[[ -d $state_parent && ! -L $state_parent && $(stat -c '%u' -- "$state_parent") == "$(id -u)" ]] ||
	die "state parent has an unsafe identity: $state_parent"
ensure_protected_directory "$state_root"
live_tool_result_root="$state_parent/pi-tool-results"
ensure_protected_directory "$live_tool_result_root"
snapshot_bootstrap_output=''
snapshot_bootstrap_started_output=''
snapshot_bootstrap_token_file=''
snapshot_outcome_provider_payload=''
snapshot_outcome_probe_root=''
snapshot_stage_plan=''
snapshot_stage_journal_root=''
snapshot_stage_transaction_root=''
snapshot_stage_controller=''
snapshot_stage_controller_sha256=''
snapshot_runtime_pin=''
snapshot_remote_verifier=''
snapshot_verifier_source=''
snapshot_verifier_source_sha256=''
snapshot_prefix_sha256=''
snapshot_tokens=60298
snapshot_resume_prefix_tokens=60298
resolved_snapshot_session_file=''
active_chat_compaction_manifest=''
active_chat_compaction_manifest_sha256=''
tool_turn_archive_root=''
semantic_history_manifest=''
semantic_history_manifest_sha256=''
bootstrap_session_clone=''
snapshot_capture_authenticated=0
snapshot_stage_execution_started=0
snapshot_fresh_backend_authenticated=0
snapshot_success_backend_preserve=0
snapshot_exit_flush=0
snapshot_exit_flush_root=''
snapshot_exit_token_root=''
snapshot_exit_latest_receipt=''
snapshot_exit_plan_root=''
snapshot_exit_journal_root=''
snapshot_exit_verifier_source=''
snapshot_exit_remote_verifier=''
snapshot_background_run_id=''
snapshot_background_pid=''
snapshot_background_start=''
snapshot_background_status=0
snapshot_background_log=''
if ((snapshot_capture == 1)); then
	# Bootstrap exports the complete rendered prompt, but its admission floor is
	# the qualified short-root geometry. Leaving the legacy 60,298-token default
	# here made every semantically compacted successor below 60K abort before its
	# token vector could be published, even though the staged controller and the
	# authenticated backend both accept the 8,258-token root.
	snapshot_tokens=$SNAPSHOT_STAGE_MINIMUM_TOKENS
	snapshot_resume_prefix_tokens=$SNAPSHOT_STAGE_MINIMUM_TOKENS
	[[ $snapshot_session_id != "$DEFAULT_SNAPSHOT_SESSION_ID" ]] ||
		die '--snapshot-bootstrap requires a distinct --snapshot-session-id'
	bootstrap_root="$state_root/snapshot-bootstrap-v5"
	ensure_protected_directory "$bootstrap_root"
	ensure_protected_directory "$bootstrap_root/$snapshot_prompt_abi"
	ensure_protected_directory "$bootstrap_root/$snapshot_prompt_abi/$snapshot_session_id"
	snapshot_stage_transaction_root="$bootstrap_root/$snapshot_prompt_abi/$snapshot_session_id/$snapshot_branch"
	ensure_protected_directory "$snapshot_stage_transaction_root"
	snapshot_stage_journal_root="$snapshot_stage_transaction_root/journal"
	ensure_protected_directory "$snapshot_stage_journal_root"
	snapshot_bootstrap_output="$snapshot_stage_transaction_root/token-export.json"
	snapshot_bootstrap_started_output="${snapshot_bootstrap_output}.started"
	snapshot_bootstrap_token_file="$snapshot_stage_transaction_root/prompt-tokens.qwenstg1"
	if [[ $snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]]; then
		snapshot_outcome_provider_payload="$snapshot_stage_transaction_root/structured-outcome-provider-payload.json"
		snapshot_outcome_probe_root="$snapshot_stage_transaction_root/structured-outcome-probe-v2"
		ensure_protected_directory "$snapshot_outcome_probe_root"
	fi
	snapshot_stage_plan="$snapshot_stage_transaction_root/staged-plan.json"
	snapshot_stage_controller="$snapshot_stage_transaction_root/qwen-snapshot-stage-controller"
	snapshot_runtime_pin="$snapshot_stage_transaction_root/runtime-pin.json"
	snapshot_verifier_source="$snapshot_stage_transaction_root/qwen-snapshot-verify.py"
	snapshot_remote_verifier="$snapshot_stage_transaction_root/remote-verifier"
	snapshot_stage_controller_sha256=$(seal_snapshot_program \
		"$SNAPSHOT_STAGE_CONTROLLER" "$snapshot_stage_controller" 0755 0500 \
		'snapshot stage controller') ||
		die 'cannot pin the per-transaction snapshot stage controller'
	[[ $snapshot_stage_controller_sha256 =~ ^[0-9a-f]{64}$ ]] ||
		die 'pinned snapshot stage controller returned an invalid digest'
	[[ $snapshot_stage_controller_sha256 == "$SNAPSHOT_STAGE_CONTROLLER_SHA256" ]] ||
		die 'pinned snapshot stage controller differs from the transaction-v5 ABI; use an explicit audited migration'
	snapshot_verifier_source_sha256=$(seal_snapshot_program \
		"$SNAPSHOT_VERIFY_SCRIPT" "$snapshot_verifier_source" 0755 0400 \
		'snapshot verifier source') ||
		die 'cannot seal the per-transaction snapshot verifier source'
	[[ $snapshot_verifier_source_sha256 =~ ^[0-9a-f]{64}$ ]] ||
		die 'sealed snapshot verifier returned an invalid digest'
	[[ $snapshot_verifier_source_sha256 == "$SNAPSHOT_VERIFY_SHA256" ]] ||
		die 'pinned snapshot verifier differs from the transaction-v5 ABI; use an explicit audited migration'
	publish_or_validate_snapshot_runtime_pin \
		"$snapshot_stage_controller" "$snapshot_runtime_pin" \
		"$snapshot_stage_controller_sha256" "$snapshot_verifier_source_sha256" \
		"$snapshot_prompt_abi" "$snapshot_session_id" "$snapshot_branch" ||
		die 'cannot publish or authenticate the per-transaction runtime pin'
	adapter_candidate=$(mktemp "$snapshot_stage_transaction_root/.remote-verifier.XXXXXX") ||
		die 'cannot create snapshot verifier adapter candidate'
	chmod 0600 -- "$adapter_candidate"
	{
		printf '%s\n' '#!/usr/bin/env bash' '' 'set -euo pipefail' ''
		printf 'readonly VERIFY_SOURCE=%q\n' "$snapshot_verifier_source"
		printf 'readonly VERIFY_SOURCE_SHA256=%q\n' "$snapshot_verifier_source_sha256"
		cat <<'REMOTE_VERIFIER_ADAPTER'
readonly VERIFY_REMOTE_HOST='lewis@ai'

[[ -f $VERIFY_SOURCE && ! -L $VERIFY_SOURCE ]] || {
	printf 'qwen-remote-snapshot-verify: sealed verifier source is missing or unsafe\n' >&2
	exit 2
}
[[ $(stat -c '%u:%a:%h' -- "$VERIFY_SOURCE") == "$UID:400:1" ]] || {
	printf 'qwen-remote-snapshot-verify: sealed verifier source identity changed\n' >&2
	exit 2
}
observed_sha256=$(sha256sum -- "$VERIFY_SOURCE" | awk '{print $1}')
[[ $observed_sha256 == "$VERIFY_SOURCE_SHA256" ]] || {
	printf 'qwen-remote-snapshot-verify: sealed verifier source digest changed\n' >&2
	exit 2
}
for argument in "$@"; do
	if [[ $argument == --* ]]; then
		[[ $argument =~ ^--[a-z0-9-]+$ ]] || exit 64
	elif [[ $argument == /* ]]; then
		[[ $argument =~ ^/[A-Za-z0-9._/-]+$ ]] || exit 64
	else
		[[ $argument =~ ^[A-Za-z0-9._-]+$ ]] || exit 64
	fi
done
exec ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 \
	"$VERIFY_REMOTE_HOST" /usr/bin/python3 - "$@" <"$VERIFY_SOURCE"
REMOTE_VERIFIER_ADAPTER
	} >"$adapter_candidate"
	publish_or_validate_snapshot_adapter "$snapshot_stage_controller" \
		"$adapter_candidate" "$snapshot_remote_verifier" ||
		die 'cannot publish or authenticate the per-transaction remote verifier adapter'
	rm -f -- "$adapter_candidate"
fi
config_tmp=''
settings_tmp=''
backend_log=''
remote_backend_log=''
tunnel_pid=''
backend_pid=''
pi_pid=''
pi_start=''
backend_watch_pid=''
backend_watch_status=0
backend_health_lost=0
backend_health_lost_marker=''
shutdown_signal_status=0

owned_pi_process() {
	[[ $pi_pid =~ ^[1-9][0-9]*$ && $pi_start =~ ^[1-9][0-9]*$ ]] || return 1
	[[ -r /proc/$pi_pid/status && -r /proc/$pi_pid/stat ]] || return 1
	[[ $(awk '/^Uid:/ {print $2}' "/proc/$pi_pid/status" 2>/dev/null) == "$(id -u)" ]] || return 1
	[[ $(awk '{print $22}' "/proc/$pi_pid/stat" 2>/dev/null) == "$pi_start" ]]
}

owned_snapshot_background_publisher() {
	[[ $snapshot_background_pid =~ ^[1-9][0-9]*$ && $snapshot_background_start =~ ^[1-9][0-9]*$ ]] || return 1
	[[ -r /proc/$snapshot_background_pid/status && -r /proc/$snapshot_background_pid/stat ]] || return 1
	[[ $(awk '/^Uid:/ {print $2}' "/proc/$snapshot_background_pid/status" 2>/dev/null) == "$(id -u)" ]] || return 1
	[[ $(awk '{print $22}' "/proc/$snapshot_background_pid/stat" 2>/dev/null) == "$snapshot_background_start" ]]
}

# Invoked from cleanup(), which is itself trap-owned.
# shellcheck disable=SC2329
stop_owned_remote_backend() {
	((reuse_existing == 0)) || return 0
	[[ -n $backend_log && -f $backend_log ]] || return 0
	local supervisor_receipt server_receipt
	local supervisor_pid supervisor_start server_pid server_start
	supervisor_receipt=$(awk '/^PI_REMOTE_BACKEND_SUPERVISOR / {line=$0} END {print line}' "$backend_log")
	[[ -n $supervisor_receipt ]] || return 0
	read -r _ supervisor_pid supervisor_start <<<"$supervisor_receipt"
	supervisor_pid=${supervisor_pid#pid=}
	supervisor_start=${supervisor_start#start_ticks=}
	server_receipt=$(awk '/^PI_REMOTE_BACKEND_SERVER / {line=$0} END {print line}' "$backend_log")
	server_pid=''
	server_start=''
	if [[ -n $server_receipt ]]; then
		read -r _ server_pid server_start <<<"$server_receipt"
		server_pid=${server_pid#pid=}
		server_start=${server_start#start_ticks=}
	fi
	[[ $supervisor_pid =~ ^[1-9][0-9]*$ && $supervisor_start =~ ^[1-9][0-9]*$ ]] || {
		printf 'pi-remote-qwen: invalid owned-backend supervisor receipt; refusing remote cleanup\n' >&2
		return 1
	}
	if [[ -n $server_pid ]] &&
		[[ ! $server_pid =~ ^[1-9][0-9]*$ || ! $server_start =~ ^[1-9][0-9]*$ ]]; then
		printf 'pi-remote-qwen: invalid owned-backend server receipt; refusing remote cleanup\n' >&2
		return 1
	fi
	ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 "$remote_host" bash -s -- \
		"$supervisor_pid" "$supervisor_start" "$server_pid" "$server_start" \
		"$remote_project" "$backend_profile" "$lane" <<'REMOTE_OWNED_BACKEND_STOP'
set -euo pipefail
supervisor_pid=$1
supervisor_start=$2
server_pid=$3
server_start=$4
project=$5
profile=$6
lane=$7

process_start() {
	awk '{print $22}' "/proc/$1/stat" 2>/dev/null || true
}
owned_process() {
	local pid=$1 expected_start=$2
	[[ -r /proc/$pid/status && -r /proc/$pid/cmdline ]] || return 1
	[[ $(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null) == "$(id -u)" ]] || return 1
	[[ $(process_start "$pid") == "$expected_start" ]]
}

if owned_process "$supervisor_pid" "$supervisor_start"; then
	supervisor_args=$(tr '\0' ' ' <"/proc/$supervisor_pid/cmdline")
	[[ $supervisor_args == *"bash -s -- $project $profile $lane "* ]] || {
		printf 'pi-remote-qwen: owned backend supervisor identity changed; refusing cleanup\n' >&2
		exit 3
	}
fi
if [[ -n $server_pid ]] && owned_process "$server_pid" "$server_start"; then
	server_args=$(tr '\0' ' ' <"/proc/$server_pid/cmdline")
	if [[ $server_args == *'/vllm serve /home/lewis/models/Qwen3.8-27B-int4-AutoRound'* &&
		$server_args == *'--port 8000'* ]]; then
		kill -TERM "$server_pid"
		elif [[ $server_args == *"$project/scripts/stock-vllm-frozenlock --profile $profile --lane $lane"* ||
				$server_args == *"$project/artifacts/qualifications/20260903T-live62-snapshot-compatible-v47-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260902T-live62-snapshot-compatible-v46-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260902T-live62-snapshot-compatible-v45-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260902T-live62-snapshot-compatible-v44-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260902T-live62-snapshot-compatible-v43-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v42-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v41-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v20-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v19-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v18-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v17-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v15-create-only/command.sh"* ||
			$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v10-create-only/command.sh"* ||
			$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v11-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v12-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v13-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-snapshot-compatible-v14-create-only/command.sh"* ||
				$server_args == *"$project/artifacts/qualifications/20260901T-live62-w4-fused-gate-precast-v7-create-only/command.sh"* ]]; then
		# Before the launcher execs vLLM, let the authenticated supervisor signal
		# its direct server parent and wait for that parent's own child teardown.
		kill -TERM "$supervisor_pid"
	else
		printf 'pi-remote-qwen: owned backend server identity changed; refusing cleanup\n' >&2
		exit 3
	fi
elif owned_process "$supervisor_pid" "$supervisor_start"; then
	# Startup has not published a server receipt yet. Signal the authenticated
	# supervisor so its existing trap terminates any partially-created children.
	kill -TERM "$supervisor_pid"
fi

for _ in {1..60}; do
	supervisor_alive=0
	server_alive=0
	owned_process "$supervisor_pid" "$supervisor_start" && supervisor_alive=1
	if [[ -n $server_pid ]]; then
		owned_process "$server_pid" "$server_start" && server_alive=1
	fi
	if [[ $supervisor_alive == 0 && $server_alive == 0 ]]; then
		exit 0
	fi
	sleep 0.5
done
printf 'pi-remote-qwen: owned remote backend did not stop after TERM\n' >&2
exit 3
REMOTE_OWNED_BACKEND_STOP
}

authenticate_fresh_snapshot_backend() {
	((live62_requested == 1 && reuse_existing == 0)) || return 1
	[[ -n $backend_log && -f $backend_log && ! -L $backend_log ]] || return 1
	local supervisor_receipt server_receipt
	local supervisor_pid supervisor_start server_pid server_start
	supervisor_receipt=$(awk '/^PI_REMOTE_BACKEND_SUPERVISOR / {line=$0} END {print line}' "$backend_log")
	server_receipt=$(awk '/^PI_REMOTE_BACKEND_SERVER / {line=$0} END {print line}' "$backend_log")
	[[ -n $supervisor_receipt && -n $server_receipt ]] || return 1
	read -r _ supervisor_pid supervisor_start <<<"$supervisor_receipt"
	read -r _ server_pid server_start <<<"$server_receipt"
	supervisor_pid=${supervisor_pid#pid=}
	supervisor_start=${supervisor_start#start_ticks=}
	server_pid=${server_pid#pid=}
	server_start=${server_start#start_ticks=}
	[[ $supervisor_pid =~ ^[1-9][0-9]*$ && $supervisor_start =~ ^[1-9][0-9]*$ &&
		$server_pid =~ ^[1-9][0-9]*$ && $server_start =~ ^[1-9][0-9]*$ ]] || return 1
	ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 "$remote_host" bash -s -- \
		"$supervisor_pid" "$supervisor_start" "$server_pid" "$server_start" \
		"$remote_project" "$backend_profile" "$lane" <<'REMOTE_FRESH_SNAPSHOT_BACKEND'
set -euo pipefail
supervisor_pid=$1
supervisor_start=$2
server_pid=$3
server_start=$4
project=$5
profile=$6
lane=$7

process_start() {
	awk '{print $22}' "/proc/$1/stat" 2>/dev/null || true
}
owned_process() {
	local pid=$1 expected_start=$2
	[[ -r /proc/$pid/status && -r /proc/$pid/cmdline ]] || return 1
	[[ $(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null) == "$UID" ]] || return 1
	[[ $(process_start "$pid") == "$expected_start" ]]
}

