authenticate_protected_regular() {
	local path=$1 expected_sha256=$2 expected_bytes=$3 label=$4
	local file_uid links bytes permissions observed_sha256
	[[ -f $path && ! -L $path ]] || die "$label is not a regular non-symlink: $path"
	read -r file_uid links bytes permissions < <(stat -c '%u %h %s %a' -- "$path") ||
		die "cannot stat $label: $path"
	[[ $file_uid == "$UID" && $links == 1 && $bytes == "$expected_bytes" ]] ||
		die "$label protected identity differs: $path"
	(( (8#$permissions & 8#22) == 0 )) ||
		die "$label is group/world writable: $path"
	observed_sha256=$(sha256sum -- "$path" | awk '{print $1}') ||
		die "cannot hash $label: $path"
	[[ $observed_sha256 == "$expected_sha256" ]] || die "$label byte identity differs: $path"
}
