fixed_marker_count() {
	local log=$1 marker=$2
	awk -v marker="$marker" '
        {
            remaining = $0
            while ((offset = index(remaining, marker)) != 0) {
                count++
                remaining = substr(remaining, offset + length(marker))
            }
        }
        END { print count + 0 }
    ' "$log"
}

assert_engine_marker_once() {
	local log=$1 engine_core_pid=$2 marker=$3 marker_counts
	marker_counts=$(awk -v marker="$marker" -v expected_pid="$engine_core_pid" '
	        index($0, marker) {
	            tag = "(EngineCore pid="
	            start = index($0, tag)
	            if (start == 0) next
	            pid = substr($0, start + length(tag))
	            sub(/\).*/, "", pid)
	            tagged++
	            if (pid == expected_pid) exact++
	            else mismatched++
	        }
	        END { print tagged + 0, exact + 0, mismatched + 0 }
	    ' "$log") || die "cannot authenticate EngineCore marker provenance for '$marker': $log"
	[[ $marker_counts == '1 1 0' ]] ||
		die "required EngineCore marker has tagged/exact/mismatched counts '$marker_counts', expected '1 1 0' for '$marker': $log"
}

assert_live62_v14_bootstrap() {
	local log=$1 bootstrap_count v11_bootstrap_count v12_bootstrap_count v13_bootstrap_count v14_bootstrap_count v15_bootstrap_count v47_base_bootstrap_count v47_bootstrap_count fused_bootstrap_count metadata_count scan_status=0
	local engine_core_pid engine_receipt_count replay_receipt_count request_safe_receipt_count resident_receipt_count module_count exact_count
	local bootstrap_marker='[qwen-live62-v10] authenticated sparse bootstrap complete'
	local v11_bootstrap_marker='[qwen-live62-v11] authenticated usage-stats-off bootstrap complete'
	local v12_bootstrap_marker='[qwen-live62-v12] authenticated D7-only GDN discriminator installed'
	local v13_bootstrap_marker='[qwen-live62-v13] authenticated deterministic request IDs enabled'
	local v14_bootstrap_marker='[qwen-live62-v14] authenticated pinned replay-only bootstrap complete'
	local v15_bootstrap_marker='[qwen-live62-v15] authenticated request-safe replay bootstrap complete'
	local v47_base_bootstrap_marker='[qwen-live62-v47-base] authenticated resident-head bootstrap complete'
	local v47_bootstrap_marker='[qwen-live62-v47] authenticated strict-tool-calling bootstrap complete'
	local fused_bootstrap_marker='[qwen-live62-w4-fused-gate-precast] authenticated pair-N=16 bootstrap complete'
	local metadata_marker='[qwen-gdn-metadata-m8-fast] exact M8 metadata path armed'
	local receipt_marker='[qwen-live62-v10] authenticated foundation module loaded'
	local replay_receipt_marker='[qwen-live62-v14] authenticated replay-only module loaded'
	local request_safe_receipt_marker='[qwen-live62-v15] authenticated request-safe module loaded'
	local resident_receipt_marker='[qwen-live62-v47-base] authenticated resident module loaded'
	local -a engine_core_pids=()
	[[ -f $log && ! -L $log && $(stat -c '%u:%a:%h' -- "$log") == "$(id -u):600:1" ]] ||
		die "unsafe live62 v14 backend log identity: $log"
	grep -Eq 'Error in sitecustomize|resolved unexpectedly|path differs|PYTHONPATH contract differs|full-tree vLLM shadow|catalog .* differs|provenance differs|EngineCore encountered a fatal error|EngineDeadError|SelectionSafetyError|Traceback|cold fallback' "$log" || scan_status=$?
	if ((scan_status == 0)); then
		die "live62 v14 backend log contains a site, path, or fatal startup error: $log"
	elif ((scan_status != 1)); then
		die "cannot scan the live62 v14 backend log for startup errors: $log"
	fi
	bootstrap_count=$(fixed_marker_count "$log" "$bootstrap_marker") ||
		die "cannot count the live62 v10 bootstrap marker: $log"
	v11_bootstrap_count=$(fixed_marker_count "$log" "$v11_bootstrap_marker") ||
		die "cannot count the live62 v11 bootstrap marker: $log"
	v12_bootstrap_count=$(fixed_marker_count "$log" "$v12_bootstrap_marker") ||
		die "cannot count the live62 v12 bootstrap marker: $log"
	v13_bootstrap_count=$(fixed_marker_count "$log" "$v13_bootstrap_marker") ||
		die "cannot count the live62 v13 bootstrap marker: $log"
	v14_bootstrap_count=$(fixed_marker_count "$log" "$v14_bootstrap_marker") ||
		die "cannot count the live62 v14 bootstrap marker: $log"
	v15_bootstrap_count=$(fixed_marker_count "$log" "$v15_bootstrap_marker") ||
		die "cannot count the live62 v15 bootstrap marker: $log"
	v47_base_bootstrap_count=$(fixed_marker_count "$log" "$v47_base_bootstrap_marker") ||
		die "cannot count the live62 v47-base bootstrap marker: $log"
	v47_bootstrap_count=$(fixed_marker_count "$log" "$v47_bootstrap_marker") ||
		die "cannot count the live62 v47 bootstrap marker: $log"
	fused_bootstrap_count=$(fixed_marker_count "$log" "$fused_bootstrap_marker") ||
		die "cannot count the live62 fused-W4 bootstrap marker: $log"
	metadata_count=$(fixed_marker_count "$log" "$metadata_marker") ||
		die "cannot count the exact M8 metadata marker: $log"
	[[ $bootstrap_count =~ ^[0-9]+$ && $v11_bootstrap_count =~ ^[0-9]+$ && $v12_bootstrap_count =~ ^[0-9]+$ && $v13_bootstrap_count =~ ^[0-9]+$ && $v14_bootstrap_count =~ ^[0-9]+$ && $v15_bootstrap_count =~ ^[0-9]+$ && $v47_base_bootstrap_count =~ ^[0-9]+$ && $v47_bootstrap_count =~ ^[0-9]+$ && $fused_bootstrap_count =~ ^[0-9]+$ && $metadata_count =~ ^[0-9]+$ ]] ||
		die "live62 v14 backend marker counts are malformed: $log"
	((bootstrap_count == 3)) ||
		die "live62 v10 bootstrap marker count is $bootstrap_count, expected exactly 3: $log"
	((v11_bootstrap_count == 3)) ||
		die "live62 v11 bootstrap marker count is $v11_bootstrap_count, expected exactly 3: $log"
	((v12_bootstrap_count == 3)) ||
		die "live62 v12 bootstrap marker count is $v12_bootstrap_count, expected exactly 3: $log"
	((v13_bootstrap_count == 3)) ||
		die "live62 v13 bootstrap marker count is $v13_bootstrap_count, expected exactly 3: $log"
	((v14_bootstrap_count == 3)) ||
		die "live62 v14 bootstrap marker count is $v14_bootstrap_count, expected exactly 3: $log"
	((v15_bootstrap_count == 3)) ||
		die "live62 v15 bootstrap marker count is $v15_bootstrap_count, expected exactly 3: $log"
	((v47_base_bootstrap_count == 3)) ||
		die "live62 v47-base bootstrap marker count is $v47_base_bootstrap_count, expected exactly 3: $log"
	((v47_bootstrap_count == 3)) ||
		die "live62 v47 bootstrap marker count is $v47_bootstrap_count, expected exactly 3: $log"
	((fused_bootstrap_count == 3)) ||
		die "live62 fused-W4 bootstrap marker count is $fused_bootstrap_count, expected exactly 3: $log"
	((metadata_count == 3)) ||
		die "exact M8 metadata marker count is $metadata_count, expected exactly 3: $log"
	mapfile -t engine_core_pids < <(
		awk '
            {
                tag = "(EngineCore pid="
                start = index($0, tag)
                if (start == 0) next
                pid = substr($0, start + length(tag))
                sub(/\).*/, "", pid)
                if (pid ~ /^[1-9][0-9]*$/) print pid
            }
        ' "$log" |
			sort -u
	)
	((${#engine_core_pids[@]} == 1)) ||
		die "live62 v14 backend log does not identify exactly one EngineCore PID: $log"
	engine_core_pid=${engine_core_pids[0]}
	engine_receipt_count=$(awk -v marker="$receipt_marker pid=$engine_core_pid " '
        index($0, marker) { count++ }
        END { print count + 0 }
    ' "$log") || die "cannot count EngineCore sparse-loader receipts: $log"
	((engine_receipt_count == 1)) ||
		die "live62 v47 EngineCore v10-loader receipt count is $engine_receipt_count, expected exactly 1: $log"
	while read -r module expected_sha256; do
		module_count=$(awk -v receipt="$receipt_marker pid=$engine_core_pid name=$module " '
            index($0, receipt) { count++ }
            END { print count + 0 }
        ' "$log") || die "cannot count EngineCore loader receipt for $module: $log"
		exact_count=$(awk -v receipt="$receipt_marker pid=$engine_core_pid name=$module sha256=$expected_sha256" '
            index($0, receipt) { count++ }
            END { print count + 0 }
        ' "$log") || die "cannot authenticate EngineCore loader receipt for $module: $log"
		((module_count == 1 && exact_count == 1)) ||
			die "live62 v14 EngineCore v10-loader receipt for $module is missing, duplicated, or mismatched: $log"
	done <<'EOF'
	vllm.v1.attention.ops.qwen_dense_ck_prefill ed7b44318ca74cfed92ee4fd3466d2a2bb1aa6454b93b11bcd05f60488d2b062
EOF
	replay_receipt_count=$(awk -v marker="$replay_receipt_marker pid=$engine_core_pid " '
	    index($0, marker) { count++ }
	    END { print count + 0 }
	' "$log") || die "cannot count EngineCore replay-only loader receipts: $log"
	((replay_receipt_count == 0)) ||
		die "live62 v47 unexpectedly loaded an EngineCore replay-only predecessor: $log"
	request_safe_receipt_count=$(awk -v marker="$request_safe_receipt_marker pid=$engine_core_pid " '
	    index($0, marker) { count++ }
	    END { print count + 0 }
	' "$log") || die "cannot count EngineCore request-safe loader receipts: $log"
	((request_safe_receipt_count == 1)) ||
		die "live62 v47 EngineCore request-safe loader receipt count is $request_safe_receipt_count, expected exactly 1: $log"
	while read -r module expected_sha256; do
		module_count=$(awk -v receipt="$request_safe_receipt_marker pid=$engine_core_pid name=$module " '
	        index($0, receipt) { count++ }
	        END { print count + 0 }
	    ' "$log") || die "cannot count EngineCore request-safe receipt for $module: $log"
		exact_count=$(awk -v receipt="$request_safe_receipt_marker pid=$engine_core_pid name=$module sha256=$expected_sha256" '
	        index($0, receipt) { count++ }
	        END { print count + 0 }
	    ' "$log") || die "cannot authenticate EngineCore request-safe receipt for $module: $log"
		((module_count == 1 && exact_count == 1)) ||
			die "live62 v15 EngineCore request-safe receipt for $module is missing, duplicated, or mismatched: $log"
	done <<'EOF'
	vllm.v1.engine.core ecab90ac87afba525f2b19f4da0ab4e0901021d0f19adcda4cc2562f7aa68040
EOF
	resident_receipt_count=$(awk -v marker="$resident_receipt_marker pid=$engine_core_pid " '
	    index($0, marker) { count++ }
	    END { print count + 0 }
	' "$log") || die "cannot count EngineCore resident-head loader receipts: $log"
	((resident_receipt_count == 5)) ||
		die "live62 v47 EngineCore resident loader receipt count is $resident_receipt_count, expected exactly 5: $log"
	while read -r module expected_sha256; do
		module_count=$(awk -v receipt="$resident_receipt_marker pid=$engine_core_pid name=$module " '
	        index($0, receipt) { count++ }
	        END { print count + 0 }
	    ' "$log") || die "cannot count EngineCore resident receipt for $module: $log"
		exact_count=$(awk -v receipt="$resident_receipt_marker pid=$engine_core_pid name=$module sha256=$expected_sha256" '
	        index($0, receipt) { count++ }
	        END { print count + 0 }
	    ' "$log") || die "cannot authenticate EngineCore resident receipt for $module: $log"
		((module_count == 1 && exact_count == 1)) ||
			die "live62 v47 EngineCore resident receipt for $module is missing, duplicated, or mismatched: $log"
	done <<'EOF'
vllm.distributed.kv_transfer.kv_connector.v1.offloading.qwen_persistent_selection bf06db9101bdb92e29186f7bb16bcd5a42febf280418f3de2a3f079a14ebb445
	vllm.distributed.kv_transfer.kv_connector.v1.offloading.scheduler 3d92e0b8c460a1a0533e09ce51593dbbbce307482ab826d258ff20f93eb75af1
	vllm.v1.core.sched.scheduler 34e62b63ef5b13a0a12841a87f73e74ffc9248b0d7bf83328482b17bb9bf1113
vllm.v1.core.kv_cache_manager 3ad5e1fee091baf5f3a1c7f7bb526afaa955f05deb0985b4c42e2eaa80e58d4b
	vllm.v1.core.single_type_kv_cache_manager ddaa76595252b3e584579972d88dd940221d88d6e138ed89b49266469bd2d98c
EOF
	while IFS= read -r marker; do
		assert_engine_marker_once "$log" "$engine_core_pid" "$marker"
	done <<'EOF'
[qwen-lm-head-direct-m8] direct M8 screen armed
[qwen-lm-head-w4-topk] exact W4 retrieval plus indexed refinement armed
[qwen-d7-micros] fused greedy-M8 count output armed
[qwen-gdn-metadata-m8-fast] real-input metadata crosscheck complete calls=48
[qwen-gdn-transaction-bulk] exact launch-coalesced transaction armed
[qwen-w4-fused-gate-precast] exact pair-N=16 W4 producer armed
[qwen-w4-fused-gate-precast] exact Qwen MLP hook armed
EOF
	scan_status=0
	grep -Eq 'Error in sitecustomize|resolved unexpectedly|path differs|PYTHONPATH contract differs|full-tree vLLM shadow|catalog .* differs|provenance differs|EngineCore encountered a fatal error|EngineDeadError|SelectionSafetyError|Traceback|cold fallback' "$log" || scan_status=$?
	((scan_status == 1)) ||
		die "live62 v14 backend log gained a site, path, or fatal startup error during authentication: $log"
}

# Invoked indirectly through the EXIT/INT/TERM trap.
# shellcheck disable=SC2329
cleanup() {
	local status=$?
	local preserve_authenticated_live62=0
	trap - EXIT INT TERM
	if owned_pi_process; then
		kill -TERM "$pi_pid" 2>/dev/null || true
		wait "$pi_pid" 2>/dev/null || true
	fi
	if owned_snapshot_background_publisher; then
		wait "$snapshot_background_pid" 2>/dev/null || status=2
	fi
	if ((snapshot_capture == 1 && snapshot_capture_authenticated == 0 && snapshot_stage_execution_started == 1)); then
		printf 'pi-remote-qwen: stopping the exact owned backend after an incomplete staged snapshot transaction\n' >&2
		printf 'pi-remote-qwen: backend log: %s\n' "$backend_log" >&2
		printf 'pi-remote-qwen: tunnel log: %s\n' "$tunnel_log" >&2
		printf 'pi-remote-qwen: transaction: %s\n' "$snapshot_stage_transaction_root" >&2
		printf 'pi-remote-qwen: rerun the identical command; committed stages will be reused\n' >&2
	fi
	if ((snapshot_success_backend_preserve == 1 && snapshot_fresh_backend_authenticated == 1 && \
		live62_requested == 1 && (snapshot_capture == 0 || snapshot_capture_authenticated == 1))) &&
			[[ -f $backend_log && ! -L $backend_log &&
				$(stat -c '%u:%a:%h' -- "$backend_log") == "$(id -u):600:1" ]] &&
			authenticate_fresh_snapshot_backend; then
		preserve_authenticated_live62=1
		printf 'pi-remote-qwen: leaving the authenticated live62 backend running for immediate attachment\n' >&2
		printf 'pi-remote-qwen: durable PID/start-time evidence: %s\n' "$backend_log" >&2
	fi
	# A retry may repost an unresolved deterministic request only after the old
	# process is known dead. Every incomplete/error/signal exit therefore TERM/waits
	# this launcher's exact PID/start-time-bound backend. Only a fully authenticated
	# live62 head may retain it for the next ordinary --live62 attachment.
	if ((preserve_authenticated_live62 == 0)); then
		if ! stop_owned_remote_backend; then
			status=2
		fi
	fi
	if ((preserve_authenticated_live62 == 0)) && [[ -n $backend_pid ]] && kill -0 "$backend_pid" 2>/dev/null; then
		kill TERM "$backend_pid" 2>/dev/null || true
		wait "$backend_pid" 2>/dev/null || true
	fi
	if [[ -n $tunnel_pid ]] && kill -0 "$tunnel_pid" 2>/dev/null; then
		kill TERM "$tunnel_pid" 2>/dev/null || true
		wait "$tunnel_pid" 2>/dev/null || true
	fi
	if [[ -n $backend_watch_pid ]] && kill -0 "$backend_watch_pid" 2>/dev/null; then
		kill TERM "$backend_watch_pid" 2>/dev/null || true
		wait "$backend_watch_pid" 2>/dev/null || true
	fi
	if [[ -n $config_tmp && -e $config_tmp ]]; then
		rm -f -- "$config_tmp"
	fi
	if [[ -n $settings_tmp && -e $settings_tmp ]]; then
		rm -f -- "$settings_tmp"
	fi
	if [[ -n $bootstrap_session_clone ]]; then
		if [[ $bootstrap_session_clone == "$state_root/snapshot-bootstrap-v5/"* &&
			-f $bootstrap_session_clone && ! -L $bootstrap_session_clone &&
			$(stat -c '%u:%a:%h' -- "$bootstrap_session_clone") == "$(id -u):600:1" ]]; then
			rm -f -- "$bootstrap_session_clone"
		else
			printf 'pi-remote-qwen: bootstrap session clone identity changed; refusing cleanup: %s\n' \
				"$bootstrap_session_clone" >&2
			status=2
		fi
	fi
	exit "$status"
}

# INT/TERM must not jump directly into cleanup: doing so could tear down the
# authenticated backend before the latest outgoing prompt was transactionally
# published.  Forward the signal to Pi, let the normal foreground path wait for
# it, seal/deep-verify the newest head, and only then let the EXIT trap clean up.
# shellcheck disable=SC2329  # Invoked indirectly through signal traps.
request_shutdown() {
	local requested_signal=$1
	if ((shutdown_signal_status == 0)); then
		case $requested_signal in
		INT) shutdown_signal_status=130 ;;
		TERM) shutdown_signal_status=143 ;;
		*) return 2 ;;
		esac
	fi
	if owned_pi_process; then
		kill -TERM "$pi_pid" 2>/dev/null || true
	fi
}

trap cleanup EXIT
trap 'request_shutdown INT' INT
trap 'request_shutdown TERM' TERM

if ((no_install)); then
	[[ -L $pi_link && -x $pi_link ]] ||
		die "verified Pi link is missing: $pi_link (remove --no-install)"
else
	if [[ -L $pi_link && -x $pi_link ]] && "$pi_link" --version 2>/dev/null | grep -qx "$PI_VERSION"; then
		printf 'verified existing Pi %s\n' "$PI_VERSION" >&2
	else
		"$install_script" >/dev/null
	fi
fi
[[ -L $pi_link && -x $pi_link ]] || die "Pi command is not an executable symbolic link: $pi_link"
pi_version=$("$pi_link" --version) || die 'Pi command did not run'
[[ $pi_version == "$PI_VERSION" ]] || die "Pi version is $pi_version, expected $PI_VERSION"

pi_agent_dir="$HOME/.pi/agent"
config_destination="$pi_agent_dir/models.json"
config_source="$project_root/integrations/pi/models.json"
generated_config=0
if [[ $local_port != 8000 || $context_window != 32768 || $qualification_greedy_sampling == 1 ]]; then
	generated_config=1
	if ((snapshot_resume == 1)); then
		# Snapshot branches use a sterile, versioned prompt capsule. A tool added to
		# a mutable per-port agent directory must not silently change page zero on
		# the next process start.
		pi_agent_dir="$state_root/prompt-abi/$snapshot_prompt_abi/agent-$profile-$local_port"
		mkdir -p -- "$state_root/prompt-abi" "${pi_agent_dir%/*}"
		chmod 0700 -- "$state_root/prompt-abi" "${pi_agent_dir%/*}"
	else
		pi_agent_dir="$state_root/agent-$profile-$local_port"
	fi
	config_destination="$pi_agent_dir/models.json"
	mkdir -p -- "$pi_agent_dir"
	chmod 0700 -- "$pi_agent_dir"
	config_tmp=$(mktemp "$state_root/models.json.XXXXXX") ||
		die 'cannot create temporary Pi configuration'
	# Sort generated JSON so a resumed profile is byte-stable.  Without -S,
	# jq's object insertion order differs from the first deployment and every
	# invocation needlessly rewrites the private profile file before Pi starts.
	jq -S --arg base "http://127.0.0.1:$local_port/v1" --argjson context "$context_window" '
        .providers["qwen-r9700"].baseUrl = $base
        | .providers["qwen-r9700"].models[0].contextWindow = $context
    ' "$config_source" >"$config_tmp" || die 'cannot render Pi configuration'
	config_source="$config_tmp"
fi
declare -a sampling_deploy_args=()
if ((qualification_greedy_sampling == 1)); then
	sampling_deploy_args+=(--qualification-greedy-sampling)
fi
if ((generated_config == 1)) && [[ -e $config_destination ]]; then
	# This per-profile/per-port file is generated exclusively by this wrapper.
	# Reconcile only qwen-r9700 when the tracked contract changes instead of
	# treating an older generated context cap as a user-owned conflict. The
	# deployer preserves unrelated Pi providers and top-level state atomically.
	[[ -f $config_destination && ! -L $config_destination ]] ||
		die "generated Pi configuration is not a regular file: $config_destination"
	[[ $(stat -c '%u' -- "$config_destination") == "$(id -u)" ]] ||
		die "generated Pi configuration has the wrong owner: $config_destination"
	"$deploy_script" --replace-provider --source "$config_source" \
		"${sampling_deploy_args[@]}" \
		--destination "$config_destination" >/dev/null
else
	"$deploy_script" --source "$config_source" "${sampling_deploy_args[@]}" \
		--destination "$config_destination" >/dev/null
fi
if ((qualification_greedy_sampling == 1)); then
	expected_sampling='{"temperature":0,"top_p":1,"top_k":1}'
else
	expected_sampling='{"temperature":1.0,"top_p":0.95,"top_k":40}'
fi
jq -e --arg model "$SERVED_MODEL" --argjson expected "$expected_sampling" '
    [.providers["qwen-r9700"].models[]? | select(.id == $model)] as $models
    | (($models | length) == 1 and $models[0].samplingParams == $expected)
' "$config_destination" >/dev/null ||
	die "deployed Pi sampling parameters do not match the selected mode: $config_destination"
if ((qualification_greedy_sampling == 1)); then
	printf 'Pi sampling: %s; thinking=%s\n' "$qualification_sampling_label" "$thinking" >&2
fi

# Pi 0.84.2 aborts an otherwise healthy streaming request when no response
# bytes arrive for its default five-minute HTTP idle interval.  A genuinely
# cold 249,957-token prefill can exceed that interval before the first SSE
# event, so disable only this generated qualification profile's idle timer.
# The normal ~/.pi/agent settings and every other generated profile retain
# Pi's bounded default.
if [[ ($profile == agent262 || $profile == live47 || $profile == live47-dense || $profile == unique || $profile == coding-turbo-quest96) &&
	$experimental_262k == 1 && $generated_config == 1 ]]; then
	settings_destination="$pi_agent_dir/settings.json"
	settings_exists=0
	settings_needs_write=1
	if [[ -e $settings_destination || -L $settings_destination ]]; then
		settings_exists=1
		[[ -f $settings_destination && ! -L $settings_destination ]] ||
			die "generated Pi settings are not a regular file: $settings_destination"
		[[ $(stat -c '%u' -- "$settings_destination") == "$(id -u)" ]] ||
			die "generated Pi settings have the wrong owner: $settings_destination"
		jq -e 'type == "object"' "$settings_destination" >/dev/null ||
			die "generated Pi settings are not a valid JSON object: $settings_destination"
		if jq -e '.httpIdleTimeoutMs == 0' "$settings_destination" >/dev/null; then
			settings_needs_write=0
		fi
	fi
	if ((settings_needs_write == 1)); then
		settings_tmp=$(mktemp "$pi_agent_dir/settings.json.next.XXXXXX") ||
			die 'cannot create generated Pi settings replacement'
		if ((settings_exists == 1)); then
			jq -S '.httpIdleTimeoutMs = 0' "$settings_destination" >"$settings_tmp" ||
				die 'cannot reconcile generated Pi settings'
		else
			jq -n -S '{httpIdleTimeoutMs: 0}' >"$settings_tmp" ||
				die 'cannot render generated Pi settings'
		fi
		chmod 0600 -- "$settings_tmp"
		mv -fT -- "$settings_tmp" "$settings_destination"
		settings_tmp=''
	fi
	[[ -f $settings_destination && ! -L $settings_destination ]] ||
		die "generated Pi settings did not publish as a regular file: $settings_destination"
	[[ $(stat -c '%u' -- "$settings_destination") == "$(id -u)" ]] ||
		die "published Pi settings have the wrong owner: $settings_destination"
	jq -e 'type == "object" and .httpIdleTimeoutMs == 0' \
		"$settings_destination" >/dev/null ||
		die "published Pi settings did not disable the HTTP idle timeout: $settings_destination"
	if ((coding_turbo_quest96 == 1)); then
		printf 'Pi HTTP idle timeout: disabled for coding-turbo-quest96 cold prefill\n' >&2
	elif ((snapshot_resume == 1)); then
		printf 'Pi HTTP idle timeout: disabled for %s snapshot resume\n' "$profile" >&2
	elif ((unique_lane == 1)); then
		printf 'Pi HTTP idle timeout: disabled for UNIQUE cold prefill\n' >&2
	else
		printf 'Pi HTTP idle timeout: disabled for agent262 cold prefill\n' >&2
	fi
fi

# Validate a snapshot transcript before doing any remote preflight or starting
# a model.  This catches malformed/short sessions locally.  The remote runtime
# still authenticates token identity. The Pi extension also checks the outgoing
# token prefix before any generation request and aborts instead of cold-filling.
# Historical Pi stores were split by profile and port. Resolve every selector
# through the current development folder's model-neutral .pi/sessions store.
# The helper migrates standard legacy names as hard links without opening them.
resolve_session_reference() {
	local i arg value replacement found=0
	local project_cwd
	project_cwd=$(pwd -P)
	for ((i = 0; i < ${#pi_extra_args[@]}; i++)); do
		arg=${pi_extra_args[i]}
		if [[ $arg == --session=* ]]; then
			value=${arg#--session=}
		elif [[ $arg == --session ]]; then
			((i + 1 < ${#pi_extra_args[@]})) || die '--session requires a value'
			i=$((i + 1))
			value=${pi_extra_args[i]}
		else
			continue
		fi
		((found += 1))
		((found == 1)) || die 'only one --session argument is supported'
		if [[ $value == /* ]]; then
			replacement=$value
		else
			replacement=$("$history_program" resolve "$value" --cwd "$project_cwd") ||
				die "cannot resolve project session: $value"
		fi
		if [[ $arg == --session=* ]]; then
			pi_extra_args[i]="--session=$replacement"
		else
			pi_extra_args[i]=$replacement
		fi
		printf 'resolved Pi session %s to %s\n' "$value" "$replacement" >&2
	done
}

validate_snapshot_session_reference() {
	((snapshot_resume == 1)) || return 0
	local i arg value observed_input
	local session_count=0
	for ((i = 0; i < ${#pi_extra_args[@]}; i++)); do
		arg=${pi_extra_args[i]}
		if [[ $arg == --session=* ]]; then
			value=${arg#--session=}
		elif [[ $arg == --session ]] && ((i + 1 < ${#pi_extra_args[@]})); then
			i=$((i + 1))
			value=${pi_extra_args[i]}
		else
			continue
		fi
		session_count=$((session_count + 1))
		resolved_snapshot_session_file=$value
	done
	((session_count == 1)) ||
		die '--snapshot-resume requires exactly one --session transcript'
	[[ -f $resolved_snapshot_session_file && ! -L $resolved_snapshot_session_file ]] ||
		die "snapshot transcript is not a regular file: $resolved_snapshot_session_file"
	observed_input=$(jq -r '
		select(
			.type == "message"
			and ((.message.usage.input? // null) | type) == "number"
			and (.message.usage.input > 0)
		)
		| .message.usage.input
	' "$resolved_snapshot_session_file" | tail -n 1)
	local minimum_input=60298
	((snapshot_active_pointer == 1 || snapshot_capture == 1)) &&
		minimum_input=$SNAPSHOT_STAGE_MINIMUM_TOKENS
	if [[ ! $observed_input =~ ^[0-9]+$ ]]; then
		die "snapshot transcript has input token count ${observed_input:-unknown}; expected at least $minimum_input"
	fi
	if ((10#$observed_input < 10#$minimum_input)); then
		die "snapshot transcript has input token count $observed_input; expected at least $minimum_input"
	fi
}

resolve_active_chat_pointer() {
	((snapshot_contract_auto == 1 && snapshot_capture == 0)) || return 0
	local pointer_root="$state_root/active-chats"
	[[ -e $pointer_root || -L $pointer_root ]] || return 0
	[[ -d $pointer_root && ! -L $pointer_root &&
		$(stat -c '%u:%a' -- "$pointer_root") == "$(id -u):700" ]] ||
		die "active-chat pointer root is unsafe: $pointer_root"
	[[ -f $ACTIVE_CHAT_POINTER_PROGRAM && ! -L $ACTIVE_CHAT_POINTER_PROGRAM &&
		$(stat -c '%u:%a:%h' -- "$ACTIVE_CHAT_POINTER_PROGRAM") == "$(id -u):755:1" ]] ||
		die "active-chat pointer resolver is unsafe: $ACTIVE_CHAT_POINTER_PROGRAM"
	[[ $(sha256sum -- "$ACTIVE_CHAT_POINTER_PROGRAM" | awk '{print $1}') == "$ACTIVE_CHAT_POINTER_SHA256" ]] ||
		die "active-chat pointer resolver bytes differ: $ACTIVE_CHAT_POINTER_PROGRAM"

	local i arg requested pointer_json pointer_status active_path pointer_prompt_abi
	local pointer_session pointer_branch pointer_manifest pointer_compaction_manifest
	local pointer_compaction_manifest_sha256
	local session_count=0
	for ((i = 0; i < ${#pi_extra_args[@]}; i++)); do
		arg=${pi_extra_args[i]}
		if [[ $arg == --session=* ]]; then
			requested=${arg#--session=}
		elif [[ $arg == --session ]] && ((i + 1 < ${#pi_extra_args[@]})); then
			i=$((i + 1))
			requested=${pi_extra_args[i]}
		else
			continue
		fi
		session_count=$((session_count + 1))
	done
	((session_count == 1)) || return 0
	# Leave ordinary transcript validation to validate_snapshot_session_reference().
	# The pointer resolver authenticates JSONL contents, so invoking it on a missing
	# path would otherwise replace the clearer local regular-file error.
	[[ -f $requested && ! -L $requested ]] || return 0

	set +e
	pointer_json=$(
		"$ACTIVE_CHAT_POINTER_PROGRAM" resolve --root "$pointer_root" --session "$requested"
	)
	pointer_status=$?
	set -e
	case $pointer_status in
	0) ;;
	3) return 0 ;;
	*) die "active-chat pointer authentication failed for $requested" ;;
	esac
	read -r active_path pointer_prompt_abi pointer_session pointer_branch pointer_manifest \
		pointer_compaction_manifest pointer_compaction_manifest_sha256 < <(
			jq -er '
			select(
			(.schema == "urn:qwen-r9700:active-chat-pointer:v1"
			 or .schema == "urn:qwen-r9700:active-chat-pointer:v2"
			 or .schema == "urn:qwen-r9700:active-chat-pointer:v3")
				and (.active_transcript.path | type == "string" and startswith("/"))
				and (.prompt_abi | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"))
				and (.snapshot.session_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"))
				and (.snapshot.branch | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"))
				and (.snapshot.manifest_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
				and (.compaction_manifest.path | type == "string" and startswith("/"))
				and (.compaction_manifest.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			)
			| [.active_transcript.path, .prompt_abi, .snapshot.session_id,
			   .snapshot.branch, .snapshot.manifest_sha256, .compaction_manifest.path,
			   .compaction_manifest.sha256] | @tsv
		' <<<"$pointer_json"
		) || die 'active-chat pointer resolver returned an invalid contract'
	[[ $pointer_prompt_abi == "$TOOL_ARCHIVE_PROMPT_ABI" ||
		$pointer_prompt_abi == "$OUTCOME_PROMPT_ABI" ]] ||
		die "active-chat pointer uses unsupported transactional prompt ABI: $pointer_prompt_abi"

	for ((i = 0; i < ${#pi_extra_args[@]}; i++)); do
		arg=${pi_extra_args[i]}
		if [[ $arg == --session=* ]]; then
			pi_extra_args[i]="--session=$active_path"
			break
		fi
		if [[ $arg == --session ]] && ((i + 1 < ${#pi_extra_args[@]})); then
			pi_extra_args[i + 1]=$active_path
			break
		fi
	done
	snapshot_prompt_abi=$pointer_prompt_abi
	snapshot_session_id=$pointer_session
	snapshot_branch=$pointer_branch
	snapshot_manifest_sha256=$pointer_manifest
	active_chat_compaction_manifest=$pointer_compaction_manifest
	active_chat_compaction_manifest_sha256=$pointer_compaction_manifest_sha256
	snapshot_active_pointer=1
	printf 'selected atomic active-chat pointer: %s -> %s/%s anchor=%s (%s)\n' \
		"$active_path" "$snapshot_session_id" "$snapshot_branch" \
		"$snapshot_manifest_sha256" "$snapshot_prompt_abi" >&2
}

select_snapshot_contract_for_session() {
	((snapshot_contract_auto == 1)) || return 0
	if ((snapshot_active_pointer == 1)); then
		printf 'using pointer-selected snapshot branch %s/%s (prompt ABI %s)\n' \
			"$snapshot_session_id" "$snapshot_branch" "$snapshot_prompt_abi" >&2
		return 0
	fi
	local base session_uuid
	base=${resolved_snapshot_session_file##*/}
	if [[ $base =~ _([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})\.jsonl$ ]]; then
		session_uuid=${BASH_REMATCH[1],,}
	else
		die "cannot derive a Pi session UUID from snapshot transcript filename: $base"
	fi
	case $snapshot_prompt_abi in
	"$BASE_PROMPT_ABI") snapshot_session_id="pi-$session_uuid" ;;
	"$SEARCHTOOL_PROMPT_ABI") snapshot_session_id="pi-$session_uuid-$SEARCHTOOL_PROMPT_ABI" ;;
	"$TOOL_ARCHIVE_PROMPT_ABI") snapshot_session_id="pi-$session_uuid-$TOOL_ARCHIVE_PROMPT_ABI" ;;
	"$OUTCOME_PROMPT_ABI") snapshot_session_id="pi-$session_uuid-$OUTCOME_PROMPT_ABI" ;;
	esac
	snapshot_branch=$DEFAULT_SNAPSHOT_BRANCH
	# An empty expected manifest instructs the remote verifier to select and
	# authenticate this session's current immutable branch head.
	snapshot_manifest_sha256=''
	printf 'selecting chat-specific snapshot branch %s/%s (prompt ABI %s)\n' \
		"$snapshot_session_id" "$snapshot_branch" "$snapshot_prompt_abi" >&2
}

reject_active_pointer_branch_alias() {
	((snapshot_resume == 1 && snapshot_active_pointer == 0)) || return 0
	local pointer_root="$state_root/active-chats" collision_status
	[[ -e $pointer_root || -L $pointer_root ]] || return 0
	set +e
	PYTHONDONTWRITEBYTECODE=1 python3 - "$pointer_root" "$snapshot_session_id" \
		"$snapshot_branch" <<'PY'
from __future__ import annotations

import json
import os
import re
import stat
import sys
from pathlib import Path


root = Path(sys.argv[1])
session_id, branch = sys.argv[2:]
metadata = os.lstat(root)
if (
    not stat.S_ISDIR(metadata.st_mode)
    or metadata.st_uid != os.getuid()
    or stat.S_IMODE(metadata.st_mode) != 0o700
):
    raise SystemExit(2)
for entry in os.scandir(root):
    path = Path(entry.path)
    if entry.name == ".switch.lock" or re.fullmatch(
        r"\.compaction-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\.lock",
        entry.name,
    ):
        lock = os.lstat(path)
        if (
            not stat.S_ISREG(lock.st_mode)
            or lock.st_uid != os.getuid()
            or lock.st_nlink != 1
            or stat.S_IMODE(lock.st_mode) != 0o600
            or lock.st_size != 0
        ):
            raise SystemExit(2)
        continue
    if not entry.name.endswith(".json") or entry.is_symlink() or not entry.is_file(follow_symlinks=False):
        raise SystemExit(2)
    before = os.lstat(path)
    if (
        before.st_uid != os.getuid()
        or before.st_nlink != 1
        or stat.S_IMODE(before.st_mode) != 0o600
        or not 1 <= before.st_size <= 4 * 1024 * 1024
    ):
        raise SystemExit(2)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        raise SystemExit(2)
    after = os.lstat(path)
    if (
        before.st_dev,
        before.st_ino,
        before.st_size,
        before.st_mtime_ns,
        before.st_ctime_ns,
    ) != (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
    ):
        raise SystemExit(2)
    snapshot = value.get("snapshot") if isinstance(value, dict) else None
    if not isinstance(snapshot, dict):
        raise SystemExit(2)
    if snapshot.get("session_id") == session_id and snapshot.get("branch") == branch:
        raise SystemExit(1)
PY
	collision_status=$?
	set -e
	case $collision_status in
	0) ;;
	1) die 'explicit snapshot branch aliases an active production chat; use its active-chat pointer or an isolated qualification branch' ;;
	*) die 'active-chat pointer namespace is unsafe or malformed during branch-alias validation' ;;
	esac
}

configure_tool_turn_rehydration() {
	[[ -n $resolved_snapshot_session_file ]] || return 0
	local session_directory compaction_root manifest expected_sha observed_sha expected_bytes observed_bytes
	local observed_manifest_sha256
	local expected_id observed_id archive_root algorithm_root manifest_schema tool_manifest
	local transaction_root
	local manifest_authentication tool_source_session tool_authentication
	local tool_manifest_sha tool_manifest_bytes tool_source_path tool_source_sha tool_source_bytes
	local history_query_path history_query_sha history_query_bytes
	session_directory=${resolved_snapshot_session_file%/*}
	[[ $session_directory != "$resolved_snapshot_session_file" ]] || return 0
	compaction_root=${session_directory%/*}
	[[ $compaction_root != "$session_directory" ]] || return 0
	if ((snapshot_derived_manifest_explicit == 1)); then
		manifest=$snapshot_derived_manifest
	elif ((snapshot_active_pointer == 1)); then
		[[ -n $active_chat_compaction_manifest &&
			$active_chat_compaction_manifest_sha256 =~ ^[0-9a-f]{64}$ ]] ||
			die 'active-chat pointer did not retain its authenticated compaction manifest'
		manifest=$active_chat_compaction_manifest
	else
		manifest="$compaction_root/manifest.json"
	fi
	[[ -e $manifest || -L $manifest ]] || return 0
	[[ -f $manifest && ! -L $manifest ]] ||
		die "compacted-session manifest is not a regular file: $manifest"
	[[ $(stat -c '%u:%a:%h' -- "$manifest") == "$(id -u):600:1" ]] ||
		die "compacted-session manifest has unsafe ownership or mode: $manifest"
	manifest_schema=$(jq -er '.schema | select(type == "string")' "$manifest") ||
		die "compacted-session manifest schema is invalid: $manifest"
	if ((snapshot_derived_manifest_explicit == 1)) &&
		[[ $manifest_schema != qwen-pi-structured-outcome-migration-v1 ]]; then
		die 'explicit snapshot migration manifest has the wrong schema'
	fi
	if [[ $manifest_schema == qwen-pi-structured-outcome-migration-v1 ]]; then
		[[ -f $ACTIVE_CHAT_POINTER_PROGRAM && ! -L $ACTIVE_CHAT_POINTER_PROGRAM &&
			$(stat -c '%u:%a:%h' -- "$ACTIVE_CHAT_POINTER_PROGRAM") == "$(id -u):755:1" ]] ||
			die "active-chat manifest authenticator is unsafe: $ACTIVE_CHAT_POINTER_PROGRAM"
		[[ $(sha256sum -- "$ACTIVE_CHAT_POINTER_PROGRAM" | awk '{print $1}') == "$ACTIVE_CHAT_POINTER_SHA256" ]] ||
			die "active-chat manifest authenticator bytes differ: $ACTIVE_CHAT_POINTER_PROGRAM"
		manifest_authentication=$(
			"$ACTIVE_CHAT_POINTER_PROGRAM" authenticate-manifest \
				--manifest "$manifest" --active-session "$resolved_snapshot_session_file"
		) || die 'snapshot migration manifest authentication failed'
		jq -e --arg manifest "$manifest" --arg session "$resolved_snapshot_session_file" '
			.schema == "qwen-pi-structured-outcome-migration-v1"
			and .manifest.path == $manifest
			and (.manifest.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			and .active_session.path == $session
			and (.active_session.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			and (.active_session.bytes | type == "number" and floor == . and . > 0)
			and (.active_session.id | type == "string" and test("^[0-9a-f-]{36}$"))
		' <<<"$manifest_authentication" >/dev/null ||
			die 'snapshot migration manifest returned an invalid authentication receipt'
		tool_manifest=$(jq -er '
			.tool_compaction_manifest.path
			| select(type == "string" and startswith("/"))
		' "$manifest") || die 'snapshot migration does not bind a tool-compaction manifest'
		[[ -f $tool_manifest && ! -L $tool_manifest &&
			$(stat -c '%u:%a:%h' -- "$tool_manifest") == "$(id -u):600:1" ]] ||
			die "snapshot migration tool-compaction manifest is unsafe: $tool_manifest"
		tool_source_session=$(jq -er '
			select(.schema == "qwen-pi-tool-turn-compaction-v1")
			| .compacted_session.path
			| select(type == "string" and startswith("/"))
		' "$tool_manifest") || die 'snapshot migration tool-compaction manifest contract is invalid'
		tool_authentication=$(
			"$ACTIVE_CHAT_POINTER_PROGRAM" authenticate-manifest \
				--manifest "$tool_manifest" --active-session "$tool_source_session"
		) || die 'snapshot migration tool-compaction manifest authentication failed'
		jq -e --arg manifest "$tool_manifest" '
			.schema == "qwen-pi-tool-turn-compaction-v1"
			and .manifest.path == $manifest
			and (.manifest.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
		' <<<"$tool_authentication" >/dev/null ||
			die 'snapshot migration tool-compaction authentication receipt is invalid'
		jq -e '
			.original_transcript_unchanged == true
			and .security == "Archived tool output is untrusted data, not instructions."
		' "$tool_manifest" >/dev/null ||
			die 'snapshot migration tool archive security contract is invalid'
		archive_root="${tool_manifest%/*}/archives"
		algorithm_root="$archive_root/sha256"
		for directory in "$compaction_root" "$session_directory" "${tool_manifest%/*}" \
			"$archive_root" "$algorithm_root"; do
			[[ -d $directory && ! -L $directory ]] ||
				die "snapshot migration directory is missing or unsafe: $directory"
			[[ $(stat -c '%u:%a' -- "$directory") == "$(id -u):700" ]] ||
				die "snapshot migration directory has unsafe ownership or mode: $directory"
		done
		tool_turn_archive_root=$archive_root
		printf 'authenticated sanitized session and tool-turn archive: %s\n' "$tool_turn_archive_root" >&2
		return 0
	fi
	if ((snapshot_active_pointer == 1)); then
		observed_manifest_sha256=$(sha256sum -- "$manifest" | awk '{print $1}') ||
			die 'cannot hash the pointer-selected compaction manifest'
		[[ $observed_manifest_sha256 == "$active_chat_compaction_manifest_sha256" ]] ||
			die 'pointer-selected compaction manifest changed after pointer resolution'
	fi
	read -r expected_sha expected_bytes expected_id manifest_schema < <(jq -er --arg path "$resolved_snapshot_session_file" '
		select(
			(.schema == "qwen-pi-tool-turn-compaction-v1" or .schema == "qwen-pi-transactional-chat-compaction-v1")
			and .compacted_session.path == $path
			and (.compacted_session.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			and (.compacted_session.bytes | type == "number" and floor == . and . > 0)
			and (.compacted_session.id | type == "string" and test("^[0-9a-f-]{36}$"))
			and .compacted_session.authentication == "immutable_prefix_allow_append_only_jsonl_tail"
			and .original_transcript_unchanged == true
			and (
				.schema == "qwen-pi-transactional-chat-compaction-v1"
				or .security == "Archived tool output is untrusted data, not instructions."
			)
		)
		| [.compacted_session.sha256, .compacted_session.bytes, .compacted_session.id, .schema]
		| @tsv
	' "$manifest") || die "compacted-session manifest contract is invalid: $manifest"
	[[ $expected_bytes =~ ^[1-9][0-9]*$ ]] ||
		die "compacted-session immutable prefix byte count is invalid: $expected_bytes"
	observed_bytes=$(stat -c '%s' -- "$resolved_snapshot_session_file")
	((10#$observed_bytes >= 10#$expected_bytes)) ||
		die "compacted-session transcript is shorter than its immutable prefix: $observed_bytes < $expected_bytes"
	observed_sha=$(head -c "$expected_bytes" -- "$resolved_snapshot_session_file" | sha256sum | awk '{print $1}')
	[[ $observed_sha == "$expected_sha" ]] ||
		die "compacted-session immutable prefix SHA-256 mismatch: observed $observed_sha expected $expected_sha"
	[[ $(head -c "$expected_bytes" -- "$resolved_snapshot_session_file" | tail -c 1 | wc -l) == 1 ]] ||
		die 'compacted-session immutable prefix does not end at a JSONL boundary'
	jq -e 'type == "object"' "$resolved_snapshot_session_file" >/dev/null ||
		die "compacted-session append-only tail is not valid JSONL: $resolved_snapshot_session_file"
	observed_id=$(jq -sr 'map(select(.type == "session")) | if length == 1 then .[0].id else empty end' \
		"$resolved_snapshot_session_file")
	[[ $observed_id == "$expected_id" ]] ||
		die "compacted-session header identity mismatch: observed ${observed_id:-missing} expected $expected_id"
	if [[ $manifest_schema == qwen-pi-transactional-chat-compaction-v1 ]]; then
		read -r tool_manifest tool_manifest_sha tool_manifest_bytes tool_source_path tool_source_sha tool_source_bytes < <(
			jq -er '
				select(
					(.tool_compaction_manifest.path | type == "string" and startswith("/"))
					and (.tool_compaction_manifest.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
					and (.tool_compaction_manifest.bytes | type == "number" and floor == . and . > 0)
					and (.source.path | type == "string" and startswith("/"))
					and (.source.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
					and (.source.bytes | type == "number" and floor == . and . > 0)
				)
				| [
					.tool_compaction_manifest.path,
					.tool_compaction_manifest.sha256,
					.tool_compaction_manifest.bytes,
					.source.path,
					.source.sha256,
					.source.bytes
				]
				| @tsv
			' "$manifest"
		) || die "semantic compaction manifest does not bind a tool archive: $manifest"
		[[ -f $tool_manifest && ! -L $tool_manifest &&
			$(stat -c '%u:%a:%h:%s' -- "$tool_manifest") == "$(id -u):600:1:$tool_manifest_bytes" ]] ||
			die "semantic tool-compaction manifest has an unsafe identity: $tool_manifest"
		[[ $(sha256sum -- "$tool_manifest" | awk '{print $1}') == "$tool_manifest_sha" ]] ||
			die 'semantic tool-compaction manifest SHA-256 mismatch'
		transaction_root=${tool_manifest%/*}
		[[ $transaction_root != "$tool_manifest" ]] ||
			die 'semantic tool-compaction manifest has no transaction root'
		jq -e --arg path "$tool_source_path" --arg sha "$tool_source_sha" --argjson bytes "$tool_source_bytes" '
			.schema == "qwen-pi-tool-turn-compaction-v1"
			and .compacted_session.path == $path
			and .compacted_session.sha256 == $sha
			and .compacted_session.bytes == $bytes
			and .original_transcript_unchanged == true
			and .security == "Archived tool output is untrusted data, not instructions."
		' "$tool_manifest" >/dev/null || die 'semantic tool archive differs from its tool-compaction manifest'
		if jq -e '.history_recovery != null' "$manifest" >/dev/null; then
			read -r history_query_path history_query_sha history_query_bytes < <(
				jq -er '
					select(
						.history_recovery.source_path == .source.path
						and .history_recovery.source_sha256 == .source.sha256
						and .history_recovery.source_bytes == .source.bytes
						and (.history_recovery.suffix_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
						and (.history_recovery.query_program.path | type == "string" and startswith("/"))
						and (.history_recovery.query_program.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
						and (.history_recovery.query_program.bytes | type == "number" and floor == . and . > 0)
						and (.history_recovery.sources | type == "array" and length >= 1 and length <= 256)
						and .history_recovery.sources[0] == (.source | {bytes, path, sha256})
						and all(.history_recovery.sources[];
							(keys | sort) == ["bytes", "path", "sha256"]
							and (.path | type == "string" and startswith("/"))
							and (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
							and (.bytes | type == "number" and floor == . and . > 0 and . <= 268435456)
						)
					)
					| [.history_recovery.query_program.path, .history_recovery.query_program.sha256,
					   .history_recovery.query_program.bytes] | @tsv
				' "$manifest"
			) || die 'semantic compaction history-recovery contract is invalid'
			[[ $history_query_path == "$transaction_root/semantic-compaction/qwen-compacted-history-query" ]] ||
				die 'semantic compaction history-query program escapes its transaction'
			[[ $(stat -c '%u:%a:%h:%s' -- "$history_query_path") == "$(id -u):755:1:$history_query_bytes" &&
			$(sha256sum -- "$history_query_path" | awk '{print $1}') == "$history_query_sha" ]] ||
				die 'semantic compaction history-query program authentication failed'
			semantic_history_manifest=$manifest
			semantic_history_manifest_sha256=$(sha256sum -- "$manifest" | awk '{print $1}')
		fi
		archive_root="${tool_manifest%/*}/archives"
	else
		archive_root="$compaction_root/archives"
	fi
	algorithm_root="$archive_root/sha256"
	for directory in "$compaction_root" "$session_directory" ${transaction_root:+"$transaction_root"} \
		"$archive_root" "$algorithm_root"; do
		[[ -d $directory && ! -L $directory ]] ||
			die "compacted-session directory is missing or unsafe: $directory"
		[[ $(stat -c '%u' -- "$directory") == "$(id -u)" && $(stat -c '%a' -- "$directory") == 700 ]] ||
			die "compacted-session directory has unsafe ownership or mode: $directory"
	done
	tool_turn_archive_root=$archive_root
	printf 'authenticated compacted tool-turn archive: %s\n' "$tool_turn_archive_root" >&2
}

prepare_snapshot_bootstrap_clone() {
	((snapshot_capture == 1)) || return 0
	local base session_uuid clone_timestamp i arg
	base=${resolved_snapshot_session_file##*/}
	if [[ $base =~ _([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})\.jsonl$ ]]; then
		session_uuid=${BASH_REMATCH[1],,}
	else
		die "cannot derive a Pi session UUID for the bootstrap clone: $base"
	fi
	clone_timestamp=$(date -u +%Y%m%dT%H%M%SZ)
	[[ $clone_timestamp =~ ^[0-9]{8}T[0-9]{6}Z$ ]] ||
		die 'bootstrap clone timestamp is invalid'
	bootstrap_session_clone="$snapshot_stage_transaction_root/bootstrap-clone-${clone_timestamp}_${session_uuid}.jsonl"
	[[ ! -e $bootstrap_session_clone && ! -L $bootstrap_session_clone ]] ||
		die "bootstrap session clone already exists: $bootstrap_session_clone"
	cp --reflink=auto -- "$resolved_snapshot_session_file" "$bootstrap_session_clone"
	chmod 0600 -- "$bootstrap_session_clone"
	[[ -f $bootstrap_session_clone && ! -L $bootstrap_session_clone &&
		$(stat -c '%u:%a:%h' -- "$bootstrap_session_clone") == "$(id -u):600:1" ]] ||
		die "bootstrap session clone has unsafe identity: $bootstrap_session_clone"
	cmp --silent -- "$resolved_snapshot_session_file" "$bootstrap_session_clone" ||
		die 'bootstrap session clone differs before Pi launch'
	for ((i = 0; i < ${#pi_extra_args[@]}; i++)); do
		arg=${pi_extra_args[i]}
		if [[ $arg == --session=* ]]; then
			pi_extra_args[i]="--session=$bootstrap_session_clone"
			printf 'using ephemeral append-isolated bootstrap clone: %s\n' "$bootstrap_session_clone" >&2
			return 0
		fi
		if [[ $arg == --session ]] && ((i + 1 < ${#pi_extra_args[@]})); then
			pi_extra_args[i + 1]=$bootstrap_session_clone
			printf 'using ephemeral append-isolated bootstrap clone: %s\n' "$bootstrap_session_clone" >&2
			return 0
		fi
	done
	die '--snapshot-bootstrap could not locate the validated Pi session argument'
}

prepare_snapshot_exit_flush() {
	((snapshot_resume == 1 && snapshot_capture == 0 && snapshot_active_pointer == 1)) || return 0
	snapshot_exit_flush=1
	local flush_parent adapter_candidate verifier_sha256
	flush_parent="$state_root/snapshot-exit-flush-v1"
	ensure_protected_directory "$flush_parent"
	ensure_protected_directory "$flush_parent/$snapshot_prompt_abi"
	ensure_protected_directory "$flush_parent/$snapshot_prompt_abi/$snapshot_session_id"
	snapshot_exit_flush_root="$flush_parent/$snapshot_prompt_abi/$snapshot_session_id/$snapshot_branch"
	ensure_protected_directory "$snapshot_exit_flush_root"
	snapshot_exit_token_root="$snapshot_exit_flush_root/latest-tokens"
	ensure_protected_directory "$snapshot_exit_token_root"
	ensure_protected_directory "$snapshot_exit_token_root/vectors"
	snapshot_exit_latest_receipt="$snapshot_exit_token_root/latest.json"
	snapshot_exit_plan_root="$snapshot_exit_flush_root/plans"
	ensure_protected_directory "$snapshot_exit_plan_root"
	snapshot_exit_journal_root="$snapshot_exit_flush_root/journal"
	ensure_protected_directory "$snapshot_exit_journal_root"
	snapshot_exit_verifier_source="$snapshot_exit_flush_root/qwen-snapshot-verify.py"
	snapshot_exit_remote_verifier="$snapshot_exit_flush_root/remote-verifier"
	snapshot_background_run_id="run-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
	[[ $snapshot_background_run_id =~ ^run-[0-9a-f]{32}$ ]] ||
		die 'cannot create a background snapshot publication run ID'
	snapshot_background_log="$snapshot_exit_flush_root/background-publisher-$snapshot_background_run_id.log"
	[[ ! -e $snapshot_background_log && ! -L $snapshot_background_log ]] ||
		die 'snapshot background publisher log already exists'
	(umask 077 && set -o noclobber && : >"$snapshot_background_log") ||
		die 'cannot create the protected snapshot background publisher log'
	[[ -f $snapshot_background_log && ! -L $snapshot_background_log &&
		$(stat -c '%u:%a:%h' -- "$snapshot_background_log") == "$(id -u):600:1" ]] ||
		die 'snapshot background publisher log has an unsafe identity'
	[[ -f $SNAPSHOT_BACKGROUND_PUBLISHER && ! -L $SNAPSHOT_BACKGROUND_PUBLISHER &&
		$(stat -c '%u:%a:%h' -- "$SNAPSHOT_BACKGROUND_PUBLISHER") == "$(id -u):755:1" ]] ||
		die 'snapshot background publisher has an unsafe identity'
	[[ $(sha256sum -- "$SNAPSHOT_BACKGROUND_PUBLISHER" | awk '{print $1}') == "$SNAPSHOT_BACKGROUND_PUBLISHER_SHA256" ]] ||
		die 'snapshot background publisher differs from the pinned ABI'
	verifier_sha256=$(seal_snapshot_program \
		"$SNAPSHOT_VERIFY_SCRIPT" "$snapshot_exit_verifier_source" 0755 0400 \
		'snapshot exit-flush verifier source') ||
		die 'cannot seal the snapshot exit-flush verifier source'
	[[ $verifier_sha256 == "$SNAPSHOT_VERIFY_SHA256" ]] ||
		die 'snapshot exit-flush verifier differs from the pinned ABI'
	adapter_candidate=$(mktemp "$snapshot_exit_flush_root/.remote-verifier.XXXXXX") ||
		die 'cannot create snapshot exit-flush verifier adapter candidate'
	chmod 0600 -- "$adapter_candidate"
	{
		printf '%s\n' '#!/usr/bin/env bash' '' 'set -euo pipefail' ''
		printf 'readonly VERIFY_SOURCE=%q\n' "$snapshot_exit_verifier_source"
		printf 'readonly VERIFY_SOURCE_SHA256=%q\n' "$verifier_sha256"
		cat <<'REMOTE_EXIT_VERIFIER_ADAPTER'
readonly VERIFY_REMOTE_HOST='lewis@ai'
[[ -f $VERIFY_SOURCE && ! -L $VERIFY_SOURCE ]] || exit 2
[[ $(stat -c '%u:%a:%h' -- "$VERIFY_SOURCE") == "$UID:400:1" ]] || exit 2
[[ $(sha256sum -- "$VERIFY_SOURCE" | awk '{print $1}') == "$VERIFY_SOURCE_SHA256" ]] || exit 2
for argument in "$@"; do
	if [[ $argument == --* ]]; then
		[[ $argument =~ ^--[a-z0-9-]+$ ]] || exit 64
	elif [[ $argument == /* ]]; then
		[[ $argument =~ ^/[A-Za-z0-9._/-]+$ ]] || exit 64
	else
		[[ $argument =~ ^[A-Za-z0-9._-]+$ ]] || exit 64
	fi
done
exec ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 \
	"$VERIFY_REMOTE_HOST" /usr/bin/python3 - "$@" <"$VERIFY_SOURCE"
REMOTE_EXIT_VERIFIER_ADAPTER
	} >"$adapter_candidate"
	publish_or_validate_snapshot_adapter "$SNAPSHOT_STAGE_CONTROLLER" \
		"$adapter_candidate" "$snapshot_exit_remote_verifier" ||
		die 'cannot publish or authenticate the snapshot exit-flush verifier adapter'
	rm -f -- "$adapter_candidate"
}

start_snapshot_background_publisher() {
	((snapshot_exit_flush == 1)) || return 0
	local ready_file="$snapshot_exit_token_root/publisher-ready.json" attempt
	local -a repost_arguments=()
	if ((snapshot_fresh_backend_authenticated == 1)); then
		repost_arguments+=(--authorize-repost-unresolved)
	fi
	"$SNAPSHOT_BACKGROUND_PUBLISHER" \
		--token-root "$snapshot_exit_token_root" \
		--plan-root "$snapshot_exit_plan_root" \
		--journal-root "$snapshot_exit_journal_root" \
		--head-advance "$SNAPSHOT_HEAD_ADVANCE" \
		--base-url "http://127.0.0.1:$local_port" \
		--snapshot-root "$REMOTE_FIXED_SLOT_CACHE_ROOT" \
		--verify-program "$snapshot_exit_remote_verifier" \
		--verify-evidence-sha256 "$SNAPSHOT_VERIFY_SHA256" \
		--session-id "$snapshot_session_id" \
		--branch "$snapshot_branch" \
		--model "$SERVED_MODEL" \
		--run-id "$snapshot_background_run_id" \
		--pi-pid "$pi_pid" \
		--pi-start-ticks "$pi_start" \
		"${repost_arguments[@]}" >>"$snapshot_background_log" 2>&1 &
	snapshot_background_pid=$!
	snapshot_background_start=$(awk '{print $22}' "/proc/$snapshot_background_pid/stat" 2>/dev/null || true)
	[[ $snapshot_background_start =~ ^[1-9][0-9]*$ ]] ||
		die 'cannot authenticate the snapshot background publisher start time'
	for ((attempt = 1; attempt <= 50; attempt++)); do
		if ! owned_snapshot_background_publisher; then
			set +e
			wait "$snapshot_background_pid"
			snapshot_background_status=$?
			set -e
			die "snapshot background publisher exited before readiness (status $snapshot_background_status; log $snapshot_background_log)"
		fi
		if [[ -f $ready_file && ! -L $ready_file &&
			$(stat -c '%u:%a:%h' -- "$ready_file") == "$(id -u):600:1" ]] &&
			jq -e --arg run "$snapshot_background_run_id" --argjson pid "$snapshot_background_pid" '
			.schema == "urn:qwen-r9700:snapshot-background-publisher-ready:v1"
			and .run_id == $run and .publisher_pid == $pid and .state == "ready"
			and keys == ["publisher_pid", "run_id", "schema", "state"]
			' "$ready_file" >/dev/null; then
			return 0
		fi
		sleep 0.1
	done
	die 'snapshot background publisher did not publish an authenticated readiness receipt'
}

wait_snapshot_background_publisher() {
	((snapshot_exit_flush == 1)) || return 0
	set +e
	wait "$snapshot_background_pid"
	snapshot_background_status=$?
	set -e
	if ((snapshot_background_status != 0)); then
		if ((backend_health_lost == 1)); then
			printf 'background snapshot publication stopped after backend health loss; preserving the prior durable head\n' >&2
		else
			printf 'background snapshot publication did not finish cleanly; retrying the latest exact vector in the final drain\n' >&2
		fi
	fi
}
