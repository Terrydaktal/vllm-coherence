stop_live47_for_snapshot() {
	local api_pid api_start backend_args listener now
	local -a backend_pids=()
	mapfile -t backend_pids < <(
		ps -eo pid=,args= |
			awk '/[v]llm serve/ && /Qwen3\.8-27B-int4-AutoRound/ && /--port 8000/ {print $1}'
	)
	((${#backend_pids[@]} == 1)) || {
		printf 'snapshot replacement found %s matching Qwen backends; refusing to stop an ambiguous target\n' \
			"${#backend_pids[@]}" >&2
		exit 3
	}
	api_pid=${backend_pids[0]}
	[[ -r /proc/$api_pid/status && -r /proc/$api_pid/stat && -r /proc/$api_pid/cmdline ]] || {
		printf 'snapshot replacement target disappeared before authentication\n' >&2
		exit 3
	}
	[[ $(awk '/^Uid:/ {print $2}' "/proc/$api_pid/status" 2>/dev/null) == "$UID" ]] || {
		printf 'snapshot replacement target is not owned by the remote user\n' >&2
		exit 3
	}
	api_start=$(awk '{print $22}' "/proc/$api_pid/stat")
	[[ $api_start =~ ^[1-9][0-9]*$ ]] || {
		printf 'snapshot replacement target start time is invalid\n' >&2
		exit 3
	}
	backend_args=$(tr '\0' ' ' <"/proc/$api_pid/cmdline")
	for required in \
		'Qwen3.8-27B-int4-AutoRound' \
		'--port 8000' \
		'--enable-prefix-caching' \
		'--mamba-cache-mode none' \
		'--max-num-batched-tokens 3303' \
		'--kv-cache-memory-bytes 8728018944' \
		'"method":"dflash"' ; do
		[[ $backend_args == *"$required"* ]] || {
			printf 'snapshot replacement target failed live47 identity check: %s\n' "$required" >&2
				exit 3
			}
	done
	listener=$(ss -Hlnpt 'sport = :8000')
	[[ $listener == *"pid=$api_pid,"* ]] || {
		printf 'snapshot replacement target does not own the port-8000 listener\n' >&2
		exit 3
	}
	now=$(awk '{print $22}' "/proc/$api_pid/stat" 2>/dev/null || true)
	[[ $now == "$api_start" ]] || {
		printf 'snapshot replacement target identity changed before TERM\n' >&2
		exit 3
	}
	printf 'snapshot replacement: stopping exact live47 backend pid %s\n' "$api_pid" >&2
	# The API process owns EngineCore lifecycle. Signal the API parent once and
	# let its process manager TERM, wait for, and tear down EngineCore.
	kill -TERM "$api_pid"
	for _ in {1..30}; do
		if [[ ! -r /proc/$api_pid/stat ]]; then
			break
		fi
		now=$(awk '{print $22}' "/proc/$api_pid/stat" 2>/dev/null || true)
		[[ $now == "$api_start" ]] || {
			printf 'snapshot replacement target PID was reused during shutdown\n' >&2
			exit 3
		}
		sleep 1
	done
	if [[ -r /proc/$api_pid/stat ]] &&
		[[ $(awk '{print $22}' "/proc/$api_pid/stat" 2>/dev/null || true) == "$api_start" ]]; then
		printf 'snapshot replacement target pid %s did not exit\n' "$api_pid" >&2
		exit 3
	fi
	if command -v ss >/dev/null 2>&1; then
		for _ in {1..30}; do
			ss -Hln 'sport = :8000' | grep -q . || break
			sleep 1
		done
		ss -Hln 'sport = :8000' | grep -q . && {
			printf 'snapshot replacement: remote port 8000 remained occupied\n' >&2
			exit 3
		}
	fi
	# The final negative grep above is the successful "port is free" case, but
	# its status is 1.  Do not leak that predicate as the function's status into
	# the remote preflight's `set -e` context.
	return 0
}
if [[ $snapshot_resume == 1 ]]; then
	[[ $snapshot_session_id =~ ^[A-Za-z0-9._-]+$ && $snapshot_branch =~ ^[A-Za-z0-9._-]+$ ]] ||
		die 'snapshot identity is unsafe during remote preflight'
	ref="$fixed_slot_cache_root/.qwen-250k-cache-v1/refs/$snapshot_session_id/$snapshot_branch.json"
	[[ (! -e $ref && ! -L $ref) || (-f $ref && ! -L $ref) ]] ||
		die 'snapshot ref is not a regular non-symlink during remote preflight'
	if [[ -f $ref && ! -L $ref ]]; then
		generation=$(jq -er '.generation | select(type == "number" and floor == . and . >= 0)' "$ref") ||
			die 'snapshot ref generation is invalid during remote preflight'
	else
		generation=0
	fi
	printf -v next_generation '%020d' "$((generation + 1))"
	next_selection="/home/lewis/.local/share/qwen-r9700/cache-selections/dflash-agent262-fixed-slot-corrected-v1/selections/$snapshot_session_id/$snapshot_branch/generation-$next_generation.json"
	if [[ -e $next_selection || -L $next_selection ]]; then
		if [[ $snapshot_capture == 1 && $live62_foundation_authenticated == 1 ]]; then
			printf 'authenticated live62 orphan-finalizer will reconcile the existing next immutable selection: %s\n' \
				"$next_selection" >&2
		else
			die "next immutable snapshot selection already exists; refusing a launch that would crash EngineCore: $next_selection"
		fi
	fi
fi
if [[ $reuse_existing != 1 ]] && command -v ss >/dev/null 2>&1 && ss -Hln 'sport = :8000' | grep -q .; then
	if [[ $snapshot_resume == 1 ]]; then
		stop_live47_for_snapshot
	else
		printf 'remote port 8000 is already in use\n' >&2
		exit 3
	fi
fi
if [[ $snapshot_capture == 1 && $reuse_existing != 1 ]]; then
	# An unresolved durable stage may be reposted only after every process capable
	# of completing its old request is gone. Port closure alone is insufficient:
	# a killed API parent could have left an EngineCore child behind. Scan all
	# owned processes for the rolling-checkpoint runtime marker and fail closed.
	surviving_snapshot_processes=''
	for _ in {1..30}; do
		surviving_snapshot_processes=''
		for environment_path in /proc/[0-9]*/environ; do
			[[ -r $environment_path ]] || continue
			process_root=${environment_path%/environ}
			[[ $(stat -c '%u' -- "$process_root" 2>/dev/null || true) == "$UID" ]] || continue
			if ! process_environment=$(tr '\0' '\n' 2>/dev/null <"$environment_path"); then
				continue
			fi
			if grep -qx 'QWEN_FIXED_SLOT_ROLLING_CHECKPOINT=1' <<<"$process_environment"; then
				orphan_pid=${process_root##*/}
				orphan_args=$(tr '\0' ' ' <"$process_root/cmdline" 2>/dev/null || true)
				surviving_snapshot_processes+=" pid=$orphan_pid args=$orphan_args"
			fi
		done
		[[ -n $surviving_snapshot_processes ]] || break
		sleep 1
	done
	[[ -z $surviving_snapshot_processes ]] || {
		printf 'snapshot replacement found surviving rolling-checkpoint processes:%s\n' \
			"$surviving_snapshot_processes" >&2
		exit 3
	}
	if command -v ss >/dev/null 2>&1; then
		ss -Hln 'sport = :8000' | grep -q . && {
			printf 'snapshot replacement cannot prove remote port 8000 is free\n' >&2
			exit 3
		}
	else
		printf 'snapshot replacement requires remote ss to prove port 8000 is free\n' >&2
		exit 3
	fi
fi
if [[ $lane == mtp3 && $profile != agent262 ]]; then
	for path in \
		"$project/results/c1/stock-vllm-d626108b-patched-w4a16-mtp3-quality-v3.json" \
		"$project/results/c1/stock-vllm-d626108b-patched-w4a16-mtp3-reasoning-low-v1.json" \
		"$project/results/c1/stock-vllm-d626108b-patched-w4a16-mtp3-tool-reasoning-low-v1.json"; do
		[[ -r $path ]] || { printf 'MTP gate missing: %s\n' "$path" >&2; exit 4; }
	done
fi
