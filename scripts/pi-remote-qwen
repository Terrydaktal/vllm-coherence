if ((snapshot_resume == 1 && snapshot_capture == 0)); then
	snapshot_manifest_record=''
	snapshot_manifest_request=$snapshot_manifest_sha256
	snapshot_manifest_match=exact
	if [[ -z $snapshot_manifest_request ]]; then
		snapshot_manifest_request='AUTO'
		snapshot_manifest_match=auto
	elif ((snapshot_active_pointer == 1)); then
		# The immutable pointer binds the compacted transcript to its first
		# deeply authenticated snapshot. Normal turns subsequently grow the
		# same branch, so the pointer manifest is an ancestry anchor rather than
		# a permanently frozen branch head.
		snapshot_manifest_match=descendant
	fi
	if ! snapshot_manifest_record=$(
		ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 "$remote_host" bash -s -- \
			"$snapshot_auth_root" "$snapshot_session_id" "$snapshot_branch" \
			"$snapshot_manifest_request" "$snapshot_manifest_match" \
			"$SNAPSHOT_STAGE_MINIMUM_TOKENS" <<'REMOTE_SNAPSHOT_MANIFEST'
set -euo pipefail
python3 - "$@" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"pi-remote-qwen: {message}")


def owned_directory(path: Path) -> None:
    try:
        info = os.lstat(path)
    except OSError as error:
        fail(f"cannot inspect snapshot directory {path}: {error}")
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail(f"snapshot directory is not an owned real directory: {path}")
    if info.st_mode & 0o022:
        fail(f"snapshot directory is group/other writable: {path}")


def owned_file(path: Path, mode: int, maximum_size: int) -> dict[str, object]:
    try:
        info = os.lstat(path)
    except OSError as error:
        fail(f"cannot inspect snapshot metadata {path}: {error}")
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        fail(f"snapshot metadata is not an owned single-link regular file: {path}")
    if stat.S_IMODE(info.st_mode) != mode or not 1 <= info.st_size <= maximum_size:
        fail(f"snapshot metadata has unsafe mode or size: {path}")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read snapshot metadata {path}: {error}")
    if not isinstance(value, dict):
        fail(f"snapshot metadata is not a JSON object: {path}")
    return value


if len(sys.argv) != 7:
	fail("internal snapshot manifest verifier argument mismatch")
root = Path(sys.argv[1])
session_id, branch, requested_manifest, manifest_match = sys.argv[2:6]
try:
	minimum_prompt_tokens = int(sys.argv[6])
except ValueError:
	fail("snapshot minimum prompt length is invalid")
if minimum_prompt_tokens != 8258:
	fail("snapshot minimum prompt length contract changed")
if manifest_match not in {"auto", "descendant", "exact"}:
    fail("snapshot manifest match mode is invalid")
if (requested_manifest == "AUTO") != (manifest_match == "auto"):
    fail("snapshot manifest request and match mode disagree")
if requested_manifest != "AUTO" and (
    len(requested_manifest) != 64
    or any(character not in "0123456789abcdef" for character in requested_manifest)
):
    fail("requested snapshot manifest digest is invalid")
if not root.is_absolute():
    fail("snapshot root is not absolute")
metadata = root / ".qwen-250k-cache-v1"
manifests = metadata / "manifests"
refs = metadata / "refs"
session_refs = refs / session_id
for directory in (root, metadata, manifests, refs, session_refs):
    owned_directory(directory)

ref = owned_file(session_refs / f"{branch}.json", 0o600, 4096)
expected_ref_keys = {
    "branch",
    "generation",
    "manifest_sha256",
    "schema",
    "session_id",
    "updated_at",
}
if set(ref) != expected_ref_keys:
    fail("snapshot branch head keys are invalid")
if ref.get("schema") != "urn:qwen-r9700:cache-ref:v1":
    fail("snapshot branch head schema is invalid")
if ref.get("session_id") != session_id or ref.get("branch") != branch:
    fail("snapshot branch head identity differs")
if not isinstance(ref.get("generation"), int) or ref["generation"] < 1:
    fail("snapshot branch head generation is invalid")
if not isinstance(ref.get("updated_at"), str) or re.fullmatch(
    r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", ref["updated_at"]
) is None:
    fail("snapshot branch head timestamp is invalid")
selected_manifest = ref.get("manifest_sha256")
if not isinstance(selected_manifest, str) or len(selected_manifest) != 64:
    fail("snapshot branch head manifest digest is invalid")
if any(character not in "0123456789abcdef" for character in selected_manifest):
    fail("snapshot branch head manifest digest is invalid")
if manifest_match == "exact" and selected_manifest != requested_manifest:
    fail("snapshot branch head does not select the requested manifest")

manifest_path = manifests / f"{selected_manifest}.json"
manifest = owned_file(manifest_path, 0o400, 2 * 1024 * 1024)
claimed = manifest.get("manifest_sha256")
unsigned = dict(manifest)
unsigned.pop("manifest_sha256", None)
actual = hashlib.sha256(
    json.dumps(unsigned, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode()
).hexdigest()
if claimed != selected_manifest or actual != selected_manifest:
    fail("snapshot manifest self-authentication failed")
if manifest.get("schema") != "urn:qwen-r9700:cache-generation:p8:v1":
    fail("snapshot manifest schema is invalid")
if manifest.get("session") != {"branch": branch, "session_id": session_id}:
    fail("snapshot manifest session or branch differs")
if manifest_match == "descendant":
    cursor_digest = selected_manifest
    cursor = manifest
    seen: set[str] = set()
    while cursor_digest != requested_manifest:
        if cursor_digest in seen:
            fail("snapshot manifest ancestry contains a cycle")
        seen.add(cursor_digest)
        parent_digest = cursor.get("parent_manifest_sha256")
        if (
            not isinstance(parent_digest, str)
            or re.fullmatch(r"[0-9a-f]{64}", parent_digest) is None
        ):
            fail("snapshot branch head is not a descendant of the active-pointer anchor")
        parent = owned_file(manifests / f"{parent_digest}.json", 0o400, 2 * 1024 * 1024)
        parent_claimed = parent.get("manifest_sha256")
        parent_unsigned = dict(parent)
        parent_unsigned.pop("manifest_sha256", None)
        parent_actual = hashlib.sha256(
            json.dumps(
                parent_unsigned,
                ensure_ascii=False,
                separators=(",", ":"),
                sort_keys=True,
            ).encode()
        ).hexdigest()
        if parent_claimed != parent_digest or parent_actual != parent_digest:
            fail("snapshot ancestor manifest self-authentication failed")
        if parent.get("schema") != "urn:qwen-r9700:cache-generation:p8:v1":
            fail("snapshot ancestor manifest schema is invalid")
        if parent.get("session") != {"branch": branch, "session_id": session_id}:
            fail("snapshot ancestor manifest session or branch differs")
        cursor_generation = cursor.get("generation")
        parent_generation = parent.get("generation")
        if (
            not isinstance(cursor_generation, int)
            or isinstance(cursor_generation, bool)
            or not isinstance(parent_generation, int)
            or isinstance(parent_generation, bool)
            or parent_generation != cursor_generation - 1
        ):
            fail("snapshot manifest ancestry generation is not contiguous")
        cursor_digest = parent_digest
        cursor = parent
request = manifest.get("request")
if not isinstance(request, dict):
    fail("snapshot manifest request is invalid")
prompt_tokens = request.get("prompt_tokens")
if (
	not isinstance(prompt_tokens, int)
	or isinstance(prompt_tokens, bool)
	or not minimum_prompt_tokens <= prompt_tokens <= 253792
):
	fail("snapshot manifest prompt length is invalid")
hash_aligned_tokens = prompt_tokens // 8 * 8
replay_boundary_tokens = hash_aligned_tokens - (
    16 if hash_aligned_tokens % 1648 in {0, 8} else 8
)
expected_request = {
	"hash_aligned_tokens": hash_aligned_tokens,
	"prompt_tokens": prompt_tokens,
	"replay_boundary_tokens": replay_boundary_tokens,
	"store_drained": True,
}
if any(request.get(key) != value for key, value in expected_request.items()):
	fail("snapshot manifest rolling geometry is invalid")
geometry = manifest.get("geometry")
if not isinstance(geometry, dict):
	fail("snapshot manifest geometry is missing")
expected_geometry = {
	"hash_aligned_tokens": hash_aligned_tokens,
	"prompt_tokens": prompt_tokens,
	"replay_boundary_tokens": replay_boundary_tokens,
	"tokens_per_hash": 8,
}
if any(geometry.get(key) != value for key, value in expected_geometry.items()):
	fail("snapshot manifest geometry and request differ")
if prompt_tokens == 60298:
	if geometry.get("profile") != "qwen-dflash-fixed-slot-p8-60298-v1":
		fail("snapshot root profile is invalid")
elif geometry.get("profile") != "qwen-dflash-fixed-slot-rolling-p8-v1":
	fail("snapshot rolling profile is invalid")
prefix_sha256 = request.get("prompt_token_ids_sha256")
if not isinstance(prefix_sha256, str) or len(prefix_sha256) != 64:
    fail("snapshot manifest token digest is invalid")
if any(character not in "0123456789abcdef" for character in prefix_sha256):
	fail("snapshot manifest token digest is invalid")
replay_prefix_sha256 = request.get("replay_prefix_token_ids_sha256")
if replay_prefix_sha256 is None:
    # Legacy heads predate the explicit replay-prefix binding. Preserve their
    # exact full-prompt client check rather than weakening it or making the old
    # snapshot unusable after a lane upgrade.
    resume_prefix_tokens = prompt_tokens
    resume_prefix_sha256 = prefix_sha256
elif (
    not isinstance(replay_prefix_sha256, str)
    or re.fullmatch(r"[0-9a-f]{64}", replay_prefix_sha256) is None
):
    fail("snapshot manifest replay-prefix digest is invalid")
else:
    resume_prefix_tokens = replay_boundary_tokens
    resume_prefix_sha256 = replay_prefix_sha256

expected_ref = {
    "branch": branch,
    "generation": manifest.get("generation"),
    "manifest_sha256": selected_manifest,
    "schema": "urn:qwen-r9700:cache-ref:v1",
    "session_id": session_id,
}
if any(ref.get(key) != value for key, value in expected_ref.items()):
    fail("snapshot branch head does not select the requested manifest")
print(
	    f"{selected_manifest}\t{prefix_sha256}\t{prompt_tokens}\t"
	    f"{resume_prefix_sha256}\t{resume_prefix_tokens}"
)
PY
REMOTE_SNAPSHOT_MANIFEST
	); then
		die 'remote snapshot manifest authentication failed'
	fi
	IFS=$'\t' read -r snapshot_manifest_sha256 snapshot_full_prefix_sha256 snapshot_tokens \
		snapshot_replay_prefix_sha256 snapshot_replay_prefix_tokens <<<"$snapshot_manifest_record"
	[[ $snapshot_manifest_sha256 =~ ^[0-9a-f]{64}$ ]] ||
		die 'remote snapshot manifest returned an invalid manifest digest'
	[[ $snapshot_full_prefix_sha256 =~ ^[0-9a-f]{64}$ && $snapshot_replay_prefix_sha256 =~ ^[0-9a-f]{64}$ ]] ||
		die 'remote snapshot manifest returned an invalid token digest'
	if [[ ! $snapshot_tokens =~ ^[0-9]+$ ]] ||
		((10#$snapshot_tokens < SNAPSHOT_STAGE_MINIMUM_TOKENS || 10#$snapshot_tokens > 253792)); then
		die 'remote snapshot manifest returned an invalid prompt length'
	fi
	if [[ ! $snapshot_replay_prefix_tokens =~ ^[0-9]+$ ]] ||
		((10#$snapshot_replay_prefix_tokens < 1 || 10#$snapshot_replay_prefix_tokens > 10#$snapshot_tokens)); then
		die 'remote snapshot manifest returned an invalid replay-prefix length'
	fi
	# A modern manifest binds the immutable replay boundary independently of the
	# mutable final prompt tail. Use that contract for explicit qualification
	# selections too; otherwise appending a user message would incorrectly compare
	# the newly rendered full prompt with the old full-prompt digest. Legacy heads
	# expose no shorter replay boundary and retain their exact full-prefix check.
	if ((snapshot_contract_auto == 1 || 10#$snapshot_replay_prefix_tokens < 10#$snapshot_tokens)); then
		snapshot_prefix_sha256=$snapshot_replay_prefix_sha256
		snapshot_resume_prefix_tokens=$snapshot_replay_prefix_tokens
	else
		snapshot_prefix_sha256=$snapshot_full_prefix_sha256
		snapshot_resume_prefix_tokens=$snapshot_tokens
	fi
	printf 'authenticated snapshot prefix %s/%s/%s (%s, %s replay tokens from %s prompt tokens)\n' \
		"$snapshot_session_id" "$snapshot_branch" "$snapshot_manifest_sha256" \
		"$snapshot_prefix_sha256" "$snapshot_resume_prefix_tokens" "$snapshot_tokens" >&2
fi

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
tunnel_log="$state_root/tunnel-$timestamp.log"
backend_log="$state_root/backend-$timestamp.log"
backend_health_lost_marker="$state_root/backend-$timestamp.health-lost"
[[ ! -e $backend_health_lost_marker && ! -L $backend_health_lost_marker ]] ||
	die "backend health-loss marker already exists: $backend_health_lost_marker"
: >"$tunnel_log"
: >"$backend_log"
chmod 0600 -- "$tunnel_log" "$backend_log"

if ((snapshot_capture == 1 && reuse_existing == 0)); then
	# SIGKILL cannot run EXIT cleanup. Recover only an exact same-user SSH
	# forward matching this launcher's complete loopback tuple; never kill a
	# merely port-sharing or otherwise ambiguous process.
	declare -a stale_snapshot_tunnels=()
	for candidate_root in /proc/[0-9]*; do
		[[ -r $candidate_root/status && -r $candidate_root/cmdline ]] || continue
		candidate_executable=$(readlink -e -- "$candidate_root/exe" 2>/dev/null || true)
		[[ ${candidate_executable##*/} == ssh ]] || continue
		[[ $(awk '/^Uid:/ {print $2}' "$candidate_root/status" 2>/dev/null) == "$(id -u)" ]] || continue
		candidate_args=$(tr '\0' ' ' <"$candidate_root/cmdline")
		if [[ $candidate_args == *"ssh -N -T "* &&
			$candidate_args == *"-L $local_port:127.0.0.1:$REMOTE_PORT $remote_host "* ]]; then
			stale_snapshot_tunnels+=("${candidate_root##*/}")
		fi
	done
	((${#stale_snapshot_tunnels[@]} <= 1)) ||
		die 'found multiple stale snapshot SSH tunnels; refusing ambiguous cleanup'
	if ((${#stale_snapshot_tunnels[@]} == 1)); then
		stale_tunnel_pid=${stale_snapshot_tunnels[0]}
		[[ -r /proc/$stale_tunnel_pid/status && -r /proc/$stale_tunnel_pid/cmdline &&
			$(awk '/^Uid:/ {print $2}' "/proc/$stale_tunnel_pid/status" 2>/dev/null) == "$(id -u)" ]] ||
			die 'stale snapshot SSH tunnel identity changed before cleanup'
		stale_tunnel_args=$(tr '\0' ' ' <"/proc/$stale_tunnel_pid/cmdline")
		[[ $stale_tunnel_args == *"ssh -N -T "* &&
			$stale_tunnel_args == *"-L $local_port:127.0.0.1:$REMOTE_PORT $remote_host "* ]] ||
			die 'stale snapshot SSH tunnel command changed before cleanup'
		kill TERM "$stale_tunnel_pid"
		for _ in {1..30}; do
			kill -0 "$stale_tunnel_pid" 2>/dev/null || break
			sleep 0.1
		done
		kill -0 "$stale_tunnel_pid" 2>/dev/null &&
			die 'exact stale snapshot SSH tunnel did not stop after TERM'
		printf 'removed exact stale snapshot SSH tunnel pid %s before restart\n' "$stale_tunnel_pid" >&2
	fi
fi

if ((reuse_existing == 0)) && command -v ss >/dev/null 2>&1 &&
	ss -Hln "sport = :$local_port" | grep -q .; then
	die "local port $local_port is already in use"
fi
if ((reuse_existing == 1)) && command -v ss >/dev/null 2>&1 &&
	ss -Hln "sport = :$local_port" | grep -q .; then
	printf 'reusing existing local port %s; not creating a second SSH tunnel\n' \
		"$local_port" >&2
else
	nohup ssh -N -T -o ExitOnForwardFailure=yes -o ConnectTimeout=10 \
		-o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
		-L "$local_port:127.0.0.1:$REMOTE_PORT" "$remote_host" \
		</dev/null >"$tunnel_log" 2>&1 &
	tunnel_pid=$!
	tunnel_ready=0
	for ((attempt = 1; attempt <= 40; attempt++)); do
		kill -0 "$tunnel_pid" 2>/dev/null || die "SSH tunnel failed; see $tunnel_log"
		if command -v ss >/dev/null 2>&1 && ss -Hln "sport = :$local_port" | grep -q .; then
			tunnel_ready=1
			break
		fi
		sleep 0.05
	done
	((tunnel_ready == 1)) || die "SSH tunnel did not bind local port $local_port; see $tunnel_log"
fi

if ((reuse_existing == 0)); then
	nohup ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
		"$remote_host" bash -s -- "$remote_project" "$backend_profile" "$lane" \
		"$require_fast_path" "$coding_turbo_quest96" "$snapshot_resume" "$live47_fast_lane" "$dense_ck_lane" "$live62_requested" \
		"$snapshot_capture" "$LIVE62_V14_ROOT_RELATIVE" \
		>"$backend_log" 2>&1 <<'REMOTE_BACKEND' &
set -euo pipefail
project=$1
profile=$2
lane=$3
require_fast_path=$4
coding_turbo_quest96=$5
snapshot_resume=$6
live47_fast_lane=$7
dense_ck_lane=$8
live62_requested=$9
snapshot_capture=${10}
live62_root_relative=${11}
printf 'PI_REMOTE_BACKEND_SUPERVISOR pid=%s start_ticks=%s\n' \
	"$$" "$(awk '{print $22}' /proc/$$/stat)"
if [[ $live62_requested == 1 ]]; then
	args=("$project/$live62_root_relative/command.sh")
elif [[ $live47_fast_lane == 1 ]]; then
	args=("$project/scripts/live47-quest96-d7-frozenlock")
	if [[ $dense_ck_lane == 1 ]]; then
		args+=(
			--qualification-dense-ck-prefill
			--qualification-suffix-prefill-warmup-root
			"$project/artifacts/qualifications/20260830T-live47-dense-ck-lane-v1-create-only/bootstrap"
		)
	fi
else
	args=("$project/scripts/stock-vllm-frozenlock" --profile "$profile" --lane "$lane")
fi

owned_server_child() {
	local pid=$1 expected_start=$2
	[[ $pid =~ ^[1-9][0-9]*$ && $expected_start =~ ^[1-9][0-9]*$ ]] || return 1
	[[ -r /proc/$pid/status && -r /proc/$pid/stat ]] || return 1
	[[ $(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null) == "$UID" ]] || return 1
	[[ $(awk '{print $22}' "/proc/$pid/stat") == "$expected_start" ]] || return 1
	[[ $(awk '{print $4}' "/proc/$pid/stat") == "$$" ]]
}
server_pid=''
server_start=''
cleanup_backend() {
	local status=$?
	trap - EXIT INT TERM
	if owned_server_child "$server_pid" "$server_start"; then
		# Signal only the API/launcher parent. It owns EngineCore termination and
		# must receive enough time to run connector and shared-mmap teardown.
		kill -TERM "$server_pid"
		wait "$server_pid" 2>/dev/null || true
	elif [[ -n $server_pid ]] && kill -0 "$server_pid" 2>/dev/null; then
		printf 'pi-remote-qwen: backend server identity changed; refusing cleanup signal\n' >&2
		status=1
	fi
	exit "$status"
}
trap cleanup_backend EXIT INT TERM
if [[ $profile == agent262 ]]; then
	# The experimental 262K Pi profile is only useful with nested-prefix reuse.
	# Keep this explicit at the launcher boundary so a normal restart cannot
	# silently fall back to a cold, mode-none backend.
	export QWEN_DFLASH_PREFIX_CACHING=1
	if [[ $coding_turbo_quest96 == 1 || $live47_fast_lane == 1 ]]; then
		export QWEN_FIXED_SLOT_TARGET_ONLY_ORACLE=0
		export QWEN_CODING_TURBO_QUEST96=1
		if ((live47_fast_lane == 1)); then
			export QWEN_LIVE47_GREEDY_STREAM=1
		fi
		export QWEN_QUEST_PAGE_BUDGET=96
		export QWEN_QUEST_M8_DUALPHASE=1
		export QWEN_QUEST_M8_ROW_LOCAL=1
		export QWEN_QUEST_CACHED_GEMM_SELECTOR=1
		export QWEN_QUEST_CACHED_GEMM_COLD_SEED=0
		export QWEN_DFLASH_D7_C1_DRAFT_GRAPH=1
		export QWEN_DFLASH_GREEDY_M8_VERIFIER=1
		export QWEN_RDNA_ENABLE_EXPERIMENTAL_SPLIT_K=1
		export QWEN_RDNA_W4A16_COMMON_SPLIT_K=1
		export QWEN_RDNA_W4A16_ACTIVATION_PRECAST=1
		export QWEN_RDNA_W4A16_NATIVE_B_PREFILL_TRITON=1
		export QWEN_RDNA_W4A16_NATIVE_B_PREFILL_MIN_M=64
		export QWEN_RDNA_W4A16_NATIVE_B_PREFILL_BLOCK_K=16
		export QWEN_DFLASH_RAW_FILL_MODE_NONE=1
		export QWEN_DFLASH_ROCM_OFFLOADING_CONNECTOR=1
		export QWEN_DFLASH_PERSISTENT_KV=1
		export QWEN_DFLASH_PERSISTENT_EAGLE_TAIL=1
		export QWEN_GDN_FIXED_SLOT_SERIAL_CONV_M8=1
			export QWEN_FIXED_SLOT_SNAPSHOT_EXPORT=1
			export QWEN_FIXED_SLOT_CORRECTED_GENERATION=1
			if ((snapshot_capture == 1)); then
				export QWEN_FIXED_SLOT_SHORT_ROOT_CHECKPOINT=1
			fi
		export QWEN_DFLASH_FIXED_SLOT_TRUSTED_REPLAY=1
		export QWEN_DFLASH_WHOLE_MODEL_ACCEPTED_REPLAY=1
		export QWEN_GDN_FIXED_SLOT_CACHED_ACCEPTED_COMMIT=1
		export QWEN_GDN_BA_SERIAL_ROW_EXACT=1
		export QWEN_GEMMA_RMS_FP32_KERNEL=1
	fi
	if [[ $live47_fast_lane == 0 ]]; then
		args+=(--experimental --qualification-run)
		if [[ $require_fast_path == 1 ]]; then
			args+=(--require-fast-path)
		fi
	fi
elif [[ $lane == mtp3 ]]; then
	args+=(--experimental
		--gate "mtp-functional=$project/results/c1/stock-vllm-d626108b-patched-w4a16-mtp3-quality-v3.json"
		--gate "mtp-reasoning-low=$project/results/c1/stock-vllm-d626108b-patched-w4a16-mtp3-reasoning-low-v1.json"
			--gate "mtp-tool-reasoning=$project/results/c1/stock-vllm-d626108b-patched-w4a16-mtp3-tool-reasoning-low-v1.json")
fi
"${args[@]}" &
server_pid=$!
server_start=$(awk '{print $22}' "/proc/$server_pid/stat")
printf 'PI_REMOTE_BACKEND_SERVER pid=%s start_ticks=%s\n' \
	"$server_pid" "$server_start"
set +e
wait "$server_pid"
server_status=$?
set -e
trap - EXIT INT TERM
exit "$server_status"
REMOTE_BACKEND
	backend_pid=$!
fi

if ((reuse_existing == 1)); then
	printf 'attaching to existing %s/%s on %s; checking health...\n' \
		"$profile" "$lane" "$remote_host" >&2
else
	printf 'starting %s/%s on %s; waiting for health...\n' "$profile" "$lane" "$remote_host" >&2
fi
ready=0
for ((attempt = 1; attempt <= 180; attempt++)); do
	if [[ -n $backend_pid ]] && ! kill -0 "$backend_pid" 2>/dev/null; then
		tail -n 80 -- "$backend_log" >&2 || true
		die 'remote backend exited before becoming healthy'
	fi
	if curl --fail --silent --show-error --max-time 3 \
		"http://127.0.0.1:$local_port/health" >/dev/null 2>&1; then
		ready=1
		break
	fi
	sleep 1
done
((ready == 1)) || {
	tail -n 80 -- "$backend_log" >&2 || true
	die 'backend health timeout'
}

models_json=$(curl --fail --silent --show-error --max-time 10 \
	"http://127.0.0.1:$local_port/v1/models") || die 'backend model endpoint is unavailable'
jq -e --arg model "$SERVED_MODEL" '.data | any(.[]; .id == $model)' \
	<<<"$models_json" >/dev/null || die "backend did not advertise $SERVED_MODEL"
if ((live62_requested == 1 && reuse_existing == 0)); then
	authenticate_fresh_snapshot_backend ||
		die 'cannot authenticate the new owned live62 backend PID/start-time/session/listener identity'
	assert_live62_v14_bootstrap "$backend_log"
	snapshot_fresh_backend_authenticated=1
	if ((snapshot_capture == 1)); then
		printf 'authenticated new owned snapshot backend; unresolved-stage repost is eligible only if the journal requires it\n' >&2
	else
		printf 'authenticated new owned live62 backend; a clean Pi exit may leave it available for immediate reuse\n' >&2
	fi
fi
if ((reuse_existing == 1)); then
	printf 'existing backend ready; launching Pi %s (tunnel log: %s)\n' \
		"$PI_MODEL" "$tunnel_log" >&2
else
	printf 'backend ready; launching Pi %s (logs: %s)\n' "$PI_MODEL" "$backend_log" >&2
fi

# The first DFlash request otherwise JIT-compiles the model, target-head and
# fixed rejection/resample kernels in the request's critical path.  A one-token
# probe is insufficient: it can take the ordinary single-token path and leave
# the first real M8 shape cold.  Use a content-free, multi-token request that
# keeps the backend in the DFlash path before Pi opens; the result is discarded
# and does not alter the user's conversation or prefix-cache history.
if [[ ($backend_profile == agent262) && $lane == dflash && $reuse_existing == 0 &&
	$snapshot_resume == 0 && $live62_requested == 0 && ${QWEN_PI_SKIP_WARMUP:-0} != 1 ]]; then
	if ((coding_turbo_quest96 == 1)); then
		warmup_payload=$(printf '%s' \
			'{"model":"qwen3.8-27b-frozenlock","prompt":"Output exactly sixteen short words separated by spaces. Do not stop early. alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa","max_tokens":24,"temperature":1.0,"top_p":0.95,"top_k":40,"stream":false}')
	else
		warmup_payload=$(printf '%s' \
			'{"model":"qwen3.8-27b-frozenlock","prompt":"Output exactly sixteen short words separated by spaces. Do not stop early. alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november oscar papa","max_tokens":24,"temperature":0.0,"stream":false}')
	fi
	# jit_monitor emits this exact diagnostic only when a Triton kernel compiles
	# after inference has already begun.  Check only bytes written by this
	# warmup: a historical warning must not poison a later healthy launch. If
	# this request really compiles a shape, repeat it so the persistent cache is
	# populated before Pi is admitted.
	jit_log_offset=$(stat -c '%s' -- "$backend_log")
	[[ $jit_log_offset =~ ^[0-9]+$ ]] || die 'backend warmup received an invalid local log size'
	for warmup_attempt in 1 2 3; do
		curl --fail --silent --show-error --max-time 300 \
			-H 'Content-Type: application/json' \
			-H "X-Request-ID: pi-remote-startup-warmup-$warmup_attempt" \
			-d "$warmup_payload" \
			"http://127.0.0.1:$local_port/v1/completions" >/dev/null ||
			die 'backend warmup failed; refusing to start Pi on a cold or unhealthy lane'
		jit_seen=0
		for ((poll_attempt = 1; poll_attempt <= 20; poll_attempt++)); do
			current_size=$(stat -c '%s' -- "$backend_log")
			[[ $current_size =~ ^[0-9]+$ && $current_size -ge $jit_log_offset ]] ||
				die 'backend warmup could not inspect the local backend log'
			if tail -c +$((jit_log_offset + 1)) -- "$backend_log" |
				grep -Fq 'JIT compilation during inference'; then
				jit_seen=1
				break
			fi
			sleep 0.1
		done
		if ((jit_seen == 0)); then
			break
		fi
		if ((warmup_attempt < 3)); then
			printf 'backend warmup compiled new inference shapes; repeating warmup (%s/3)\n' \
				"$warmup_attempt" >&2
			jit_log_offset=$current_size
			continue
		fi
		tail -n 80 -- "$backend_log" >&2 || true
		die 'backend warmup still observed inference-time Triton JIT after three attempts'
	done
	printf 'backend warmup complete; launching Pi\n' >&2
elif [[ $backend_profile == agent262 && $lane == dflash && $reuse_existing == 1 ]]; then
	# --reuse-existing is an attachment operation.  Health/model/process checks
	# above are read-only; do not submit a speculative request that can compile a
	# cold kernel, evict useful prefix blocks, or kill a backend Pi did not start.
	printf 'reused backend validated; skipping mutating startup warmup\n' >&2
elif ((snapshot_resume == 1 || live62_requested == 1)); then
	# A fixed-slot snapshot backend cannot accept an arbitrary short warmup:
	# live62 enforces its snapshot prompt-length ABI even when this invocation has
	# no selected session.  Its admission contract authenticates a selected
	# P-token branch head rather than accepting the legacy three-token probe.
	# The first Pi request carries that authenticated transcript, so never send
	# an unauthenticated short probe that can terminate EngineCore.
	printf 'snapshot backend validated; skipping unauthenticated startup warmup\n' >&2
fi

# Keep the foreground client tied to the backend it was validated against.  A
# remote EngineCore can die after /health succeeds (for example, an async GPU
# fault during the first long-context request) while the SSH tunnel remains
# listening locally.  Without this watcher Pi stays on a stale "Working"
# screen forever because its request socket has already been reset.  The
# watcher is deliberately coarse: it polls only while Pi is alive and asks Pi
# to exit with a clear diagnostic as soon as the backend disappears.
watch_backend() {
	while [[ -n $pi_pid ]] && kill -0 "$pi_pid" 2>/dev/null; do
		if ! curl --fail --silent --show-error --max-time 3 \
			"http://127.0.0.1:$local_port/health" >/dev/null 2>&1; then
			printf 'pi-remote-qwen: backend health lost; stopping Pi\n' >&2
			if [[ -s $backend_log ]]; then
				printf 'pi-remote-qwen: remote backend stderr tail follows (full log: %s)\n' \
					"$backend_log" >&2
				tail -n 160 -- "$backend_log" >&2 || true
			elif [[ -n $remote_backend_log ]]; then
				printf 'pi-remote-qwen: remote backend stderr tail follows (remote log: %s)\n' \
					"$remote_backend_log" >&2
				ssh -T -o ConnectTimeout=10 "$remote_host" \
					tail -n 160 -- "$remote_backend_log" >&2 || true
			else
				printf 'pi-remote-qwen: no owned backend stderr was captured by this attachment; diagnostic log: %s\n' \
					"$backend_log" >&2
			fi
			mkdir -m 0700 -- "$backend_health_lost_marker" || {
				printf 'pi-remote-qwen: cannot publish the backend health-loss marker\n' >&2
				kill TERM "$pi_pid" 2>/dev/null || true
				return 2
			}
			kill TERM "$pi_pid" 2>/dev/null || true
			return 1
		fi
		sleep 2
	done
}

compaction_transaction_key() {
	local source_sha=$1 abi prompt_abi
	[[ -v QWEN_PI_COMPACTION_HANDOFF_ABI_SHA256 ]] ||
		die 'transactional compaction ABI is missing from the supervised environment'
	[[ -v QWEN_PI_COMPACTION_HANDOFF_PROMPT_ABI ]] ||
		die 'transactional compaction prompt ABI is missing from the supervised environment'
	abi=$QWEN_PI_COMPACTION_HANDOFF_ABI_SHA256
	prompt_abi=$QWEN_PI_COMPACTION_HANDOFF_PROMPT_ABI
	[[ $source_sha =~ ^[0-9a-f]{64}$ && $abi =~ ^[0-9a-f]{64}$ &&
		$prompt_abi == "$snapshot_prompt_abi" ]] ||
		die 'transactional compaction identity contains an invalid digest'
	printf 'qwen-r9700-transactional-compaction-key-v3\0%s%s%s' \
		"$source_sha" "$abi" "$prompt_abi" |
		sha256sum | awk '{print $1}'
}

pending_compaction_request() {
	[[ -v QWEN_PI_COMPACTION_HANDOFF_REQUEST_ROOT ]] || return 3
	local source_sha transaction_key request
	source_sha=$(sha256sum -- "$resolved_snapshot_session_file" | awk '{print $1}') ||
		die 'cannot hash the active transcript for transactional compaction'
	transaction_key=$(compaction_transaction_key "$source_sha") || return
	request="$QWEN_PI_COMPACTION_HANDOFF_REQUEST_ROOT/$transaction_key/request.json"
	[[ -e $request || -L $request ]] || return 3
	printf '%s\n' "$request"
}

prepare_pending_compaction() {
	local request=$1 source_sha source_bytes transaction_key expected_output expected_snapshot custom abi prompt_abi
	local -a transaction_arguments
	[[ -f $request && ! -L $request &&
		$(stat -c '%u:%a:%h' -- "$request") == "$(id -u):600:1" ]] ||
		die "transactional compaction handoff request is unsafe: $request"
	source_sha=$(sha256sum -- "$resolved_snapshot_session_file" | awk '{print $1}') ||
		die 'cannot authenticate the compaction source digest'
	source_bytes=$(stat -c '%s' -- "$resolved_snapshot_session_file") ||
		die 'cannot authenticate the compaction source size'
	abi=${QWEN_PI_COMPACTION_HANDOFF_ABI_SHA256-}
	prompt_abi=${QWEN_PI_COMPACTION_HANDOFF_PROMPT_ABI-}
	transaction_key=$(compaction_transaction_key "$source_sha") || return
	expected_output="$QWEN_PI_COMPACTION_HANDOFF_TRANSACTION_ROOT/$transaction_key"
	expected_snapshot="pi-$QWEN_PI_COMPACTION_HANDOFF_LOGICAL_SESSION_ID-semantic-${transaction_key:0:16}"
	jq -e --arg source "$resolved_snapshot_session_file" --arg sha "$source_sha" \
		--arg abi "$abi" --arg prompt_abi "$prompt_abi" \
		--arg output "$expected_output" --arg snapshot "$expected_snapshot" \
		--argjson bytes "$source_bytes" '
		type == "object"
		and keys == ["compaction_abi_sha256", "custom_instructions", "output_root", "preparation", "prompt_abi", "reason", "schema", "snapshot_session_id", "source", "will_retry"]
		and .schema == "urn:qwen-r9700:transactional-compaction-handoff:v3"
		and .compaction_abi_sha256 == $abi
		and .prompt_abi == $prompt_abi
		and (.reason == "manual" or .reason == "threshold" or .reason == "overflow")
		and (.will_retry | type == "boolean")
		and (.custom_instructions == null or (.custom_instructions | type == "string" and length <= 65536))
		and .output_root == $output and .snapshot_session_id == $snapshot
		and .source.path == $source and .source.sha256 == $sha and .source.bytes == $bytes
		and (.source.leaf_id | type == "string" and length > 0)
		and (.preparation.first_kept_entry_id | type == "string" and length > 0)
		and (.preparation.tokens_before | type == "number" and floor == . and . > 0)
	' "$request" >/dev/null || die 'transactional compaction handoff request is invalid'
	transaction_arguments=(
		--session "$resolved_snapshot_session_file"
		--output-root "$expected_output"
		--snapshot-session-id "$expected_snapshot"
		--local-port "$local_port"
		--semantic-base-url "http://127.0.0.1:$local_port/v1"
		--summary-thinking low
		--summary-target-tokens 3000
		--summary-max-tokens 8000
		--compaction-abi-sha256 "$abi"
		--prompt-abi "$prompt_abi"
		--prepare-only
	)
	if [[ $(jq -r '.custom_instructions == null' "$request") == false ]]; then
		custom=$(jq -r '.custom_instructions' "$request") ||
			die 'cannot read custom compaction instructions'
		transaction_arguments+=(--custom-instructions "$custom")
	fi
	printf 'preparing restart-safe semantic compaction before stopping the current backend\n' >&2
	"$COMPACTION_TRANSACTION_PROGRAM" "${transaction_arguments[@]}" >/dev/null ||
		die 'semantic compaction preparation failed; durable request remains retryable'
	printf 'semantic compaction and its private successor snapshot are sealed; activation follows backend shutdown\n' >&2
}

flush_latest_snapshot_head() {
	((snapshot_exit_flush == 1)) || return 0
	[[ -e $snapshot_exit_latest_receipt || -L $snapshot_exit_latest_receipt ]] || {
		printf 'no outgoing snapshot request was recorded; durable branch head is unchanged\n' >&2
		return 0
	}
	[[ -f $snapshot_exit_latest_receipt && ! -L $snapshot_exit_latest_receipt &&
		$(stat -c '%u:%a:%h' -- "$snapshot_exit_latest_receipt") == "$(id -u):600:1" ]] ||
		die "latest snapshot token receipt is unsafe: $snapshot_exit_latest_receipt"
	local token_file token_file_sha prompt_tokens prefix_sha plan_file plan_document final_head
	token_file=$(jq -er '.token_file' "$snapshot_exit_latest_receipt") ||
		die 'latest snapshot token receipt lacks a token file'
	token_file_sha=$(jq -er '.token_file_sha256' "$snapshot_exit_latest_receipt") ||
		die 'latest snapshot token receipt lacks a token-file digest'
	prompt_tokens=$(jq -er '.prompt_tokens' "$snapshot_exit_latest_receipt") ||
		die 'latest snapshot token receipt lacks a prompt length'
	prefix_sha=$(jq -er '.prefix_token_ids_sha256' "$snapshot_exit_latest_receipt") ||
		die 'latest snapshot token receipt lacks a prefix digest'
	[[ $token_file_sha =~ ^[0-9a-f]{64}$ && $prefix_sha =~ ^[0-9a-f]{64}$ ]] ||
		die 'latest snapshot token receipt contains an invalid digest'
	if [[ ! $prompt_tokens =~ ^[0-9]+$ ]] ||
		((10#$prompt_tokens < SNAPSHOT_STAGE_MINIMUM_TOKENS || 10#$prompt_tokens > 253792)); then
		die 'latest snapshot token receipt contains an invalid prompt length'
	fi
	[[ $token_file == "$snapshot_exit_token_root/vectors/$token_file_sha.qwenstg1" ]] ||
		die 'latest snapshot token receipt selects a token file outside its protected vector root'
	[[ -f $token_file && ! -L $token_file &&
		$(stat -c '%u:%a:%h' -- "$token_file") == "$(id -u):600:1" ]] ||
		die "latest snapshot token vector is unsafe: $token_file"
	[[ $(sha256sum -- "$token_file" | awk '{print $1}') == "$token_file_sha" ]] ||
		die 'latest snapshot token vector digest differs from its receipt'
	jq -e \
		--arg session "$snapshot_session_id" --arg branch "$snapshot_branch" \
		--arg token_file "$token_file" --arg file_sha "$token_file_sha" \
		--arg prefix "$prefix_sha" --argjson tokens "$prompt_tokens" '
			type == "object"
			and keys == ["branch", "prefix_token_ids_sha256", "prompt_tokens", "schema", "session_id", "token_file", "token_file_sha256"]
			and .schema == "urn:qwen-r9700:pi-fixed-slot-latest-token-vector:v1"
			and .session_id == $session and .branch == $branch
			and .token_file == $token_file and .token_file_sha256 == $file_sha
			and .prefix_token_ids_sha256 == $prefix and .prompt_tokens == $tokens
		' "$snapshot_exit_latest_receipt" >/dev/null ||
		die 'latest snapshot token receipt differs from the active branch contract'
	local background_head="$snapshot_exit_token_root/durable-head.json"
	if ((snapshot_background_status == 0)) &&
		[[ -f $background_head && ! -L $background_head &&
			$(stat -c '%u:%a:%h' -- "$background_head") == "$(id -u):600:1" ]] &&
		jq -e --arg run "$snapshot_background_run_id" \
			--arg session "$snapshot_session_id" --arg branch "$snapshot_branch" \
			--arg prefix "$prefix_sha" --arg token_file_sha "$token_file_sha" \
			--argjson tokens "$prompt_tokens" '
			.schema == "urn:qwen-r9700:authenticated-snapshot-head:v1"
			and .run_id == $run and .session_id == $session and .branch == $branch
			and .prefix_token_ids_sha256 == $prefix and .prompt_tokens == $tokens
			and .settled_token_file_sha256 == $token_file_sha
			and .store_drained == true
			and .deep_evidence.all_groups_verified == true
			and .deep_evidence.total_groups == 69
		' "$background_head" >/dev/null; then
		printf 'latest %s-token prompt was already sealed and deep-verified in the background\n' \
			"$prompt_tokens" >&2
		return 0
	fi
	[[ -f $SNAPSHOT_HEAD_ADVANCE && ! -L $SNAPSHOT_HEAD_ADVANCE &&
		$(stat -c '%u:%a:%h' -- "$SNAPSHOT_HEAD_ADVANCE") == "$(id -u):755:1" ]] ||
		die 'snapshot head-advance controller has an unsafe identity'
	[[ $(sha256sum -- "$SNAPSHOT_HEAD_ADVANCE" | awk '{print $1}') == "$SNAPSHOT_HEAD_ADVANCE_SHA256" ]] ||
		die 'snapshot head-advance controller differs from the pinned ABI'
	plan_file="$snapshot_exit_plan_root/$token_file_sha.advance.json"
	declare -a plan_arguments=(
		--plan "$plan_file"
		--token-file "$token_file"
		--session-id "$snapshot_session_id"
		--branch "$snapshot_branch"
		--model "$SERVED_MODEL"
		--verify-evidence-sha256 "$SNAPSHOT_VERIFY_SHA256"
	)
	plan_document=$("$SNAPSHOT_HEAD_ADVANCE" "${plan_arguments[@]}" --prepare-only) ||
		die 'cannot create or authenticate the snapshot head-advance plan'
	jq -e --arg prefix "$prefix_sha" --argjson tokens "$prompt_tokens" '
		.operation == "advance_existing_head"
		and .prompt_token_ids_sha256 == $prefix
		and .prompt_tokens == $tokens
		and (.stages | length == 1)
		and .stages[0].prompt_tokens == $tokens
	' <<<"$plan_document" >/dev/null ||
		die 'snapshot head-advance plan differs from the latest token receipt'
	printf 'publishing durable snapshot head through %s prompt tokens before exit\n' \
		"$prompt_tokens" >&2
	final_head=$("$SNAPSHOT_HEAD_ADVANCE" "${plan_arguments[@]}" \
		--base-url "http://127.0.0.1:$local_port" \
		--snapshot-root "$REMOTE_FIXED_SLOT_CACHE_ROOT" \
		--verify-program "$snapshot_exit_remote_verifier" \
		--journal-root "$snapshot_exit_journal_root" \
		--request-timeout-seconds 900 --commit-timeout-seconds 600 --poll-seconds 1) ||
		die 'snapshot head advance did not reach an authenticated durable commit'
	jq -e --arg session "$snapshot_session_id" --arg branch "$snapshot_branch" \
		--arg prefix "$prefix_sha" --argjson tokens "$prompt_tokens" '
		.schema == "urn:qwen-r9700:authenticated-snapshot-head:v1"
		and .session_id == $session and .branch == $branch
		and .prefix_token_ids_sha256 == $prefix and .prompt_tokens == $tokens
		and .store_drained == true and .deep_evidence.all_groups_verified == true
	' <<<"$final_head" >/dev/null ||
		die 'snapshot head-advance result is not the exact drained all-group head'
	printf 'durable snapshot head advanced to %s prompt tokens\n' "$prompt_tokens" >&2
}

declare -a pi_extensions=(
	--extension "$progress_extension"
	--extension "$tool_output_condense_extension"
	--extension "$tool_call_integrity_extension"
	--extension "$repetition_guard_extension"
)
if [[ -v QWEN_PI_LATENCY_AUDIT_FILE && -n $QWEN_PI_LATENCY_AUDIT_FILE ]]; then
	pi_extensions+=(--extension "$latency_audit_extension")
fi
if [[ -v QWEN_PI_COMPACTION_HANDOFF_REQUEST_ROOT ]]; then
	pi_extensions+=(--extension "$compaction_handoff_extension")
fi
declare -a pi_environment=(
	"PI_CODING_AGENT_DIR=$pi_agent_dir"
	'PI_OFFLINE=1'
	"QWEN_PI_TOOL_RESULT_DIR=$live_tool_result_root"
)
if [[ -n $semantic_history_manifest ]]; then
	pi_environment+=(
		"QWEN_PI_SEMANTIC_HISTORY_MANIFEST=$semantic_history_manifest"
		"QWEN_PI_SEMANTIC_HISTORY_MANIFEST_SHA256=$semantic_history_manifest_sha256"
	)
fi

# The rehydrator is part of every new/cold prompt capsule and of the explicit
# tool-archive snapshot ABI. An older snapshot ABI must retain its exact tool
# schema, so it keeps the direct authenticated archive-path fallback until that
# chat is transactionally migrated to searchtool-toolarchive-v1.
if ((snapshot_resume == 0)) || [[ $snapshot_prompt_abi == "$TOOL_ARCHIVE_PROMPT_ABI" ||
	$snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]]; then
	pi_extensions+=(--extension "$tool_turn_rehydrate_extension")
	if [[ -n $tool_turn_archive_root ]]; then
		pi_environment+=("QWEN_PI_TOOL_TURN_ARCHIVE_ROOT=$tool_turn_archive_root")
	fi
fi
if ((snapshot_resume == 1)); then
	# Disable mutable agent-directory discovery. Only prompt-ABI extensions are
	# allowed to affect the model-visible tool schema for a snapshot branch.
	pi_extensions=(--no-extensions "${pi_extensions[@]}")
	if [[ $snapshot_prompt_abi == "$SEARCHTOOL_PROMPT_ABI" ||
		$snapshot_prompt_abi == "$TOOL_ARCHIVE_PROMPT_ABI" ||
		$snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]]; then
		[[ -f $SEARCHTOOL_EXTENSION && ! -L $SEARCHTOOL_EXTENSION ]] ||
			die "searchtool prompt ABI extension is missing or unsafe: $SEARCHTOOL_EXTENSION"
		pi_extensions+=(--extension "$SEARCHTOOL_EXTENSION")
	fi
	if [[ $snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]]; then
		# This extension is the final model-visible tool-schema transform. Fixed-slot
		# runs after it so its authenticated token vector includes the canonical
		# reserved outcome tool and its message_end handler sees any rejection first.
		pi_extensions+=(--extension "$structured_outcome_extension")
		pi_environment+=('QWEN_PI_STRUCTURED_OUTCOME=1')
		if ((snapshot_capture == 1)); then
			pi_environment+=(
				"QWEN_PI_STRUCTURED_OUTCOME_CAPTURE_PATH=$snapshot_outcome_provider_payload"
			)
		fi
	fi
	# Fixed-slot must be last. before_provider_request authenticates the completely
	# transformed payload; message_end receives earlier guards' replacement message
	# before deciding that a turn completed or publishing its exact prompt.
	pi_extensions+=(--extension "$fixed_slot_resume_extension")
	snapshot_pi_mode=resume
	if ((snapshot_capture == 1)); then
		snapshot_pi_mode=capture_checkpoint
	elif ((snapshot_exit_flush == 1)); then
		# Publish the exact outgoing prompt as part of the interactive request that
		# already computes it. The private worker then only authenticates and journals
		# that atomic remote head; it never issues a duplicate GPU prefill request.
		snapshot_pi_mode=resume_checkpoint
	elif ((snapshot_contract_auto == 1 && snapshot_active_pointer == 0)); then
		# Explicit auto-selected snapshot transactions also advance their branch on
		# this request.
		snapshot_pi_mode=resume_checkpoint
	fi
	pi_environment+=(
		'QWEN_PI_FIXED_SLOT_RESUME=1'
		"QWEN_PI_FIXED_SLOT_SESSION_ID=$snapshot_session_id"
		"QWEN_PI_FIXED_SLOT_BRANCH=$snapshot_branch"
		"QWEN_PI_FIXED_SLOT_MODE=$snapshot_pi_mode"
		"QWEN_PI_FIXED_SLOT_SNAPSHOT_TOKENS=$snapshot_tokens"
		"QWEN_PI_FIXED_SLOT_BOOTSTRAP_BASE_URL=http://127.0.0.1:$local_port"
	)
	if ((snapshot_capture == 1)); then
		pi_environment+=(
			"QWEN_PI_FIXED_SLOT_BOOTSTRAP_OUTPUT=$snapshot_bootstrap_output"
			"QWEN_PI_FIXED_SLOT_BOOTSTRAP_TOKEN_FILE=$snapshot_bootstrap_token_file"
			'QWEN_PI_FIXED_SLOT_BOOTSTRAP_AUTOSTART=1'
		)
		printf 'restartable fixed-slot snapshot bootstrap enabled for %s/%s (transaction: %s)\n' \
			"$snapshot_session_id" "$snapshot_branch" "$snapshot_stage_transaction_root" >&2
	else
		pi_environment+=(
			"QWEN_PI_FIXED_SLOT_PREFIX_SHA256=$snapshot_prefix_sha256"
		)
		if ((snapshot_exit_flush == 1)); then
			pi_environment+=(
				"QWEN_PI_FIXED_SLOT_LATEST_TOKEN_ROOT=$snapshot_exit_token_root"
				"QWEN_PI_FIXED_SLOT_BACKGROUND_RUN_ID=$snapshot_background_run_id"
			)
		fi
		if [[ $snapshot_pi_mode == resume ]]; then
			pi_environment+=(
				"QWEN_PI_FIXED_SLOT_MANIFEST_SHA256=$snapshot_manifest_sha256"
			)
			if ((snapshot_resume_prefix_tokens < snapshot_tokens)); then
				pi_environment+=(
					"QWEN_PI_FIXED_SLOT_RESUME_PREFIX_TOKENS=$snapshot_resume_prefix_tokens"
				)
			fi
		elif [[ $snapshot_pi_mode == resume_checkpoint ]]; then
			pi_environment+=(
				"QWEN_PI_FIXED_SLOT_RESUME_PREFIX_TOKENS=$snapshot_resume_prefix_tokens"
			)
		fi
		printf 'fixed-slot snapshot %s enabled for %s/%s/%s\n' \
			"$snapshot_pi_mode" "$snapshot_session_id" "$snapshot_branch" \
			"$snapshot_manifest_sha256" >&2
	fi
fi

if [[ ${QWEN_PI_COMPACTION_PREPARE_ONLY:-0} == 1 ]]; then
	pending_request=$(pending_compaction_request) ||
		die 'compaction prepare-only mode has no authenticated pending request'
	prepare_pending_compaction "$pending_request"
	exit 75
fi

# Bash gives an asynchronous command /dev/null as stdin when job control is
# disabled.  That made Pi see stdinIsTTY=false, select print mode, replay the
# last assistant error from a resumed session, and exit before the user could
# type anything.  Keep Pi supervised in the background, but explicitly reopen
# the controlling terminal for an interactive invocation.
if [[ -t 0 && -t 1 ]]; then
	env "${pi_environment[@]}" "$pi_link" --model "$PI_MODEL" \
		--thinking "$thinking" "${pi_extensions[@]}" \
		"${pi_extra_args[@]}" </dev/tty &
else
	env "${pi_environment[@]}" "$pi_link" --model "$PI_MODEL" \
		--thinking "$thinking" "${pi_extensions[@]}" \
		"${pi_extra_args[@]}" &
fi
pi_pid=$!
pi_start=$(awk '{print $22}' "/proc/$pi_pid/stat" 2>/dev/null || true)
[[ $pi_start =~ ^[1-9][0-9]*$ ]] || die 'cannot authenticate the Pi process start time'
start_snapshot_background_publisher
watch_backend &
backend_watch_pid=$!
set +e
wait "$pi_pid"
pi_status=$?
if ((shutdown_signal_status != 0)); then
	# The first wait returns as soon as Bash handles the trapped signal, which
	# can precede the child's actual exit. Reap the TERM-forwarded Pi process
	# before reading its latest-token receipt or starting durable publication.
	while owned_pi_process; do
		wait "$pi_pid" 2>/dev/null
	done
	pi_status=$shutdown_signal_status
fi
set -e
if [[ -n $backend_watch_pid ]]; then
	if kill -0 "$backend_watch_pid" 2>/dev/null; then
		kill TERM "$backend_watch_pid" 2>/dev/null || true
	fi
	set +e
	wait "$backend_watch_pid" 2>/dev/null
	backend_watch_status=$?
	set -e
	if [[ -e $backend_health_lost_marker || -L $backend_health_lost_marker ]]; then
		[[ -d $backend_health_lost_marker && ! -L $backend_health_lost_marker &&
			$(stat -c '%u:%a' -- "$backend_health_lost_marker") == "$(id -u):700" ]] ||
			die 'backend health-loss marker has an unsafe identity'
		backend_health_lost=1
	elif ((backend_watch_status != 0 && backend_watch_status != 143)); then
		backend_health_lost=1
	fi
fi
wait_snapshot_background_publisher
compaction_handoff_prepared=0
set +e
pending_request=$(pending_compaction_request)
pending_status=$?
set -e
if ((pending_status == 0)); then
	prepare_pending_compaction "$pending_request"
	compaction_handoff_prepared=1
	pi_status=75
elif ((pending_status != 3)); then
	die 'cannot inspect transactional compaction handoff state'
fi
if ((snapshot_exit_flush == 1 && compaction_handoff_prepared == 0 && backend_health_lost == 0)); then
	flush_latest_snapshot_head
elif ((snapshot_exit_flush == 1 && compaction_handoff_prepared == 0)); then
	printf 'backend health is lost; latest prompt remains in the transcript and the prior durable head is unchanged\n' >&2
fi
if ((snapshot_capture == 0 && live62_requested == 1 && reuse_existing == 0 && \
	snapshot_fresh_backend_authenticated == 1 && compaction_handoff_prepared == 0 && pi_status == 0)); then
	snapshot_success_backend_preserve=1
fi
if ((snapshot_capture == 1)); then
	# The legacy snapshot_ref_ready boolean treated ref existence as success. The
	# staged path below deliberately requires the controller's deep, drained-head
	# authentication and a sealed committed receipt instead.
	[[ -f $snapshot_bootstrap_started_output && ! -L $snapshot_bootstrap_started_output ]] ||
		die "snapshot token export did not publish its started receipt: $snapshot_bootstrap_started_output"
	[[ $(stat -c '%u' -- "$snapshot_bootstrap_started_output") == "$(id -u)" &&
	$(stat -c '%a' -- "$snapshot_bootstrap_started_output") == 600 &&
	$(stat -c '%h' -- "$snapshot_bootstrap_started_output") == 1 ]] ||
		die "snapshot token-export started receipt has unsafe ownership or mode: $snapshot_bootstrap_started_output"
	jq -e \
		--arg session "$snapshot_session_id" \
		--arg branch "$snapshot_branch" \
		--arg token_file "$snapshot_bootstrap_token_file" \
		--argjson minimum "$SNAPSHOT_STAGE_MINIMUM_TOKENS" '
			type == "object"
			and keys == ["branch", "capture_mode", "prefix_token_ids_sha256", "prompt_tokens", "schema", "session_id", "token_file", "token_file_sha256"]
			and .schema == "urn:qwen-r9700:pi-fixed-slot-token-export-started:v1"
			and .session_id == $session
			and .branch == $branch
			and .capture_mode == "capture_checkpoint"
			and .token_file == $token_file
			and (.prompt_tokens | type == "number" and . >= $minimum and . <= 253792)
			and (.prefix_token_ids_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			and (.token_file_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
		' "$snapshot_bootstrap_started_output" >/dev/null ||
		die "snapshot token-export started receipt is invalid: $snapshot_bootstrap_started_output"
	[[ -f $snapshot_bootstrap_output && ! -L $snapshot_bootstrap_output ]] ||
		die "snapshot token export did not publish its completion receipt: $snapshot_bootstrap_output"
	[[ $(stat -c '%u' -- "$snapshot_bootstrap_output") == "$(id -u)" &&
	$(stat -c '%a' -- "$snapshot_bootstrap_output") == 600 &&
	$(stat -c '%h' -- "$snapshot_bootstrap_output") == 1 ]] ||
		die "snapshot token-export receipt has unsafe ownership or mode: $snapshot_bootstrap_output"
	jq -e \
		--arg session "$snapshot_session_id" \
		--arg branch "$snapshot_branch" \
		--arg model "$SERVED_MODEL" \
		--arg token_file "$snapshot_bootstrap_token_file" \
		--argjson minimum "$SNAPSHOT_STAGE_MINIMUM_TOKENS" '
			type == "object"
			and keys == ["branch", "capture_mode", "model", "prefix_token_ids_sha256", "prompt_tokens", "schema", "session_id", "token_file", "token_file_sha256"]
			and .schema == "urn:qwen-r9700:pi-fixed-slot-token-export:v1"
			and .session_id == $session
			and .branch == $branch
			and .capture_mode == "capture_checkpoint"
			and .model == $model
			and .token_file == $token_file
			and (.prompt_tokens | type == "number" and . >= $minimum and . <= 253792)
			and (.prefix_token_ids_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			and (.token_file_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
		' "$snapshot_bootstrap_output" >/dev/null ||
		die "snapshot token-export receipt is invalid: $snapshot_bootstrap_output"
	[[ -f $snapshot_bootstrap_token_file && ! -L $snapshot_bootstrap_token_file ]] ||
		die "snapshot token vector is missing or unsafe: $snapshot_bootstrap_token_file"
	[[ $(stat -c '%u:%a:%h' -- "$snapshot_bootstrap_token_file") == "$(id -u):600:1" ]] ||
		die "snapshot token vector has unsafe ownership or mode: $snapshot_bootstrap_token_file"
	started_prefix=$(jq -er '.prefix_token_ids_sha256' "$snapshot_bootstrap_started_output")
	started_tokens=$(jq -er '.prompt_tokens' "$snapshot_bootstrap_started_output")
	started_file_sha256=$(jq -er '.token_file_sha256' "$snapshot_bootstrap_started_output")
	receipt_prefix=$(jq -er '.prefix_token_ids_sha256' "$snapshot_bootstrap_output")
	receipt_tokens=$(jq -er '.prompt_tokens' "$snapshot_bootstrap_output")
	receipt_file_sha256=$(jq -er '.token_file_sha256' "$snapshot_bootstrap_output")
	observed_file_sha256=$(sha256sum -- "$snapshot_bootstrap_token_file" | awk '{print $1}')
	[[ $started_prefix == "$receipt_prefix" && $started_tokens == "$receipt_tokens" &&
		$started_file_sha256 == "$receipt_file_sha256" &&
		$observed_file_sha256 == "$receipt_file_sha256" ]] ||
		die 'snapshot token export, receipts, and durable token vector differ'

	declare -a snapshot_plan_arguments=(
		--plan "$snapshot_stage_plan"
		--token-file "$snapshot_bootstrap_token_file"
		--session-id "$snapshot_session_id"
		--branch "$snapshot_branch"
		--model "$SERVED_MODEL"
		--minimum-stage-tokens "$SNAPSHOT_STAGE_MINIMUM_TOKENS"
		--stage-increment-tokens "$SNAPSHOT_STAGE_INCREMENT_TOKENS"
		--verify-evidence-sha256 "$snapshot_verifier_source_sha256"
	)
	snapshot_plan_document=$("$snapshot_stage_controller" "${snapshot_plan_arguments[@]}" --prepare-only) ||
		die 'snapshot staged plan could not be created or authenticated'
	jq -e \
		--arg session "$snapshot_session_id" \
		--arg branch "$snapshot_branch" \
		--arg prefix "$receipt_prefix" \
		--arg model "$SERVED_MODEL" \
		--arg file_sha "$receipt_file_sha256" \
		--arg evidence "$snapshot_verifier_source_sha256" \
		--argjson tokens "$receipt_tokens" \
		--argjson minimum "$SNAPSHOT_STAGE_MINIMUM_TOKENS" \
		--argjson increment "$SNAPSHOT_STAGE_INCREMENT_TOKENS" '
			type == "object"
			and .schema == "urn:qwen-r9700:staged-snapshot-plan:v1"
			and .session_id == $session
			and .branch == $branch
			and .model == $model
			and .prompt_token_ids_sha256 == $prefix
			and .prompt_tokens == $tokens
			and .token_file_sha256 == $file_sha
			and .verifier_evidence_sha256 == $evidence
			and .minimum_stage_tokens == $minimum
			and .stage_increment_tokens == $increment
			and (.plan_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
			and (.stages | type == "array" and length >= 1)
			and .stages[0].prompt_tokens == $minimum
			and .stages[-1].prompt_tokens == $tokens
		' <<<"$snapshot_plan_document" >/dev/null ||
		die 'authenticated staged plan differs from the token-export receipt or geometry contract'
	printf 'authenticated token export and restartable staged plan for %s tokens; advancing verified checkpoints\n' \
		"$receipt_tokens" >&2

	snapshot_plan_sha256=$(jq -er '.plan_sha256' <<<"$snapshot_plan_document")
	snapshot_stage_journal="$snapshot_stage_journal_root/$snapshot_plan_sha256"
	snapshot_unresolved_started=$(
		PYTHONDONTWRITEBYTECODE=1 python3 - \
			"$snapshot_stage_journal" <<'PY'
from __future__ import annotations

import os
import re
import stat
import sys
from pathlib import Path

transaction = Path(sys.argv[1])
if not transaction.exists() and not transaction.is_symlink():
    print(0)
    raise SystemExit(0)
descriptor = os.open(
    transaction,
    os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(descriptor)
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise SystemExit("staged journal transaction has unsafe ownership or mode")
finally:
    os.close(descriptor)

unresolved = 0
for started in transaction.glob("stage-*.started.json"):
    match = re.fullmatch(r"stage-([0-9]{4})\.started\.json", started.name)
    if match is None:
        raise SystemExit(f"unexpected staged journal filename: {started}")
    info = started.lstat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_nlink != 1
        or stat.S_IMODE(info.st_mode) != 0o400
    ):
        raise SystemExit(f"unsafe staged started receipt: {started}")
    committed = transaction / f"stage-{match.group(1)}.committed.json"
    if not committed.exists() and not committed.is_symlink():
        unresolved += 1
        continue
    committed_info = committed.lstat()
    if (
        not stat.S_ISREG(committed_info.st_mode)
        or committed_info.st_uid != os.getuid()
        or committed_info.st_nlink != 1
        or stat.S_IMODE(committed_info.st_mode) != 0o400
    ):
        raise SystemExit(f"unsafe staged committed receipt: {committed}")
print(unresolved)
PY
	) || die 'cannot authenticate the local staged journal before controller execution'
	[[ $snapshot_unresolved_started =~ ^[0-9]+$ ]] ||
		die 'staged journal returned an invalid unresolved-stage count'
	((10#$snapshot_unresolved_started <= 1)) ||
		die 'staged journal has more than one unresolved request; refusing ambiguous repost authorization'
	declare -a snapshot_execution_arguments=(
		--base-url "http://127.0.0.1:$local_port"
		--snapshot-root "$snapshot_auth_root"
		--verify-program "$snapshot_remote_verifier"
		--journal-root "$snapshot_stage_journal_root"
	)
	if ((10#$snapshot_unresolved_started > 0)); then
		((snapshot_fresh_backend_authenticated == 1 && reuse_existing == 0)) ||
			die 'unresolved stage cannot be reposted without a newly authenticated owned backend'
		snapshot_execution_arguments+=(--authorize-repost-unresolved)
		printf 'authorized one-shot recovery of %s unresolved stage only after proving the prior runtime absent and the new backend owned\n' \
			"$snapshot_unresolved_started" >&2
	fi
	assert_live62_v14_bootstrap "$backend_log"
	snapshot_stage_execution_started=1
	set +e
	snapshot_head=$("$snapshot_stage_controller" "${snapshot_plan_arguments[@]}" \
		"${snapshot_execution_arguments[@]}")
	snapshot_controller_status=$?
	set -e
	if ((snapshot_controller_status == 75)); then
		printf 'pi-remote-qwen: staged snapshot is safe but the current commit is not ready; rerun the identical command\n' >&2
		printf 'pi-remote-qwen: committed progress: %s\n' "$snapshot_stage_journal_root" >&2
		exit 75
	fi
	((snapshot_controller_status == 0)) ||
		die "snapshot staged controller failed safely with status $snapshot_controller_status"
	jq -e \
		--arg session "$snapshot_session_id" \
		--arg branch "$snapshot_branch" \
		--arg prefix "$receipt_prefix" \
		--argjson tokens "$receipt_tokens" '
			.schema == "urn:qwen-r9700:authenticated-snapshot-head:v1"
			and .session_id == $session
			and .branch == $branch
			and .prefix_token_ids_sha256 == $prefix
			and .prompt_tokens == $tokens
			and .store_drained == true
			and (.manifest_sha256 | test("^[0-9a-f]{64}$"))
			and (.generation | type == "number" and . >= 1)
		' <<<"$snapshot_head" >/dev/null ||
		die 'staged controller returned a head that differs from the complete token vector'
	snapshot_authenticated_head="$snapshot_stage_journal/authenticated-head.json"
	publish_or_validate_authenticated_snapshot_head \
		"$snapshot_stage_controller" "$snapshot_authenticated_head" <<<"$snapshot_head" ||
		die 'cannot seal the deep-authenticated snapshot head for atomic activation'
	printf 'snapshot bootstrap durably committed and independently authenticated all %s tokens: %s\n' \
		"$receipt_tokens" "$snapshot_stage_plan" >&2
	printf 'snapshot activation evidence: %s\n' "$snapshot_authenticated_head" >&2
	if [[ $snapshot_prompt_abi == "$OUTCOME_PROMPT_ABI" ]]; then
		[[ -f $snapshot_outcome_provider_payload && ! -L $snapshot_outcome_provider_payload &&
			$(stat -c '%u:%a:%h' -- "$snapshot_outcome_provider_payload") == "$(id -u):600:1" ]] ||
			die 'structured-outcome provider payload was not durably captured with a protected identity'
		printf 'qualifying required structured outcomes against the exact authenticated prompt\n' >&2
		outcome_probe_result=$(
			"$structured_outcome_probe" \
				--payload "$snapshot_outcome_provider_payload" \
				--head "$snapshot_authenticated_head" \
				--output "$snapshot_outcome_probe_root" \
				--base-url "http://127.0.0.1:$local_port" \
				--timeout-seconds 900
		) || die 'structured-outcome protocol failed its live endpoint qualification'
		jq -e \
			--arg payload "$(sha256sum -- "$snapshot_outcome_provider_payload" | awk '{print $1}')" \
			--arg head "$(sha256sum -- "$snapshot_authenticated_head" | awk '{print $1}')" \
			--arg prompt_digest "$(jq -r '.prefix_token_ids_sha256' "$snapshot_authenticated_head")" \
			--argjson prompt_tokens "$(jq -r '.prompt_tokens' "$snapshot_authenticated_head")" '
					.schema == "urn:qwen-r9700:structured-outcome-probe:v2"
					and .status == "passed"
					and .tool_choice == "required"
					and .finish_reason == "tool_calls"
					and .provider_payload_sha256 == $payload
					and .authenticated_head_sha256 == $head
					and .prompt_tokens == $prompt_tokens
					and .prompt_token_ids_sha256 == $prompt_digest
					and (.response_sha256 | test("^[0-9a-f]{64}$"))
					and .response_shape.response_sha256 == .response_sha256
					and .response_shape.finish_reason == "tool_calls"
					and .response_shape.choice_count == 1
					and .response_shape.content == .output_shape.discarded_visible_content
					and .response_shape.reasoning == .output_shape.reasoning
					and (.call_count | type == "number" and . >= 1)
					and (.calls | type == "array")
					and (.calls | length) == .call_count
					and (.response_shape.tool_calls | type == "array")
					and (.response_shape.tool_calls | length) == .call_count
					and ([.calls[].name] == [.response_shape.tool_calls[].name])
					and all(.calls[];
						(.name | type == "string" and length > 0)
						and (.arguments_sha256 | test("^[0-9a-f]{64}$"))
						and (.call_id_sha256 | test("^[0-9a-f]{64}$")))
				' <<<"$outcome_probe_result" >/dev/null ||
			die 'structured-outcome endpoint qualification receipt is invalid'
		assert_live62_v14_bootstrap "$backend_log"
		printf 'structured-outcome live endpoint qualification passed\n' >&2
	fi
	snapshot_capture_authenticated=1
	if ((live62_requested == 1)); then
		snapshot_success_backend_preserve=1
	fi
	pi_status=0
fi
exit "$pi_status"
