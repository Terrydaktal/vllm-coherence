#!/usr/bin/env bash

# Bash parses a script incrementally. Updating this launcher while an older
# invocation is still supervising Pi can otherwise make that process consume a
# mixture of the old and new file at shutdown. Read a stable copy once into a
# sealed anonymous memfd and execute from that before doing any work. This
# leaves stdin attached to the user's terminal and creates no launcher copies
# that need garbage collection.
launcher_original_script=${QWEN_PI_REMOTE_ORIGINAL_SCRIPT:-}
if [[ ${QWEN_PI_REMOTE_SOURCE_SEALED:-0} != 1 ]]; then
	launcher_source=$(readlink -e -- "${BASH_SOURCE[0]}") || {
		printf 'pi-remote-qwen: cannot resolve its launcher source\n' >&2
		exit 2
	}
	exec /usr/bin/python3 -c '
import fcntl
import os
import sys

source_path = sys.argv[1]
source_fd = os.open(source_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
before = os.fstat(source_fd)
chunks = []
while True:
    chunk = os.read(source_fd, 1024 * 1024)
    if not chunk:
        break
    chunks.append(chunk)
after = os.fstat(source_fd)
os.close(source_fd)
identity = lambda value: (
    value.st_dev,
    value.st_ino,
    value.st_size,
    value.st_mtime_ns,
    value.st_ctime_ns,
)
source = b"".join(chunks)
if identity(before) != identity(after) or len(source) != before.st_size:
    raise SystemExit(
        "pi-remote-qwen: launcher changed while it was being sealed; rerun the command"
    )
sealed_fd = os.memfd_create("pi-remote-qwen", os.MFD_ALLOW_SEALING)
offset = 0
while offset < len(source):
    offset += os.write(sealed_fd, source[offset:])
os.lseek(sealed_fd, 0, os.SEEK_SET)
fcntl.fcntl(
    sealed_fd,
    fcntl.F_ADD_SEALS,
    fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE,
)
os.set_inheritable(sealed_fd, True)
environment = os.environ.copy()
environment["QWEN_PI_REMOTE_SOURCE_SEALED"] = "1"
environment["QWEN_PI_REMOTE_ORIGINAL_SCRIPT"] = source_path
os.execve(
    "/usr/bin/bash",
    ["/usr/bin/bash", f"/proc/self/fd/{sealed_fd}", *sys.argv[2:]],
    environment,
)
' "$launcher_source" "$@"
fi
unset QWEN_PI_REMOTE_SOURCE_SEALED QWEN_PI_REMOTE_ORIGINAL_SCRIPT

set -euo pipefail
declare -ar original_launcher_arguments=("$@")

readonly PI_VERSION='0.84.2'
readonly PI_MODEL='qwen-r9700/qwen3.8-27b-frozenlock'
