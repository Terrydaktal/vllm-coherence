[[ $(awk '{print $4}' "/proc/$server_pid/stat") == "$supervisor_pid" ]]
supervisor_sid=$(ps -o sid= -p "$supervisor_pid" | tr -d ' ')
server_sid=$(ps -o sid= -p "$server_pid" | tr -d ' ')
[[ $supervisor_sid =~ ^[1-9][0-9]*$ && $server_sid == "$supervisor_sid" ]]
