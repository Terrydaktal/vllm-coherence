readonly LIVE62_V14_SITE_BYTES='7958'
readonly LIVE62_V14_MANIFEST_SHA256='71cb1865e35973b1d60fc7c8035aaf6931a33aaca402a5e760e3e0047c82b13f'
readonly LIVE62_V14_MANIFEST_BYTES='6531'
readonly LIVE62_V14_RENDERER_SHA256='fb7d52ca3ef9556a4fa58c366f2c00b9e7b6368369f1505bfa4105bae72d9a85'
readonly LIVE62_V14_RENDERER_BYTES='12883'
readonly LIVE62_V10_ROOT_RELATIVE='artifacts/qualifications/20260901T-live62-snapshot-compatible-v10-create-only'
readonly LIVE62_V10_COMMAND_SHA256='b3fb45eb7a68eef92c04867d69d8764c1439335bbe3356c7a4c18323f129d18a'
