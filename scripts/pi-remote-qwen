			die 'reused backend is not the named coding-turbo-quest96 profile'
		grep -qx 'QWEN_CODING_TURBO_HOLDBACK_TOKENS=64' <<<"$api_env" ||
			die 'reused coding-turbo backend does not have the 64-token server holdback'
		grep -qx 'QWEN_LM_HEAD_SERIAL_M8=1' <<<"$api_env" ||
			die 'reused coding-turbo backend does not have serial-equivalent M8 logits'
		grep -qx 'QWEN_QUEST_PAGE_BUDGET=96' <<<"$api_env" ||
			die 'reused coding-turbo backend is not Quest96'
		grep -qx 'QWEN_QUEST_M8_DUALPHASE=1' <<<"$api_env" ||
			die 'reused coding-turbo backend lacks the M8 dual-phase path'
		grep -qx 'QWEN_QUEST_M8_ROW_LOCAL=1' <<<"$api_env" ||
			die 'reused coding-turbo backend lacks row-local Quest semantics'
		grep -qx 'QWEN_GDN_RECOVERSSM_TRUSTED_REPLAY=1' <<<"$api_env" ||
			die 'reused coding-turbo backend lacks trusted accepted-prefix GDN replay'
		grep -qx 'QWEN_RDNA_ENABLE_EXPERIMENTAL_SPLIT_K=1' <<<"$api_env" ||
			die 'reused coding-turbo backend lacks split-K'
		grep -qx 'QWEN_RDNA_W4A16_COMMON_SPLIT_K=1' <<<"$api_env" ||
			die 'reused coding-turbo backend lacks common M1/M8 W4 arithmetic'
		grep -qx 'QWEN_RDNA_W4A16_ACTIVATION_PRECAST=1' <<<"$api_env" ||
			die 'reused coding-turbo backend lacks activation precast'
	fi
fi
REMOTE_PREFLIGHT

if ((reuse_existing == 1)); then
	remote_backend_log=$(
		ssh -T -o ConnectTimeout=10 -o ServerAliveInterval=30 \
			"$remote_host" /bin/bash -s <<'REMOTE_BACKEND_LOG'
set -euo pipefail
api_pid=$(ps -eo pid=,args= | awk '/[v]llm serve/ && /Qwen3\.8-27B-int4-AutoRound/ && /--port 8000/ {print $1; exit}')
[[ $api_pid =~ ^[1-9][0-9]*$ ]] || exit 0
target=$(readlink -e -- "/proc/$api_pid/fd/2" 2>/dev/null || true)
[[ $target == /home/lewis/* && -f $target && ! -L $target ]] || exit 0
[[ $(stat -c %u -- "$target") == "$UID" ]] || exit 0
printf '%s\n' "$target"
REMOTE_BACKEND_LOG
	)
