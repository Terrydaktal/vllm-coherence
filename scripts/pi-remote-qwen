			! grep -qx 'QWEN_FIXED_SLOT_RESUME_MISMATCH_FALLBACK=1' <<<"$api_env" ||
				die 'reused live47 backend permits snapshot mismatch cold-fill; restart it without --reuse-existing'
				grep -qx 'QWEN_FIXED_SLOT_ROLLING_CHECKPOINT=1' <<<"$api_env" ||
					die 'reused live47 backend has the wrong rolling-checkpoint publication mode'
