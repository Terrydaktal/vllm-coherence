#!/usr/bin/env python3
"""Authenticate Pi's tool parsing, stream errors and uncapped Radiance output."""

from __future__ import annotations

import argparse
import hashlib
import os
import stat
import tempfile
from collections import defaultdict
from contextlib import suppress
from dataclasses import dataclass
from pathlib import Path


class PatchError(RuntimeError):
    """The runtime is absent, unsafe, or does not match the pinned patch ABI."""


@dataclass(frozen=True)
class FilePatch:
    relative_path: str
    preimage_sha256: str
    old: bytes
    new: bytes


PATCHES = (
    FilePatch(
        relative_path="node_modules/@earendil-works/pi-ai/dist/api/openai-completions.js",
        # This is the authenticated Pi 0.84.2 file after patch-pi-streaming-usage.
        preimage_sha256="00de85392e4739502aa697f05e2a79149e685eeeaee78bf47cf3852d44afd372",
        old=b"""                    else {
                        block.arguments = parseStreamingJson(block.partialArgs);
                    }
""",
        new=b"""                    else {
                        let completeArguments;
                        try {
                            completeArguments = JSON.parse(block.partialArgs);
                        }
                        catch {
                            throw new Error(
                                "Provider tool-call integrity server error: the stream ended " +
                                    "before a complete JSON argument object was emitted",
                            );
                        }
                        if (
                            completeArguments === null ||
                            typeof completeArguments !== "object" ||
                            Array.isArray(completeArguments)
                        ) {
                            throw new Error(
                                "Provider tool-call integrity server error: final tool arguments " +
                                    "were not a JSON object",
                            );
                        }
