#!/usr/bin/env python3
# ruff: noqa: E501
"""Apply and authenticate Pi's project-local session-history patch."""

from __future__ import annotations

import argparse
import hashlib
import os
import stat
import tempfile
from contextlib import suppress
from dataclasses import dataclass
from pathlib import Path


class PatchError(RuntimeError):
    """The runtime is absent, unsafe, or does not match the pinned patch ABI."""


@dataclass(frozen=True)
class FilePatch:
    relative_path: str
    preimage_sha256: str
    old: bytes
    new: bytes


PATCHES = (
    FilePatch(
        relative_path=("node_modules/@earendil-works/pi-coding-agent/dist/core/session-manager.js"),
        preimage_sha256="af809d47818a3bf6a10173c167905e013ad7303261919a5a35a8466b801daf2e",
        old=b"""/**
 * Compute the default session directory for a cwd.
 * Encodes cwd into a safe directory name under ~/.pi/agent/sessions/.
 */
function getDefaultSessionDirPath(cwd, agentDir = getDefaultAgentDir()) {
    const resolvedCwd = resolvePath(cwd);
    const resolvedAgentDir = resolvePath(agentDir);
    const safePath = `--${resolvedCwd.replace(/^[/\\\\]/, "").replace(/[/\\\\:]/g, "-")}--`;
    return join(resolvedAgentDir, "sessions", safePath);
}
export function getDefaultSessionDir(cwd, agentDir = getDefaultAgentDir()) {
    const sessionDir = getDefaultSessionDirPath(cwd, agentDir);
    if (!existsSync(sessionDir)) {
        mkdirSync(sessionDir, { recursive: true });
    }
    return sessionDir;
}
""",
        new=b"""/**
 * Compute the default session directory for a cwd.
 * Sessions live with the project so every Pi model shares the same history.
 */
function getDefaultSessionDirPath(cwd, agentDir = getDefaultAgentDir()) {
    // Keep the public agentDir argument compatible while making history model-neutral.
    void agentDir;
    return join(resolvePath(cwd), ".pi", "sessions");
}
export function getDefaultSessionDir(cwd, agentDir = getDefaultAgentDir()) {
    const sessionDir = getDefaultSessionDirPath(cwd, agentDir);
    if (!existsSync(sessionDir)) {
        mkdirSync(sessionDir, { recursive: true, mode: 0o700 });
    }
    return sessionDir;
}
""",
    ),
    FilePatch(
        relative_path="node_modules/@earendil-works/pi-coding-agent/dist/main.js",
        preimage_sha256="5b340ce4b2030da40421d8a7940337f0568a927b0c2c981156733b4e067b9486",
        old=b"""    // Try to match as session ID in current project first
    const localSessions = await SessionManager.list(cwd, sessionDir);
    const localMatch = localSessions.find((s) => s.id === sessionArg) ?? localSessions.find((s) => s.id.startsWith(sessionArg));
""",
        new=b"""    // Try to match as session ID in current project first
    const localSessions = await SessionManager.list(cwd, sessionDir);
    if (sessionArg === "last") {
        const latest = localSessions[0];
        return latest ? { type: "local", path: latest.path } : { type: "not_found", arg: sessionArg };
    }
    const localMatch = localSessions.find((s) => s.id === sessionArg) ?? localSessions.find((s) => s.id.startsWith(sessionArg));
""",
    ),
    FilePatch(
        relative_path="node_modules/@earendil-works/pi-coding-agent/dist/cli/args.js",
        preimage_sha256="13ee8bfc62e177bce016f58ea563ecc275b715ed38015755d5fb0c0814dfb1fa",
        old=b"""  --session <path|id>            Use specific session file or partial UUID
""",
        new=b"""  --session <path|id|last>       Use a session, partial UUID, or newest project session
""",
    ),
)


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def stable_read(path: Path) -> tuple[bytes, os.stat_result]:
    try:
        before = path.lstat()
    except OSError as exc:
        raise PatchError(f"cannot inspect {path}: {exc}") from exc
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
        raise PatchError(f"not a single-link regular file: {path}")
    if before.st_uid != os.getuid() or before.st_mode & 0o022:
        raise PatchError(f"unsafe ownership or mode: {path}")
    try:
        data = path.read_bytes()
        after = path.lstat()
    except OSError as exc:
        raise PatchError(f"cannot read {path}: {exc}") from exc
    identity = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
    if identity != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
        raise PatchError(f"file changed while it was read: {path}")
    return data, before


def classify(data: bytes, patch: FilePatch) -> str:
    old_count = data.count(patch.old)
    new_count = data.count(patch.new)
    if old_count == 1 and new_count == 0 and sha256(data) == patch.preimage_sha256:
        return "unpatched"
    if new_count == 1:
        candidate = data.replace(patch.new, patch.old)
        if sha256(candidate) == patch.preimage_sha256:
            return "patched"
    raise PatchError(f"file differs from both pinned patch states: {patch.relative_path}")


def atomic_write(path: Path, data: bytes, source: os.stat_result) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, stat.S_IMODE(source.st_mode))
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        with suppress(FileNotFoundError):
            temporary.unlink()


def validate_root(root: Path) -> None:
    if not root.is_absolute():
        raise PatchError("runtime root must be absolute")
    try:
        details = root.lstat()
    except OSError as exc:
        raise PatchError(f"cannot inspect runtime root {root}: {exc}") from exc
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid():
        raise PatchError(f"runtime root is not an owned real directory: {root}")


def run(root: Path, *, apply: bool) -> None:
    validate_root(root)
    for patch in PATCHES:
        path = root / patch.relative_path
        data, details = stable_read(path)
        state = classify(data, patch)
        if state == "unpatched":
            if not apply:
                raise PatchError(f"project-history patch is absent: {path}")
            updated = data.replace(patch.old, patch.new)
            atomic_write(path, updated, details)
            data, _ = stable_read(path)
            if classify(data, patch) != "patched":
                raise PatchError(f"failed to authenticate patched file: {path}")


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--apply", action="store_true")
    action.add_argument("--check", action="store_true")
    parser.add_argument("runtime", type=Path)
    arguments = parser.parse_args()
    try:
        run(arguments.runtime, apply=arguments.apply)
    except PatchError as exc:
        parser.exit(2, f"patch-pi-project-history: {exc}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
