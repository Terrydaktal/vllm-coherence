PATCHES += STREAM_COMPACTION_PATCHES


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def stable_read(path: Path) -> tuple[bytes, os.stat_result]:
    try:
        before = path.lstat()
    except OSError as exc:
        raise PatchError(f"cannot inspect {path}: {exc}") from exc
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
        raise PatchError(f"not a single-link regular file: {path}")
    if before.st_uid != os.getuid() or before.st_mode & 0o022:
        raise PatchError(f"unsafe ownership or mode: {path}")
    try:
        data = path.read_bytes()
        after = path.lstat()
    except OSError as exc:
        raise PatchError(f"cannot read {path}: {exc}") from exc
    identity = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
    if identity != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
        raise PatchError(f"file changed while it was read: {path}")
    return data, before


def classify(data: bytes, patches: FilePatch | tuple[FilePatch, ...]) -> str:
    if isinstance(patches, FilePatch):
        patches = (patches,)
    preimages = {
        frozenset((patch.preimage_sha256, *patch.alternate_preimage_sha256))
        for patch in patches
    }
    relative_paths = {patch.relative_path for patch in patches}
    if len(preimages) != 1 or len(relative_paths) != 1:
        raise PatchError("grouped patches disagree about their file or preimage")
    candidate = data
    applied = 0
    legacy_applied = 0
    for patch in patches:
        old_count = candidate.count(patch.old)
        new_count = candidate.count(patch.new)
        if old_count == 1 and new_count == 0:
            continue
        # A replacement can retain its original statement as a suffix. Reverse
        # the entire unique replacement first; the complete preimage digest
        # below still rejects an extra original statement or any other change.
        if new_count == 1:
            candidate = candidate.replace(patch.new, patch.old)
            applied += 1
            continue
        matching_legacy = [legacy for legacy in patch.legacy if candidate.count(legacy) == 1]
        if new_count == 0 and len(matching_legacy) == 1:
            candidate = candidate.replace(matching_legacy[0], patch.old)
            legacy_applied += 1
            continue
        raise PatchError(f"file differs from both pinned patch states: {patch.relative_path}")
    if sha256(candidate) not in next(iter(preimages)):
        raise PatchError(f"file differs from both pinned patch states: {patches[0].relative_path}")
    if applied == 0 and legacy_applied == 0:
        return "unpatched"
    if applied == len(patches) and legacy_applied == 0:
        return "patched"
    return "partial"


def atomic_write(path: Path, data: bytes, source: os.stat_result) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, stat.S_IMODE(source.st_mode))
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        with suppress(FileNotFoundError):
            temporary.unlink()


def validate_root(root: Path) -> None:
    if not root.is_absolute():
        raise PatchError("runtime root must be absolute")
    try:
        details = root.lstat()
    except OSError as exc:
        raise PatchError(f"cannot inspect runtime root {root}: {exc}") from exc
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid():
        raise PatchError(f"runtime root is not an owned real directory: {root}")


def run(root: Path, *, apply: bool) -> None:
    validate_root(root)
    grouped: dict[str, list[FilePatch]] = {}
    for patch in PATCHES:
        grouped.setdefault(patch.relative_path, []).append(patch)
    for relative_path, file_patches in grouped.items():
        patches = tuple(file_patches)
        path = root / relative_path
        data, details = stable_read(path)
        state = classify(data, patches)
        if state != "patched":
            if not apply:
                raise PatchError(f"pre-continuation compaction patch is absent: {path}")
            updated = data
            for patch in patches:
                if patch.old in updated and patch.new not in updated:
                    updated = updated.replace(patch.old, patch.new)
                    continue
                for legacy in patch.legacy:
                    if legacy in updated and patch.new not in updated:
                        updated = updated.replace(legacy, patch.new)
                        break
            atomic_write(path, updated, details)
            data, _ = stable_read(path)
            if classify(data, patches) != "patched":
                raise PatchError(f"failed to authenticate patched file: {path}")


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--apply", action="store_true")
    action.add_argument("--check", action="store_true")
    parser.add_argument("runtime", type=Path)
    arguments = parser.parse_args()
    try:
        run(arguments.runtime, apply=arguments.apply)
    except PatchError as exc:
        parser.exit(2, f"patch-pi-precontinuation-compaction: {exc}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
