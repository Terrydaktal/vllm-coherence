    // =========================================================================
    protectCompactionDraft() {
        this.releaseCompactionDraftGuard?.();
        const editor = this.editor;
        if (!editor?.getText() || !this.ui.addInputListener) {
            return;
        }
        // Keep the current editor itself, including its cursor, undo history and
        // paste buffers. Completion redraws and deferred cleanup may not clear
        // unsent input, including when typing continues after compaction. Clears
        // during keyboard handling remain intentional; async completion callbacks
        // run after that scope closes. Emptying the draft releases protection.
        // Nothing is copied to session history, diagnostics or the filesystem.
        const ownSetText = Object.getOwnPropertyDescriptor(editor, "setText");
        const setText = editor.setText;
        let handlingInput = false;
        let active = true;
        const guardedSetText = function (text) {
            if (text === "" && this.getText() !== "" && !handlingInput) {
                return;
            }
            return setText.call(this, text);
        };
        editor.setText = guardedSetText;
        let unsubscribe;
        const release = () => {
            if (!active) return;
            active = false;
            unsubscribe?.();
            if (editor.setText === guardedSetText) {
                if (ownSetText) Object.defineProperty(editor, "setText", ownSetText);
                else delete editor.setText;
            }
            if (this.releaseCompactionDraftGuard === release) {
                this.releaseCompactionDraftGuard = undefined;
            }
        };
        this.releaseCompactionDraftGuard = release;
        unsubscribe = this.ui.addInputListener(() => {
            handlingInput = true;
            queueMicrotask(() => {
                handlingInput = false;
                if (active && editor.getText() === "") release();
            });
        });
    }
    clearEditor() {
        this.editor.setText("");
        this.ui.requestRender();
    }
""",
