#!/usr/bin/env python3
"""Apply and authenticate Pi's compaction, editor, spinner and context-safety patches."""

from __future__ import annotations

import argparse
import hashlib
import os
import stat
import tempfile
from contextlib import suppress
from dataclasses import dataclass
from pathlib import Path


class PatchError(RuntimeError):
    """The runtime is absent, unsafe, or does not match the pinned patch ABI."""


@dataclass(frozen=True)
class FilePatch:
    relative_path: str
    preimage_sha256: str
    old: bytes
    new: bytes
    legacy: tuple[bytes, ...] = ()
    alternate_preimage_sha256: tuple[str, ...] = ()


