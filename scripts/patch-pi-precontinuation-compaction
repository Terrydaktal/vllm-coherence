                const measuredTokens = turn.message.usage
                    ? calculateContextTokens(turn.message.usage)
                    : 0;
                const projectedTokens = measuredTokens > 0
                    ? measuredTokens + estimateMessagesTokens(turn.toolResults)
                    : estimateMessagesTokens(turn.context.messages);
                if (settings.enabled && shouldCompact(projectedTokens, contextWindow, settings)) {
                    const beforeCompactionId = getLatestCompactionEntry(this.sessionManager.getBranch())?.id;
                    await this._runAutoCompaction("threshold", false);
                    const afterCompactionId = getLatestCompactionEntry(this.sessionManager.getBranch())?.id;
                    if (!afterCompactionId || afterCompactionId === beforeCompactionId) {
                        throw new Error("Automatic compaction was required before a tool continuation but did not commit");
