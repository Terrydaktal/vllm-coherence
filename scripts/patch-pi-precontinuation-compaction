    // One oversized interrupted turn remains whole in JSONL but cannot be a
    // bounded recent tail. The Radiance checkpoint explicitly records this
    // empty-tail projection; reloading follows the same committed boundary.
    if (compaction.details?.contract === "radiance-prefix-compaction-v1" &&
        compaction.details?.streamCompaction?.contract === "radiance-stream-compaction-v1" &&
        compaction.details.streamCompaction.emptyRetainedTail === true) {
        contextEntries.push(...path.slice(compactionIdx + 1));
        return contextEntries;
    }
    let foundFirstKept = false;
""",
