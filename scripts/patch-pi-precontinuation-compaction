    _canContinueStreamCompaction(attempt) {
        const model = this.model;
        return !attempt.cancelled && this.settingsManager.getCompactionSettings().enabled &&
            model?.provider === attempt.provider && model?.id === attempt.model &&
            model?.api === attempt.api && this.sessionManager.getSessionId() === attempt.sessionId;
    }
    _observeStreamCompaction(event) {
        const message = event.message;
        if (event.type === "message_start" && message?.role === "assistant") {
            this._streamCompactionStream = {
                signal: this.agent.signal, timestamp: message.timestamp,
                provider: message.provider, model: message.model, api: message.api,
                compactionId: getLatestCompactionEntry(this.sessionManager.getBranch())?.id,
                sessionId: this.sessionManager.getSessionId(), promptTokens: undefined, outputTokens: -1,
            };
            return;
        }
        const stream = this._streamCompactionStream;
        if (!stream || stream.signal !== this.agent.signal || message?.role !== "assistant" ||
            message.timestamp !== stream.timestamp || message.provider !== stream.provider ||
            message.model !== stream.model || message.api !== stream.api) return;
        if (event.type === "message_end") {
            const attempt = this._streamCompactionAttempt;
            if (attempt?.stream === stream) {
                // A natural stop that wins the final-token race has completed the
                // task. Compact it, but do not produce a second answer. A tool
                // draft that races cancellation must remain unexecuted.
                attempt.completed = message.stopReason === "stop" &&
                    !message.content.some((block) => block.type === "toolCall");
                if (!attempt.completed && message.stopReason !== "error") {
                    message.stopReason = "aborted";
                    message.errorMessage = "Interrupted for automatic context compaction.";
                }
                attempt.finalMessage = message;
            }
            this._streamCompactionStream = undefined;
            return;
        }
        if (event.type !== "message_update" || this._streamCompactionAttempt || stream.signal?.aborted) return;
        const model = this.model;
        const settings = this.settingsManager.getCompactionSettings();
        if (!settings.enabled || model?.provider !== "qwen-r9700" || model?.api !== "openai-completions" ||
            model?.id !== "qwen3.8-27b-uncensored-mxfp4-public-snapshot-candidate" ||
            model.provider !== stream.provider || model.id !== stream.model || model.api !== stream.api ||
            this.sessionManager.getSessionId() !== stream.sessionId ||
            getLatestCompactionEntry(this.sessionManager.getBranch())?.id !== stream.compactionId) return;
        const usage = message.usage;
        if (![usage?.input, usage?.output, usage?.cacheRead, usage?.cacheWrite].every(
            (value) => Number.isSafeInteger(value) && value >= 0,
        )) return;
        const promptTokens = usage.input + usage.cacheRead + usage.cacheWrite;
        const tokens = promptTokens + usage.output;
        if (promptTokens <= 0 || !Number.isSafeInteger(tokens) ||
            (usage.totalTokens !== undefined && usage.totalTokens !== 0 && usage.totalTokens !== tokens) ||
            (stream.promptTokens !== undefined && stream.promptTokens !== promptTokens) ||
            usage.output < stream.outputTokens) return;
        stream.promptTokens = promptTokens;
        stream.outputTokens = usage.output;
        const window = model.contextWindow;
        const reserve = settings.reserveTokens;
        if (!Number.isSafeInteger(window) || window <= 0 ||
            !Number.isSafeInteger(reserve) || reserve < 0 || reserve >= window) return;
        const threshold = Math.min(240000, window - reserve);
        if (tokens < threshold) return;
        this._streamCompactionAttempt = {
            stream, provider: stream.provider, model: stream.model, api: stream.api,
            sessionId: stream.sessionId, compactionId: stream.compactionId,
            tokens, threshold, cancelled: false, persistedMessage: undefined,
