    _syncStreamCompactionTranscript() {
        const sessionFile = this.sessionManager.getSessionFile();
        if (!sessionFile) throw new Error("Automatic stream compaction requires a persistent session transcript");
        const file = openSync(sessionFile, "r");
        try { fsyncSync(file); } finally { closeSync(file); }
        const directory = openSync(dirname(sessionFile), "r");
        try { fsyncSync(directory); } finally { closeSync(directory); }
    }
    _cancelStreamCompaction() {
        const attempt = this._streamCompactionAttempt;
        if (!attempt) return;
        attempt.cancelled = true;
        this._streamCompactionCancelledRun = true;
        this._streamCompactionResume = false;
        this._autoCompactionAbortController?.abort();
