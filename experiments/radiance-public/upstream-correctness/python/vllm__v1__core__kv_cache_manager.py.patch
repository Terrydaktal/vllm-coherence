+    def cache_blocks(self, request: Request, num_computed_tokens: int, *, confirmed: bool = False) -> None:
+        """Publish a computed prefix, distinguishing completed terminal writes."""
+        if not self.enable_caching:
+            return
+        if not confirmed:
             self.coordinator.cache_blocks(request, num_computed_tokens)
+            return
+        pool = self.block_pool
+        old_step = pool._publication_step
+        managers = self.coordinator.single_type_managers
+        old_steps = [(m, m._sched_step_seq) for m in managers if hasattr(m, "_sched_step_seq")]
+        pool._publication_step = pool._committed_publication_step
+        for m, _ in old_steps:
+            m._sched_step_seq = m._committed_step_seq
+        try:
+            self.coordinator.cache_blocks(request, num_computed_tokens)
+        finally:
+            pool._publication_step = old_step
+            for m, seq in old_steps:
+                m._sched_step_seq = seq
 
