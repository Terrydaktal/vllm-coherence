+def compute_num_decode_draft_tokens(
+    num_padded_reqs: int,
+    num_scheduled_tokens: np.ndarray,
+    num_draft_tokens_per_req: np.ndarray | None,
+    is_prefilling: np.ndarray,
+) -> np.ndarray:
+    """Keep previous accepted-state offsets even when this step has no drafts."""
+    num_reqs = num_scheduled_tokens.shape[0]
+    result = np.full(num_padded_reqs, -1, dtype=np.int32)
+    if num_draft_tokens_per_req is None:
+        num_draft_tokens_per_req = np.zeros(num_reqs, dtype=np.int32)
+    is_decode = (num_scheduled_tokens == num_draft_tokens_per_req + 1) & ~is_prefilling
+    result[:num_reqs] = np.where(is_decode, num_draft_tokens_per_req, -1)
+    return result
+
