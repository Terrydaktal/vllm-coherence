# Keep the build context lean — none of this belongs in the image build.
.git/
.gitignore
__pycache__/
*.pyc
*.swp
.DS_Store
# local deploy state (bind-mounted at runtime, never built in)
.env
docker-compose.dev.yml
docker-compose.override.yml
models/
vllm-cache/
benchmarks/runs/
# local R4D checkout/build output; the image fetches its own immutable pin
libr4d/
# build outputs; rocm-bandwidth-test is built in stage 1
*.so
rocm-bandwidth-test

# Coherence development environments, captured evidence and local state
.venv/
.build/
.pytest_cache/
.ruff_cache/
**/__pycache__/
**/node_modules/
private/
artifacts/
sessions/
.pi/
benchmarks/results/
reports/
test-results.xml
*.hsaco
*.pt
*.npy
*.npz
*.safetensors
*.gguf
# Keep radiance_amdsmi.pth: the base image copies this required startup hook.
